+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface);
+
+/*
+ * The memory of an IOSurface as a texture, to draw into and to draw with (iOS, S8 port): the kernel driver's selector 0x7e
+ * (s8_drm_surface, src/s8-drm) describes the surface, and importing it (panfrost_resource_from_handle -> panfrost_bo_import ->
+ * drmPrimeFDToHandle with the surface ID where Linux has a dma-buf descriptor) makes a buffer object of its memory in the
+ * GPU's address space. NULL: the screen is not the GPU's, the kernel has no such selector, or the surface is not one plane of
+ * 32-bit pixels, blue first, in a linear layout this GPU can address (offset and row bytes 64-byte aligned, as the kernel's
+ * surfaces are). Each call is a new pipe_resource over the same kernel buffer; the buffer goes when the last one does.
+ */
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface)
+{
+   struct s8_drm_surface s = {.surface = surface};
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .format = PIPE_FORMAT_B8G8R8A8_UNORM,
+      .depth0 = 1,
+      .array_size = 1,
+      .bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET,
+   };
+   struct winsys_handle handle = {.type = WINSYS_HANDLE_TYPE_FD};
+
+   if (gpu_fd < 0 || s8_drm_surface(gpu_fd, &s) != 0)
+      return NULL;
+   /* 'BGRA' (kCVPixelFormatType_32BGRA); a plane count of 1 is the same single plane of a surface made with plane info */
+   if (s.pixel_format != 0x42475241 || s.planes > 1 || s.width == 0 ||
+       s.height == 0 || (s.offset & 63) || (s.row_bytes & 63) ||
+       s.row_bytes < s.width * 4 ||
+       (uint64_t)s.offset + (uint64_t)s.row_bytes * s.height > s.size)
+      return NULL;
+   templ.width0 = s.width;
+   templ.height0 = s.height;
+   handle.handle = surface;
+   handle.stride = s.row_bytes;
+   handle.offset = s.offset;
+   handle.size = s.size;
+   handle.modifier = DRM_FORMAT_MOD_LINEAR;
+   return screen->resource_from_handle(screen, &templ, &handle, 0);
+}
+
 struct pipe_screen *
 osmesa_create_screen(void);
 
