# Meson cross file: Mesa for iOS arm64 (iPhoneOS SDK, min 16.0). @SDK@ is replaced by build-mesa.sh
# with `xcrun --sdk iphoneos --show-sdk-path`.
[binaries]
c = ['xcrun', '--sdk', 'iphoneos', 'clang']
cpp = ['xcrun', '--sdk', 'iphoneos', 'clang++']
objc = ['xcrun', '--sdk', 'iphoneos', 'clang']
objcpp = ['xcrun', '--sdk', 'iphoneos', 'clang++']
ar = ['xcrun', '--sdk', 'iphoneos', 'ar']
strip = ['xcrun', '--sdk', 'iphoneos', 'strip']
ranlib = ['xcrun', '--sdk', 'iphoneos', 'ranlib']
pkg-config = 'pkg-config'

[built-in options]
c_args = ['-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '@SDK@']
cpp_args = ['-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '@SDK@']
c_link_args = ['-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '@SDK@']
cpp_link_args = ['-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '@SDK@']
objc_args = ['-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '@SDK@']
objcpp_args = ['-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '@SDK@']
objc_link_args = ['-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '@SDK@']
objcpp_link_args = ['-arch', 'arm64', '-miphoneos-version-min=16.0', '-isysroot', '@SDK@']

[properties]
needs_exe_wrapper = true

[host_machine]
system = 'darwin'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'
