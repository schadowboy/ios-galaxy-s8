+/*
+ * s8prof counters: every UFS command goes through here, always under
+ * sweet_ufs_lock (or single threaded during init), so plain increments are
+ * enough; the s8prof thread reads them racily (aligned 64-bit loads).
+ * Latency is the command time on the controller (doorbell to completion),
+ * lock wait is accounted separately in sweet_ufs_strategy.
+ */
+struct s8prof_ufs_stats {
+	volatile uint64_t rd_bytes, wr_bytes, rd_reqs, wr_reqs, other_reqs;
+	volatile uint64_t lat_abs, lat_max_abs;        /* mach absolute time units */
+	volatile uint64_t strat_reqs, lockwait_abs;    /* strategy() calls, time waiting for sweet_ufs_lock */
+	volatile uint64_t errors;
+};
+static struct s8prof_ufs_stats s8prof_ufs;
+
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	uint64_t t0 = mach_absolute_time();
+	int error = ufs_scsi_raw(cdb, cdb_len, len, write);
+	uint64_t dt = mach_absolute_time() - t0;
+	if (len == 0) {
+		s8prof_ufs.other_reqs++;
+	} else if (write) {
+		s8prof_ufs.wr_reqs++;
+		s8prof_ufs.wr_bytes += len;
+	} else {
+		s8prof_ufs.rd_reqs++;
+		s8prof_ufs.rd_bytes += len;
+	}
+	if (error) {
+		s8prof_ufs.errors++;
+	}
+	s8prof_ufs.lat_abs += dt;
+	if (dt > s8prof_ufs.lat_max_abs) {
+		s8prof_ufs.lat_max_abs = dt;
+	}
+	return error;
+}
