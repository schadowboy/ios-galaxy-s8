+bool s8mali_lazy(void);
+bool
+s8mali_lazy(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		uint32_t v = 0;
+
+		on = PE_parse_boot_argn("s8mali_lazy", &v, sizeof(v)) && v != 0;
+		P("s8mali_lazy=%d: %s", on, on ? "IOSurface buffers swept only when their seed moved" : "every listed buffer swept around every job");
+	}
+	return on != 0;
+}
