+/*
+ * Patch 0166, boot-arg s8autohome=<seconds> (test aid): press the Home key through the HID stand-in once, that many seconds after boot, so an
+ * unattended run leaves the lock screen and shows the home screen (kernel log thumbnails, hook log). Key 3 is Home (Power, Volume Up,
+ * Volume Down, Home), as the emulator's 'h' key and the A5XELTE keys driver number them.
+ */
+extern void sweet_hid_key(int key, int down);
+
+static void
+s8_autohome_thread(void *arg, wait_result_t result)
+{
+	uint32_t secs = (uint32_t)(uintptr_t)arg;
+
+	(void)result;
+	IOSleep(secs * 1000);
+	printf("S8AUTOHOME: Home key pressed after %u s\n", secs);
+	sweet_hid_key(3, 1);
+	IOSleep(200);
+	sweet_hid_key(3, 0);
+	thread_terminate_self();
+}
