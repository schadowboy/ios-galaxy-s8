+			fBootSrc = fShownSrc = src;
+			IOLog("SWEET FB: flip: IDMA %u reads the panel buffer (src 0x%x img 0x%x), DECON shadow 0x%x\n",
+			    n, src, img, *(volatile uint32_t *)(fDecon + S8_DECON_SHADOW_REQ));
+			return true;
+		}
+	}
+	IOLog("SWEET FB: flip: no IDMA reads 0x%llx at %ux%u: flips off\n", fPhys, fWidth, fHeight);
+	return false;
+}
+
+/* The DECON has taken the last flip (its shadow request reads 0); waits up to `ms`. */
+bool
+AppleCLCD::flipLatched(unsigned ms)
+{
+	for (unsigned i = 0; i <= ms * 10; i++) {
+		if ((*(volatile uint32_t *)(fDecon + S8_DECON_SHADOW_REQ) & S8_DECON_SHADOW_ALL) == 0) {
+			return true;
+		}
+		if (i < ms * 10) {
+			IODelay(100);
+		}
+	}
+	return false;
+}
+
+static void
+s8_flip_write(vm_offset_t idma, vm_offset_t decon, uint64_t pa, uint32_t src)
+{
+	*(volatile uint32_t *)(idma + S8_IDMA_SRC_SIZE) = src;
+	*(volatile uint32_t *)(idma + S8_IDMA_BASE_Y) = (uint32_t)pa;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(decon + S8_DECON_SHADOW_REQ) |= S8_DECON_SHADOW_ALL;
+}
+
+/*
+ * Zero copy: a swap whose only layer is a whole pool surface is shown by
+ * pointing the IDMA at it. True if it was; false and nothing done otherwise.
+ */
+bool
+AppleCLCD::tryFlip(const uint8_t *rec)
+{
+	uint32_t mask = 0, layer = 0;
+	memcpy(&mask, rec + 0x104, 4);
+	mask &= (1u << SWEET_FB_LAYERS) - 1;
+	if (mask == 0 || (mask & (mask - 1)) != 0) {
+		return false;                   /* none or several layers: copy */
+	}
+	while (!(mask & (1u << layer))) {
+		layer++;
+	}
+	int32_t a[4], b[4];
+	uint32_t id;
+	memcpy(&id, rec + 0x54 + 4 * layer, 4);
+	memcpy(a, rec + 0x64 + 16 * layer, 16);
+	memcpy(b, rec + 0xc4 + 16 * layer, 16);
+	SweetSurface *s = sweet_surface_copy(id);
+	if (s == NULL) {
+		return false;
+	}
+	bool whole = s->scanoutPhys != 0 && s->width == fWidth && s->height == fHeight && s->offset == 0 &&
+	    a[0] == 0 && a[1] == 0 && b[0] - fOffX == 0 && b[1] - fOffY == 0 &&
+	    (b[2] <= 0 || (uint32_t)b[2] == fWidth) && (b[3] <= 0 || (uint32_t)b[3] == fHeight) &&
+	    s->bytesPerRow / 4 <= 0xffff;
+	if (!whole) {
+		s->release();
+		return false;
+	}
+	IOLockLock(fPresentLock);
+	/* The flip before must be taken: then fShownPrev is no longer read by the DECON. */
+	if (!flipLatched(25)) {
+		IOLog("SWEET FB: flip: DECON did not take the previous flip in 25 ms\n");
+	}
+	OSSafeReleaseNULL(fShownPrev);
+	uintptr_t kva = s->kernelAddress();
+	if (kva == 0) {
+		IOLockUnlock(fPresentLock);
+		s->release();
+		return false;
+	}
+	clean_dcache((vm_offset_t)kva, s->bytesPerRow * s->height, FALSE);
+	uint32_t src = fHeight << 16 | (s->bytesPerRow / 4);
+	s8_flip_write(fIdma, fDecon, s->scanoutPhys, src);
+	fShownSrc = src;
+	fShownPrev = fShown;
+	fShown = s;                             /* keeps the copy's retain */
+	fStatFlips++;
+	if (fFlip == 1) {
+		(void)flipLatched(25);          /* no frame drawn into fShownPrev while it is on the panel */
+	}
+	if ((++fFlips % 1000) == 1) {
+		IOLog("SWEET FB: flip %llu: surface %u at 0x%llx, %u bytes a row (copies %llu)\n",
+		    fFlips, s->id, s->scanoutPhys, s->bytesPerRow, fCopies);
+	}
+	IOLockUnlock(fPresentLock);
 	return true;
 }
 
+/* Back to the panel buffer (before copying into it, or fading it). Present lock held. */
+void
+AppleCLCD::flipHome(void)
+{
+	if (fFlip == 0 || fShown == NULL) {
+		return;
+	}
+	(void)flipLatched(25);
+	s8_flip_write(fIdma, fDecon, fPhys, fBootSrc);
+	fShownSrc = fBootSrc;
+	(void)flipLatched(25);
+	OSSafeReleaseNULL(fShownPrev);
+	OSSafeReleaseNULL(fShown);
+}
