+void
+sweet_surface_set_scanout_pool(uint64_t phys, uint32_t slots, uint64_t slotSize,
+    uint32_t width, uint32_t height)
+{
+	if (slots > SWEET_POOL_MAX_SLOTS) {
+		slots = SWEET_POOL_MAX_SLOTS;
+	}
+	sweet_pool_slot_size = slotSize;
+	sweet_pool_width = width;
+	sweet_pool_height = height;
+	sweet_pool_phys = phys;
+	OSSynchronizeIO();
+	sweet_pool_slots = slots;
+	IOLog("SWEET SURF: scan-out pool %u x %llu bytes at 0x%llx for %ux%u display surfaces\n",
+	    slots, slotSize, phys, width, height);
+}
+
+/* A free slot's physical address for a display surface of backboardd's, or 0. */
+static uint64_t
+sweet_pool_take(SweetSurface *s, const char *creator)
+{
+	uint64_t pa = 0;
+
+	if (sweet_pool_slots == 0 || strcmp(creator, "backboardd") != 0 ||
+	    s->width != sweet_pool_width || s->height != sweet_pool_height ||
+	    s->pixelFormat != 0x42475241 /* 'BGRA' */ || s->bytesPerElement != 4 ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || s->planeCount != 0 ||
+	    s->offset != 0 || (s->bytesPerRow & 63) != 0 || s->allocSize > sweet_pool_slot_size) {
+		return 0;
+	}
+	IOLockLock(sweet_surface_lock);
+	for (uint32_t k = 0; k < sweet_pool_slots; k++) {
+		if (!(sweet_pool_used & (1u << k))) {
+			sweet_pool_used |= 1u << k;
+			s->poolSlot = (int32_t)k;
+			pa = sweet_pool_phys + sweet_pool_slot_size * k;
+			break;
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	if (pa == 0 && sweet_pool_logged < 8) {
+		sweet_pool_logged++;
+		IOLog("SWEET SURF: scan-out pool full, display surface %ux%u from ordinary memory\n",
+		    s->width, s->height);
+	}
+	return pa;
+}
