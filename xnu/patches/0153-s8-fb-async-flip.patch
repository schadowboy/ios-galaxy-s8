+
+/* sweetfb_async: the latest recorded swap is copied at most every fMinGap. */
+void
+AppleCLCD::presentLoop(void)
+{
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+
+	if (rec == NULL) {
+		IOLog("SWEET FB: present thread: no memory\n");
+		return;
+	}
+	IOLockLock(fLock);
+	for (;;) {
+		while (!fDirty || fPowerOff) {
+			IOLockSleep(fLock, &fDirty, THREAD_UNINT);
+		}
+		uint64_t now = mach_absolute_time();
+		if (now - fLastPresent < fMinGap) {
+			uint64_t left = fMinGap - (now - fLastPresent);
+			IOLockUnlock(fLock);
+			IOSleep((unsigned)(left * 1000 / SWEET_FB_TIMEBASE_HZ) + 1);
+			IOLockLock(fLock);
+			continue;
+		}
+		memcpy(rec, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+		fLastPresent = now;
+		IOLockUnlock(fLock);
+		present(rec);
+		IOLockLock(fLock);
+	}
 }
 
