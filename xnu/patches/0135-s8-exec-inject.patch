--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5568,10 +5568,117 @@
  * Note:	The argument and environment vectors are user space pointers
  *		to arrays of user space pointers.
  */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+/*
+ * S8 bring-up aid (same idea as the S9+ port's kern.exec_inject, APSL): the sysctl
+ * kern.exec_inject holds "LIBRARY NAME NAME ..." and the boot-arg
+ * s8_inject=LIBRARY:NAME,NAME[;LIBRARY2:NAME,...] fills it at the first exec. Every program whose
+ * file name is one of the NAMEs is started with DYLD_INSERT_LIBRARIES=LIBRARY in its environment, so
+ * that dyld loads our library into it (the dyld policy question is answered by the "AMFI"
+ * stand-in in sweet_amfi.c). Several groups are separated by ";"; a program named in more than one
+ * group gets every one of those libraries joined with ":". launchd refuses to pass DYLD_ variables
+ * from a job description, which is why the kernel adds the variable. Boot-arg s8_inject_off=1
+ * switches the whole thing off. System binaries stay untouched, which keeps them platform binaries.
+ */
+static char exec_inject_conf[512];
+SYSCTL_STRING(_kern, OID_AUTO, exec_inject, CTLFLAG_RW | CTLFLAG_LOCKED, exec_inject_conf, sizeof(exec_inject_conf),
+    "LIBRARY NAME... [; LIBRARY NAME...]: programs started with the library inserted");
+
+static int exec_inject_state = 0;       /* 0: boot-arg not read yet, 1: read, 2: disabled */
+
+static void
+exec_inject_read_bootarg(void)
+{
+	char arg[256];
+	uint32_t off = 0;
+	size_t used = 0;
+	const char *p;
+
+	exec_inject_state = 1;
+	if (PE_parse_boot_argn("s8_inject_off", &off, sizeof(off)) && off) {
+		exec_inject_state = 2;
+		exec_inject_conf[0] = 0;
+		printf("S8INJECT: disabled by boot-arg s8_inject_off\n");
+		return;
+	}
+	if (exec_inject_conf[0] != 0 || !PE_parse_boot_argn("s8_inject", arg, sizeof(arg))) {
+		return;
+	}
+	/* LIBRARY:NAME,NAME;LIBRARY2:NAME2  ->  "LIBRARY NAME NAME;LIBRARY2 NAME2" */
+	for (p = arg; *p != 0 && used + 2 < sizeof(exec_inject_conf); p++) {
+		char c = *p;
+
+		if (c == ':' || c == ',') {
+			c = ' ';
+		}
+		exec_inject_conf[used++] = c;
+	}
+	exec_inject_conf[used] = 0;
+	printf("S8INJECT: rules \"%s\"\n", exec_inject_conf);
+}
+
+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	const char *name, *p;
+	size_t namelen, used;
+	bool any = false;
+
+	if (exec_inject_state == 0) {
+		exec_inject_read_bootarg();
+	}
+	p = exec_inject_conf;
+	if (exec_inject_state == 2 || *p == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	while (*p != 0) {
+		const char *library;
+		size_t liblen;
+		bool matched = false;
+
+		while (*p == ' ' || *p == ';') {
+			p++;
+		}
+		library = p;
+		while (*p != 0 && *p != ' ' && *p != ';') {
+			p++;
+		}
+		liblen = (size_t)(p - library);
+		while (*p == ' ') {
+			const char *word = ++p;
+
+			while (*p != 0 && *p != ' ' && *p != ';') {
+				p++;
+			}
+			if (!matched && (size_t)(p - word) == namelen && namelen != 0 && liblen != 0 &&
+			    strncmp(word, name, namelen) == 0) {
+				matched = true;         /* this group names this program; its library is added once */
+			}
+		}
+		if (matched && liblen != 0 && used + 1 + liblen < size) {
+			if (any) {
+				env[used++] = ':';      /* dyld takes several libraries separated by ":" */
+			}
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = 0;
+			any = true;
+		}
+	}
+	return any;
+}
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
+
