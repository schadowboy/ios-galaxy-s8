+/*
+ * s8prof_pc=K: every K-th interval, for each of the top-3 tasks by CPU delta,
+ * one "S8PROF pc" line per runnable/running thread (max 16, threads parked in
+ * mach_msg receive are skipped and counted in the "S8PROF slide" line):
+ *   S8PROF pc name[pid] tN st=<R|Q|W|U|S> pc=.. lr=.. cpu=<ms> mach_msg=<y|n> bt .. (<= 6 return addrs)
+ *   S8PROF slide name[pid] slide=0x.. (shared region slide) mh=0x.. skipped=N
+ * pc/lr/fp come from the saved user state of the last kernel entry (find_user_regs):
+ * for a thread running in user mode on another CPU they can be stale. Offline
+ * addresses must be unslid (addr - slide); the main binary uses mh.
+ * st: R running, Q on runq, W waiting, U uninterruptible wait, S other.
+ */
+#include <vm/vm_shared_region.h>
+#include <arm/thread.h>
+#include <kern/block_hint.h>
+#include <kern/task_ref.h>
+
+#define S8P_TPREV 96
+static struct { uint64_t tid; uint64_t total; } s8p_tprev[S8P_TPREV];
+static unsigned s8p_tprev_next;
+
+static uint64_t
+s8p_thread_cpu_delta_ms(thread_t th)
+{
+	struct recount_times_mach tm = recount_thread_times(th);
+	uint64_t total = tm.rtm_user + tm.rtm_system;
+	uint64_t tid = thread_tid(th);
+	uint64_t before = 0;
+	unsigned i;
+	for (i = 0; i < S8P_TPREV; i++) {
+		if (s8p_tprev[i].tid == tid) {
+			before = s8p_tprev[i].total;
+			break;
+		}
+	}
+	if (i == S8P_TPREV) {
+		i = s8p_tprev_next++ % S8P_TPREV;
+		s8p_tprev[i].tid = tid;
+	}
+	s8p_tprev[i].total = total;
+	return total >= before ? s8p_us(total - before) / 1000 : 0;
+}
+
+static void
+s8prof_sample_pid(int32_t pid)
+{
+	task_t t, task = TASK_NULL;
+	thread_t th;
+	char name[17];
+	int tn = 0, shown = 0, skipped = 0;
+	uint64_t slide = 0;
+
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&tasks, t, task_t, tasks) {
+		if (task_pid(t) == pid) {
+			task_reference(t);
+			task = t;
+			break;
+		}
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+	if (task == TASK_NULL) {
+		return;
+	}
+	proc_name(pid, name, sizeof(name));
+	if (name[0] == '\0') {
+		strlcpy(name, "?", sizeof(name));
+	}
+	vm_map_t map = get_task_map(task);
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+
+	task_lock(task);
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(th);
+		int tid_n = tn++;
+		uint32_t state = th->state;
+		char stc;
+		bool mm;
+		size_t n;
+		uint64_t fp;
+
+		if (ss == NULL || !is_saved_state64(ss)) {
+			continue;
+		}
+		mm = (state & TH_WAIT) &&
+		    (th->block_hint == kThreadWaitPortReceive || th->block_hint == kThreadWaitPortSetReceive);
+		if (mm || (state & TH_IDLE)) {
+			skipped++;
+			continue;
+		}
+		if (shown >= 16) {
+			continue;
+		}
+		shown++;
+		if (state & TH_WAIT) {
+			stc = (state & TH_UNINT) ? 'U' : 'W';
+		} else if (state & TH_RUN) {
+			stc = (th->runq == PROCESSOR_NULL) ? 'R' : 'Q';
+		} else {
+			stc = 'S';
+		}
+		fp = get_saved_state_fp(ss);
+		n = (size_t)snprintf(s8p_line, sizeof(s8p_line),
+		    "S8PROF pc %s[%d] t%d st=%c pc=0x%llx lr=0x%llx cpu=%llu mach_msg=%c bt",
+		    name, pid, tid_n, stc, get_saved_state_pc(ss), get_saved_state_lr(ss),
+		    s8p_thread_cpu_delta_ms(th), mm ? 'y' : 'n');
+		for (int i = 0; i < 6 && fp != 0 && (fp & 7) == 0 && n < sizeof(s8p_line) - 20; i++) {
+			uint64_t frame[2];
+			if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			n += (size_t)snprintf(s8p_line + n, sizeof(s8p_line) - n, " 0x%llx", frame[1]);
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		printf("%s\n", s8p_line);
+	}
+	task_unlock(task);
+	printf("S8PROF slide %s[%d] slide=0x%llx mh=0x%llx skipped=%d\n", name, pid, slide,
+	    (uint64_t)task->mach_header_vm_address, skipped);
+	task_deallocate(task);
+}
