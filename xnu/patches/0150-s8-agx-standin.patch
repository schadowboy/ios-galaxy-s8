+/*
+ * Metal.framework enumerates GPUs with IOServiceMatching("IOAcceleratorES") (IOGPUFamily's class; found in Metal's strings),
+ * the compositor's side matches "IOAccelerator". The chain of the real stack is ... AGXAccelerator -> IOAccelerator -> IOAcceleratorES
+ * -> IOService, so a service of the stand-in matches both names.
+ */
+class IOAcceleratorES : public IOService
+{
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+class IOAccelerator : public IOAcceleratorES
+{
+	OSDeclareDefaultStructors(IOAccelerator);
+};
+
+class AGXAccelerator : public IOAccelerator
+{
+	OSDeclareDefaultStructors(AGXAccelerator);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	/* log which registry properties userland reads (and which of them are missing): that is what Metal sets itself up from */
+	virtual OSPtr<OSObject> copyProperty(const OSSymbol * aKey) const APPLE_KEXT_OVERRIDE;
+	virtual OSPtr<OSObject> copyProperty(const OSString * aKey) const APPLE_KEXT_OVERRIDE;
+	virtual OSPtr<OSObject> copyProperty(const char * aKey) const APPLE_KEXT_OVERRIDE;
+};
+
+class AGXAcceleratorG10P_B0 : public AGXAccelerator
+{
+	OSDeclareDefaultStructors(AGXAcceleratorG10P_B0);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+OSDefineMetaClassAndStructors(IOAccelerator, IOAcceleratorES);
+OSDefineMetaClassAndStructors(AGXAccelerator, IOAccelerator);
+OSDefineMetaClassAndStructors(AGXAcceleratorG10P_B0, AGXAccelerator);
+
+bool
+AGXAccelerator::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AGXDeviceUserClient");
+	setProperty("IOClass", "AGXAcceleratorG10P_B0");
+	setProperty("IOGLBundleName", "AGXGL");
+	setProperty("MetalPluginName", "AGXMetalA11");
+	setProperty("MetalPluginClassName", "AGXA11Device");
+	setName("AGXAcceleratorG10P_B0");
+	registerService();
+	return true;
+}
+
+static volatile SInt32 gAgxPropLogged;
+
+static void
+agx_log_property(const char * key, bool found)
+{
+	if (key != NULL && OSIncrementAtomic((SInt32 *)&gAgxPropLogged) < 300) {
+		IOLog("S8AGX: property '%s' %s\n", key, found ? "found" : "MISSING");
+	}
+}
+
+OSPtr<OSObject>
+AGXAccelerator::copyProperty(const OSSymbol * aKey) const
+{
+	OSPtr<OSObject> r = IOService::copyProperty(aKey);
+
+	agx_log_property(aKey ? aKey->getCStringNoCopy() : NULL, r != NULL);
+	return r;
+}
+
+OSPtr<OSObject>
+AGXAccelerator::copyProperty(const OSString * aKey) const
+{
+	OSPtr<OSObject> r = IOService::copyProperty(aKey);
+
+	agx_log_property(aKey ? aKey->getCStringNoCopy() : NULL, r != NULL);
+	return r;
+}
+
+OSPtr<OSObject>
+AGXAccelerator::copyProperty(const char * aKey) const
+{
+	OSPtr<OSObject> r = IOService::copyProperty(aKey);
+
+	agx_log_property(aKey, r != NULL);
+	return r;
+}
