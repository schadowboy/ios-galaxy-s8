+			}
+			pc += 20;
+		} else if (op == 0xc2 && pc + 4 <= len && b[3] == 0x00) {
+			pc += 4;                                        /* c2 xx yy 00: filler / register-copy form seen around the prologue; treated as a no-op for now */
+		} else if ((op == 0x1e || op == 0x20 || op == 0x23 || op == 0x60 || op == 0x26 || op == 0x16 || op == 0xde) && s8f_len(b, len - pc) != 0 && s8f_len(b, len - pc) <= len - pc) {
+			/* imadd with a literal (`1e .. 60 00` + `20 c0 <imm32>`): the vertex address multiply, stride = the literal (ASSUMED: the literal is the byte stride of
+			 * the attribute stream); the 4-byte 1e/23 pair and the 6-byte `20` literal word are skipped (ASSUMED no-ops for the position math) */
+			unsigned n = s8f_len(b, len - pc);
+
+			if (op == 0x1e && n == 4) {
+				/* `1e D C 00` + `23 X Y 00`: compact integer compare-select of the vertex-id strip programs (after `7e .. 83 00` = vid & 1, vid & 2):
+				 * r[D >> 3] = (r[C] != 0) ? r[X] : r[Y]. The vertex data are the rect (x0, y0, x1, y1) in r0..r3 (device_load of 4 floats), so this selects x1/x0 and y1/y0 per corner.
+				 * ASSUMED field roles (the pair is a 2-instruction select: condition in the first, the two values in the second), verified on the capture21 strips (4 corners of the rect) */
+				c->sel_pending = 1;
+				c->sel_d = (b[1] >> 3) & (S8F_REGS - 1);
+				c->sel_c = c->r[((b[2] & 0x3f) >> 1) & (S8F_REGS - 1)] != 0;
+			} else if ((op == 0x23 || op == 0x60 || (op == 0x20 && b[1] != 0xc0)) && c->sel_pending) {
+				/* values: hint bits non-zero = register, else the byte is an immediate (0 = 0.0f) */
+				uint32_t x = (b[1] >> 6) ? c->r[((b[1] & 0x3f) >> 1) & (S8F_REGS - 1)] : b[1];
+				uint32_t y = (b[2] >> 6) ? c->r[((b[2] & 0x3f) >> 1) & (S8F_REGS - 1)] : b[2];
+
+				c->r[c->sel_d] = c->sel_c ? x : y;
+				c->sel_pending = 0;
+			}
+			if (op == 0x1e && n == 6 && pc + 12 <= len && b[6] == 0x20 && b[7] == 0xc0 && c->rd != 0) {
+				c->stride = (uint32_t)b[8] | ((uint32_t)b[9] << 8) | ((uint32_t)b[10] << 16) | ((uint32_t)b[11] << 24);
+			}
+			s8f_assume(c, op);
+			pc += n;
+		} else if (op == 0x08 && pc + 4 <= len && b[1] == 0x01) {
+			c->pc_end = pc + 4;
+			return c->stored || c->expmask != 0;
+		} else if ((op == 0x7e || op == 0xbe || op == 0x6e || op == 0x2e || op == 0x82 || op == 0x92 || op == 0x12 || op == 0x7a || op == 0xfa || op == 0x1a || op == 0x5a || op == 0x0a) && (c->rd != 0 || c->fetch != 0) && s8f_step_frag(c, b, len - pc) != 0) {
+			/* integer glue of the vertex-id programs (bitop vid & 1, bfeil, convert): the same forms as in fragment programs */
+			pc += s8f_len(b, len - pc);
+		} else {
+			c->unknown = op;
+			c->pc_fail = pc;
+			return 0;
+		}
+	}
+	return c->stored;
+}
+
+/*
+ * Fragment program image start (tests/frag_forms.c: analysis/compositor-frag-forms.md section 0.3, compositor-stream.md).
+ * m/len = memory window of the image, block = offset of the program block the draw's `c0400038 <block VA>` record names ((unsigned)-1 if the draw has none),
+ * entry = offset of the entry pointer (flag bits cleared; the pointer's `& 3 == 2` flag shifts the instruction boundary to entry + 2 for some programs).
+ * Order: (1) block + 0x40 when the instruction-length walk from there lands on the entry (or entry + 2) and reaches `08 01` after it;
+ *        (2) the earliest offset in [entry - 0x100, entry] whose walk does the same (no block, or an image with another header);
+ *        (3) block + 0x40 unverified when the block exists and its first byte decodes (the walk stops on a form not known yet).
+ * Returns 1, 2 or 3 accordingly with *start set, 0 when there is no candidate.
+ */
+static inline int
+s8f_walk_lands2(const uint8_t * m, unsigned len, unsigned start, unsigned entry, unsigned * eff)
+{
+	unsigned pc = start;
+	int hit = start == entry || start == entry + 2;
+
+	*eff = start;                           /* start of the shader the entry belongs to: moves past an earlier shader of the same image (its end + 08 00 padding) */
+
+	while (pc + 2 <= len) {
+		unsigned n = s8f_len(m + pc, len - pc);
+
+		if (n == 0 || pc + n > len) {
+			return 0;
+		}
+		if (m[pc] == 0x08 && m[pc + 1] == 0x01) {
+			if (hit) {
+				return 1;
+			}
+			if (pc + 4 > entry) {
+				return 0;
+			}
+			pc += 4;                        /* an earlier program of the same image: skip its end and the 08 00 padding */
+			while (pc + 2 <= len && m[pc] == 0x08 && m[pc + 1] == 0x00) {
+				pc += 2;
+			}
+			if (pc == entry || pc == entry + 2) {
+				hit = 1;
+			}
+			continue;
+		}
+		pc += n;
+		if (pc == entry || pc == entry + 2) {
+			hit = 1;
+		}
+	}
+	return 0;
+}
+
+static inline int
+s8f_walk_lands(const uint8_t * m, unsigned len, unsigned start, unsigned entry)
+{
+	unsigned eff;
+
+	return s8f_walk_lands2(m, len, start, entry, &eff);
+}
+
+static inline int
+s8f_start_image(const uint8_t * m, unsigned len, unsigned block, unsigned entry, unsigned * start)
+{
+	unsigned q, eff;
+
+	if (block != (unsigned)-1 && block + 0x40 < len && s8f_walk_lands2(m, len, block + 0x40, entry, &eff)) {
+		*start = eff;                   /* block + 0x40, or the later shader of a multi-shader image */
+		return 1;
+	}
+	for (q = entry >= 0x100 ? entry - 0x100 : 0; q <= entry; q++) {
+		if (s8f_walk_lands2(m, len, q, entry, &eff)) {
+			*start = eff;
+			return 2;
+		}
+	}
+	if (block != (unsigned)-1 && block + 0x40 < len && s8f_len(m + block + 0x40, len - block - 0x40) != 0) {
+		/* unverified: still skip the complete shaders that end before the entry pointer (multi-shader image: tile preamble shader, `08 01`, `08 00` padding, the real shader) */
+		unsigned pc = block + 0x40, guard;
+
+		eff = pc;
+		for (guard = 0; guard < 8192 && pc + 2 <= len; guard++) {          /* 8192 instructions (was 64: the glass image's first shader has ~230) */
+			unsigned n = s8f_len(m + pc, len - pc);
+
+			if (n == 0) {
+				break;
+			}
+			if (m[pc] == 0x08 && m[pc + 1] == 0x01) {
+				if (pc + 4 > entry) {
+					break;
+				}
+				pc += 4;
+				while (pc + 2 <= len && m[pc] == 0x08 && m[pc + 1] == 0x00) {
+					pc += 2;
+				}
+				eff = pc;
+				continue;
+			}
+			pc += n;
+		}
+		*start = eff;
+		return 3;
+	}
+	return 0;
+}
+
+/*
+ * Find the real start of a vertex program from the entry pointer of its state record: the pointer can land in the middle of a constant-setup
+ * instruction. Anchor on the fetch prologue (c2 02 02 00 0e 00 c0 ca 1a 04 05 01) within [off-8, off+0x40], then take the optional filler
+ * (c2 00 00 00) and the contiguous run of mov_imm (52 .. 6 bytes) before it. Without a prologue the entry is used as is.
+ * m = memory of the region, len = its length, off = pointer offset in it; returns the start offset.
+ */
+static inline uint32_t
+s8f_rd_zero(void * ctx, uint64_t va)
+{
+	(void)ctx;
+	(void)va;
+	return 0;
+}
+
+static inline unsigned
+s8v_find_start(const uint8_t * m, unsigned len, unsigned off)
+{
+	static const uint8_t sig[5] = { 0xc2, 0x02, 0x02, 0x00, 0x0e };    /* 0x0e or 0x8e (the address multiply-add) follows */
+	unsigned lo = off >= 0x30 ? off - 0x30 : 0;      /* the entry pointer lands inside the prologue or up to ~0x20 bytes into the constant run */
+	unsigned q;
+
+	for (q = lo; q <= off + 0x40 && q + 12 <= len; q++) {
+		unsigned k;
+
+		for (k = 0; k < 4 && m[q + k] == sig[k]; k++) {
+		}
+		if (k == 4 && (m[q + 4] == 0x0e || m[q + 4] == 0x8e)) {
+			unsigned s = q;
+			int n = 0;
+
+			if (s >= 4 && m[s - 4] == 0xc2 && m[s - 3] == 0 && m[s - 2] == 0 && m[s - 1] == 0) {
+				s -= 4;
+			}
+			while (s >= 6 && m[s - 6] == 0x52 && n < 16) {
+				s -= 6;
+				n++;
+			}
+			return s;
+		}
+	}
+	/* no fetch prologue: the earliest start in [off-0x20, off] whose run completes with a position export and reaches past the entry pointer
+	 * (an earlier shader's own end instruction stops a run before the pointer, so it cannot be mistaken for this one) */
+	for (q = off >= 0x60 ? off - 0x60 : 0; q <= off; q++) {          /* 0x60 (was 0x20): the vid-driven strips enter 0x2c bytes after their first instruction */
+		struct s8f_ctx c;
+		f32b zero[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
+		unsigned i;
+		int mode;
+
+		for (mode = 0; mode < 2; mode++) {      /* 0: fetch mode (test-app programs), 1: the uniform/device-load mode of the compositor's programs (8e imadd + device_load) */
+			for (i = 0; i < sizeof(c); i++) {
+				((uint8_t *)&c)[i] = 0;
+			}
+			c.varying = zero;               /* a candidate that starts on an interpolation instruction must not read a null array */
+			if (mode == 0) {
+				c.fetch = zero;
+				c.nfetch = 4;
+			} else {
+				c.rd = s8f_rd_zero;
+				c.stride = 16;
+			}
+			if (s8f_run(&c, m + q, len - q) && (c.expmask & 0xf) == 0xf && q + c.pc_end > off) {
+				return q;
+			}
+		}
+	}
+	return off;
+}
+
+#endif /* S8GFX_FRAG_H */
diff --git a/iokit/Kernel/arm/s8gfx_rast.h b/iokit/Kernel/arm/s8gfx_rast.h
new file mode 100755
index 0000000..36012e9
--- /dev/null
+++ b/iokit/Kernel/arm/s8gfx_rast.h
@@ -0,0 +1,100 @@
+/*
+ * Triangle rasteriser of the kernel-side AGX executor. Integer coverage (28.8 fixed point subpixel positions, top-left fill rule), perspective-correct
+ * varyings in the integer-only soft-float (s8gfx_sf.h). No libc: builds into the kernel and into the host test (scratch/agx/rast_test.c).
+ *
+ * Input vertices are already transformed to framebuffer coordinates: x, y in pixels (float bits), iw = 1 / w (float bits), z unused here.
+ * s8r_tri calls emit(ctx, px, py, varyings) for every covered pixel centre, varyings interpolated for that pixel.
+ */
+#ifndef S8GFX_RAST_H
+#define S8GFX_RAST_H
+
+#include "s8gfx_sf.h"
+
+#define S8R_MAXV 8              /* varying components per vertex */
+
+struct s8r_vtx {
+	f32b x, y;              /* framebuffer position in pixels */
+	f32b iw;                /* 1 / w */
+	f32b v[S8R_MAXV];       /* varyings (not yet divided by w) */
+};
+
+typedef void (*s8r_emit)(void * ctx, int px, int py, const f32b * varying);
+
+/* scissor: pixels [x0,x1) x [y0,y1) only */
+static inline void
+s8r_tri(const struct s8r_vtx * a, const struct s8r_vtx * b, const struct s8r_vtx * c, int nv, int x0, int y0, int x1, int y1, s8r_emit emit, void * ctx)
+{
+	int32_t ax = sf_to_fixed(a->x, 8), ay = sf_to_fixed(a->y, 8);
+	int32_t bx = sf_to_fixed(b->x, 8), by = sf_to_fixed(b->y, 8);
+	int32_t cx = sf_to_fixed(c->x, 8), cy = sf_to_fixed(c->y, 8);
+	int64_t area = (int64_t)(bx - ax) * (cy - ay) - (int64_t)(by - ay) * (cx - ax);   /* twice the signed area, 16 fractional bits */
+	int32_t minx, maxx, miny, maxy;
+	f32b farea;
+	int swap = 0;
+	int32_t px, py;
+
+	if (area == 0) {
+		return;
+	}
+	if (area < 0) {                 /* back-facing / clockwise: rasterise anyway (no culling here), by swapping b and c */
+		int32_t t;
+
+		t = bx; bx = cx; cx = t;
+		t = by; by = cy; cy = t;
+		area = -area;
+		swap = 1;
+	}
+	{
+		const struct s8r_vtx * vb = swap ? c : b;
+		const struct s8r_vtx * vc = swap ? b : c;
+		minx = ax < bx ? (ax < cx ? ax : cx) : (bx < cx ? bx : cx);
+		maxx = ax > bx ? (ax > cx ? ax : cx) : (bx > cx ? bx : cx);
+		miny = ay < by ? (ay < cy ? ay : cy) : (by < cy ? by : cy);
+		maxy = ay > by ? (ay > cy ? ay : cy) : (by > cy ? by : cy);
+		minx = (minx >> 8) - 1;
+		maxx = (maxx >> 8) + 1;
+		miny = (miny >> 8) - 1;
+		maxy = (maxy >> 8) + 1;
+		if (minx < x0) minx = x0;
+		if (miny < y0) miny = y0;
+		if (maxx >= x1) maxx = x1 - 1;
+		if (maxy >= y1) maxy = y1 - 1;
+		farea = sf_from_i64(area);
+
+		for (py = miny; py <= maxy; py++) {
+			for (px = minx; px <= maxx; px++) {
+				int32_t sx = px * 256 + 128, sy = py * 256 + 128;       /* pixel centre */
+				/* edge functions: e0 opposite a (edge b->c), e1 opposite b (edge c->a), e2 opposite c (edge a->b) */
+				int64_t e0 = (int64_t)(cx - bx) * (sy - by) - (int64_t)(cy - by) * (sx - bx);
+				int64_t e1 = (int64_t)(ax - cx) * (sy - cy) - (int64_t)(ay - cy) * (sx - cx);
+				int64_t e2 = (int64_t)(bx - ax) * (sy - ay) - (int64_t)(by - ay) * (sx - ax);
+				/* top-left rule: an edge that is not top/left excludes the samples exactly on it */
+				int tl0 = (cy < by) || (cy == by && cx < bx);       /* "left" edges go up in a y-down system with counter-clockwise order */
+				int tl1 = (ay < cy) || (ay == cy && ax < cx);
+				int tl2 = (by < ay) || (by == ay && bx < ax);
+				f32b w0, w1, w2, sum, out[S8R_MAXV] = { 0, 0, 0, 0, 0, 0, 0, 0 };
+
+				if (e0 < 0 || e1 < 0 || e2 < 0) {
+					continue;
+				}
+				if ((e0 == 0 && !tl0) || (e1 == 0 && !tl1) || (e2 == 0 && !tl2)) {
+					continue;
+				}
+				/* perspective-correct barycentrics: weights e_i * iw_i, normalised by their sum */
+				w0 = sf_mul(sf_from_i64(e0), a->iw);
+				w1 = sf_mul(sf_from_i64(e1), vb->iw);
+				w2 = sf_mul(sf_from_i64(e2), vc->iw);
+				sum = sf_add(sf_add(w0, w1), w2);
+				for (int k = 0; k < nv && k < S8R_MAXV; k++) {
+					f32b num = sf_fma(w2, vc->v[k], sf_fma(w1, vb->v[k], sf_mul(w0, a->v[k])));
+
+					out[k] = sf_div(num, sum);
+				}
+				emit(ctx, px, py, out);
+			}
+		}
+	}
+	(void)farea;
+}
+
+#endif /* S8GFX_RAST_H */
diff --git a/iokit/Kernel/arm/s8gfx_sf.h b/iokit/Kernel/arm/s8gfx_sf.h
new file mode 100755
index 0000000..ed63fcd
--- /dev/null
+++ b/iokit/Kernel/arm/s8gfx_sf.h
@@ -0,0 +1,453 @@
+/*
+ * Integer-only IEEE-754 single precision (round to nearest even) for the kernel-side AGX executor: the XNU kernel is built without floating point.
+ * Floats are bit patterns (uint32_t). Denormal inputs are treated as zero and denormal results flush to zero (what the GPU does, too).
+ * sf_mul, sf_add, sf_sub, sf_fma (single rounding), sf_neg, sf_abs, sf_sat, sf_to_unorm8; tested bit-exact against the host FPU: tools in scratch/agx/sf_test.c.
+ */
+#ifndef S8GFX_SF_H
+#define S8GFX_SF_H
+
+#include <stdint.h>
+
+typedef uint32_t f32b;
+
+#define SF_ONE   0x3f800000u
+#define SF_ZERO  0x00000000u
+#define SF_QNAN  0x7fc00000u
+#define SF_INF   0x7f800000u
+
+static inline int sf_isnan(f32b a) { return ((a >> 23) & 0xff) == 0xff && (a & 0x7fffff); }
+static inline int sf_isinf(f32b a) { return ((a >> 23) & 0xff) == 0xff && !(a & 0x7fffff); }
+static inline f32b sf_neg(f32b a) { return a ^ 0x80000000u; }
+static inline f32b sf_abs(f32b a) { return a & 0x7fffffffu; }
+
+/* unpack: returns 0 for a zero or denormal (value flushed), exponent field in *e (1..254), 24-bit mantissa with the implicit bit in *m */
+static inline int
+sf_unpack(f32b a, uint32_t * s, int32_t * e, uint32_t * m)
+{
+	*s = a >> 31;
+	*e = (int32_t)((a >> 23) & 0xff);
+	if (*e == 0) {
+		*m = 0;
+		return 0;
+	}
+	*m = (a & 0x7fffff) | 0x800000;
+	return 1;
+}
+
+/* round-to-nearest-even pack of sign * mant * 2^(exp - 150): mant is any 64-bit value (sticky already folded into bit 0 by the caller if needed) */
+static inline f32b
+sf_pack64(uint32_t s, int32_t exp, unsigned __int128 mant)
+{
+	int msb;
+	int shift;
+	uint64_t keep;
+	uint64_t rest;
+	uint64_t half;
+
+	if (mant == 0) {
+		return s << 31;
+	}
+	msb = 127;
+	while (!((mant >> msb) & 1)) {
+		msb--;
+	}
+	/* value = mant * 2^(exp-150); we want 24 significant bits: shift right by (msb - 23) */
+	shift = msb - 23;
+	exp += shift;       /* exponent field of the result before rounding: value = (mant >> shift) * 2^(exp-150) */
+	if (shift > 0) {
+		unsigned __int128 mask = (((unsigned __int128)1) << shift) - 1;
+		rest = (uint64_t)0;
+		keep = (uint64_t)(mant >> shift);
+		unsigned __int128 low = mant & mask;
+		unsigned __int128 hf = ((unsigned __int128)1) << (shift - 1);
+		if (low > hf || (low == hf && (keep & 1))) {
+			keep++;
+			if (keep == 0x1000000) {
+				keep >>= 1;
+				exp++;
+			}
+		}
+		(void)rest;
+		(void)half;
+	} else {
+		keep = (uint64_t)(mant << (-shift));
+	}
+	/* now value = keep * 2^(exp-150), keep in [2^23, 2^24): exponent field = exp */
+	if (exp >= 255) {
+		return (s << 31) | SF_INF;
+	}
+	if (exp <= 0) {
+		return s << 31;     /* flush denormals */
+	}
+	return (s << 31) | ((uint32_t)exp << 23) | ((uint32_t)keep & 0x7fffff);
+}
+
+static inline f32b
+sf_mul(f32b a, f32b b)
+{
+	uint32_t sa, sb, ma, mb;
+	int32_t ea, eb;
+	int za = !sf_unpack(a, &sa, &ea, &ma), zb = !sf_unpack(b, &sb, &eb, &mb);
+
+	if (sf_isnan(a) || sf_isnan(b)) {
+		return SF_QNAN;
+	}
+	if (sf_isinf(a) || sf_isinf(b)) {
+		if (za || zb) {
+			return SF_QNAN;
+		}
+		return ((sa ^ sb) << 31) | SF_INF;
+	}
+	if (za || zb) {
+		return (sa ^ sb) << 31;
+	}
+	/* (ma * 2^(ea-150)) * (mb * 2^(eb-150)) = (ma*mb) * 2^(ea+eb-300) = P * 2^((ea+eb-150) - 150) */
+	return sf_pack64(sa ^ sb, ea + eb - 150, (unsigned __int128)((uint64_t)ma * (uint64_t)mb));
+}
+
+/* a + b where both are finite; magnitudes aligned with 128-bit arithmetic and a sticky bit */
+static inline f32b
+sf_add_core(uint32_t sa, int32_t ea, unsigned __int128 ma, uint32_t sb, int32_t eb, unsigned __int128 mb)
+{
+	/* value a = ma * 2^(ea-150), b = mb * 2^(eb-150); bring both to the smaller exponent with headroom */
+	int32_t e;
+	int d;
+	unsigned __int128 big, small;
+	uint32_t sbig, ssmall;
+	int32_t ebig;
+	unsigned __int128 sum;
+	int sticky = 0;
+
+	if (ma == 0) {
+		return sf_pack64(sb, eb, mb);
+	}
+	if (mb == 0) {
+		return sf_pack64(sa, ea, ma);
+	}
+	if (ea >= eb) {
+		big = ma; small = mb; sbig = sa; ssmall = sb; ebig = ea; d = ea - eb;
+	} else {
+		big = mb; small = ma; sbig = sb; ssmall = sa; ebig = eb; d = eb - ea;
+	}
+	/* big has at most 49 bits (fma product) so shifting it left by 64 keeps it below 2^113 */
+	big <<= 64;
+	e = ebig - 64;
+	if (d >= 120) {
+		small = 0;
+		sticky = 1;
+	} else {
+		small <<= 64;
+		if (d > 0) {
+			unsigned __int128 lost = small & ((((unsigned __int128)1) << d) - 1);
+			small >>= d;
+			if (lost) {
+				sticky = 1;
+			}
+		}
+	}
+	if (sbig == ssmall) {
+		sum = big + small;
+	} else if (big >= small) {
+		sum = big - small;
+		if (sticky) {
+			sum--;           /* the true subtrahend is slightly larger than the truncated one */
+		}
+	} else {
+		sum = small - big;
+	}
+	if (sum == 0 && !sticky) {
+		return 0;
+	}
+	if (sticky) {
+		sum = (sum << 1) | 1;   /* keep the sticky information below the rounding bit */
+		e -= 1;
+	}
+	return sf_pack64(big >= small || sbig == ssmall ? sbig : ssmall, e, sum);
+}
+
+static inline f32b
+sf_add(f32b a, f32b b)
+{
+	uint32_t sa, sb, ma, mb;
+	int32_t ea, eb;
+	int za = !sf_unpack(a, &sa, &ea, &ma), zb = !sf_unpack(b, &sb, &eb, &mb);
+
+	if (sf_isnan(a) || sf_isnan(b)) {
+		return SF_QNAN;
+	}
+	if (sf_isinf(a)) {
+		return (sf_isinf(b) && sa != sb) ? SF_QNAN : a;
+	}
+	if (sf_isinf(b)) {
+		return b;
+	}
+	if (za && zb) {
+		return (sa & sb) << 31;
+	}
+	if (za) {
+		return b;
+	}
+	if (zb) {
+		return a;
+	}
+	return sf_add_core(sa, ea, ma, sb, eb, mb);
+}
+
+static inline f32b sf_sub(f32b a, f32b b) { return sf_add(a, sf_neg(b)); }
+
+/* fused multiply-add: a * b + c with a single rounding */
+static inline f32b
+sf_fma(f32b a, f32b b, f32b c)
+{
+	uint32_t sa, sb, sc, ma, mb, mc;
+	int32_t ea, eb, ec;
+	int za = !sf_unpack(a, &sa, &ea, &ma), zb = !sf_unpack(b, &sb, &eb, &mb), zc = !sf_unpack(c, &sc, &ec, &mc);
+
+	if (sf_isnan(a) || sf_isnan(b) || sf_isnan(c)) {
+		return SF_QNAN;
+	}
+	if (sf_isinf(a) || sf_isinf(b)) {
+		if (za || zb) {
+			return SF_QNAN;
+		}
+		f32b p = ((sa ^ sb) << 31) | SF_INF;
+		return (sf_isinf(c) && ((c >> 31) != (p >> 31))) ? SF_QNAN : p;
+	}
+	if (sf_isinf(c)) {
+		return c;
+	}
+	if (za || zb) {
+		return zc ? ((((sa ^ sb) & sc)) << 31) : c;
+	}
+	{
+		unsigned __int128 p = (unsigned __int128)((uint64_t)ma * (uint64_t)mb);
+		int32_t ep = ea + eb - 150;       /* product = p * 2^(ep - 150) */
+
+		if (zc) {
+			return sf_pack64(sa ^ sb, ep, p);
+		}
+		return sf_add_core(sa ^ sb, ep, p, sc, ec, mc);
+	}
+}
+
+/* a / b, correctly rounded */
+static inline f32b
+sf_div(f32b a, f32b b)
+{
+	uint32_t sa, sb, ma, mb;
+	int32_t ea, eb;
+	int za = !sf_unpack(a, &sa, &ea, &ma), zb = !sf_unpack(b, &sb, &eb, &mb);
+	uint32_t s = sa ^ sb;
+
+	if (sf_isnan(a) || sf_isnan(b)) {
+		return SF_QNAN;
+	}
+	if (sf_isinf(a)) {
+		return sf_isinf(b) ? SF_QNAN : ((s << 31) | SF_INF);
+	}
+	if (sf_isinf(b)) {
+		return s << 31;
+	}
+	if (zb) {
+		return za ? SF_QNAN : ((s << 31) | SF_INF);
+	}
+	if (za) {
+		return s << 31;
+	}
+	{
+		uint64_t num = (uint64_t)ma << 32;
+		uint64_t q = num / mb;
+		uint64_t rem = num % mb;
+
+		return sf_pack64(s, ea - eb + 117, (((unsigned __int128)q) << 1) | (rem ? 1 : 0));
+	}
+}
+
+/* integer -> float, correctly rounded */
+static inline f32b
+sf_from_i64(int64_t v)
+{
+	uint32_t s = v < 0;
+	uint64_t mag = s ? (uint64_t)(-(v + 1)) + 1 : (uint64_t)v;
+
+	if (mag == 0) {
+		return 0;
+	}
+	return sf_pack64(s, 150, (unsigned __int128)mag);
+}
+
+/* float -> signed fixed point with `frac` fractional bits, rounded half away from zero, saturating to int32 (the rasteriser's subpixel positions) */
+static inline int32_t
+sf_to_fixed(f32b a, int frac)
+{
+	uint32_t s = a >> 31;
+	int32_t e = (int32_t)((a >> 23) & 0xff);
+	uint64_t m;
+	int sh;
+	uint64_t r;
+
+	if (e == 0 || sf_isnan(a)) {
+		return 0;
+	}
+	if (e == 0xff) {
+		return s ? INT32_MIN : INT32_MAX;
+	}
+	m = (a & 0x7fffff) | 0x800000;
+	sh = e - 150 + frac;                    /* value = m * 2^sh */
+	if (sh >= 0) {
+		if (sh > 8) {
+			return s ? INT32_MIN : INT32_MAX;
+		}
+		r = m << sh;
+	} else if (-sh >= 40) {
+		return 0;
+	} else {
+		r = (m + (1ULL << (-sh - 1))) >> -sh;
+	}
+	if (r > 0x7fffffffULL) {
+		return s ? INT32_MIN : INT32_MAX;
+	}
+	return s ? -(int32_t)r : (int32_t)r;
+}
+
+/* clamp to [0, 1] (NaN -> 0) */
+static inline f32b
+sf_sat(f32b a)
+{
+	if (sf_isnan(a) || (a >> 31)) {
+		return SF_ZERO;
+	}
+	if (a >= SF_ONE) {
+		return SF_ONE;
+	}
+	return a;
+}
+
+/* float -> 8-bit unorm, round half up (the conversion the tile store uses) */
+static inline uint8_t
+sf_to_unorm8(f32b b)
+{
+	uint32_t e = (b >> 23) & 0xff;
+	uint64_t mant;
+	uint32_t shift;
+	uint64_t r;
+
+	if (b >> 31) {
+		return 0;
+	}
+	if (e == 0xff) {
+		return (b & 0x7fffff) ? 0 : 255;
+	}
+	if (e >= 127) {
+		return 255;
+	}
+	if (e == 0) {
+		return 0;
+	}
+	mant = (b & 0x7fffff) | 0x800000;
+	shift = 23 + (127 - e);
+	if (shift >= 62) {
+		return 0;
+	}
+	r = (mant * 255 + (1ULL << (shift - 1))) >> shift;
+	return r > 255 ? 255 : (uint8_t)r;
+}
+
+/* Mesa's 8-bit float immediate (agx_minifloat.h) as float bits */
+static inline f32b
+sf_minifloat(uint8_t imm)
+{
+	uint32_t sign = (imm & 0x80) ? 0x80000000u : 0;
+	int exp = (imm & 0x70) >> 4;
+	uint32_t man = imm & 0xF;
+	uint32_t m;
+	int e;
+
+	if (exp) {
+		m = man | 0x10;                 /* 1.xxxx * 16 = value mant * 2^(exp-7) */
+		e = exp - 7;
+	} else {
+		m = man;
+		e = -6;
+		if (m == 0) {
+			return sign;
+		}
+	}
+	/* value = m * 2^e with m in [1, 31]: normalise */
+	int msb = 4;
+	while (msb >= 0 && !((m >> msb) & 1)) {
+		msb--;
+	}
+	/* m = 1.xxx * 2^msb  =>  value = (m << (23 - msb)) * 2^(e + msb - 23) */
+	return sign | ((uint32_t)(e + msb + 127) << 23) | (((m << (23 - msb)) & 0x7fffff));
+}
+
+/* IEEE half -> float bits (exact) */
+static inline f32b
+sf_h2f(uint16_t h)
+{
+	uint32_t s = ((uint32_t)h & 0x8000) << 16;
+	uint32_t e = (h >> 10) & 0x1f;
+	uint32_t m = h & 0x3ff;
+
+	if (e == 0x1f) {
+		return s | 0x7f800000u | (m << 13);
+	}
+	if (e == 0) {
+		int sh = 0;
+
+		if (m == 0) {
+			return s;
+		}
+		while (!(m & 0x400)) {                  /* normalise the subnormal */
+			m <<= 1;
+			sh++;
+		}
+		return s | ((uint32_t)(113 - sh) << 23) | ((m & 0x3ff) << 13);
+	}
+	return s | ((e + 112) << 23) | (m << 13);
+}
+
+/* float bits -> IEEE half, round to nearest even */
+static inline uint16_t
+sf_f2h(f32b f)
+{
+	uint32_t s = (f >> 16) & 0x8000;
+	int e = (f >> 23) & 0xff;
+	uint32_t m = f & 0x7fffff;
+	int ne;
+	uint32_t r, rem;
+
+	if (e == 0xff) {
+		return (uint16_t)(s | 0x7c00 | (m ? 0x200 : 0));
+	}
+	ne = e - 127 + 15;
+	if (ne >= 31) {
+		return (uint16_t)(s | 0x7c00);
+	}
+	if (ne <= 0) {
+		int sh;
+		uint32_t half;
+
+		if (ne < -10) {
+			return (uint16_t)s;
+		}
+		m |= 0x800000;
+		sh = 14 - ne;
+		r = m >> sh;
+		rem = m & ((1u << sh) - 1);
+		half = 1u << (sh - 1);
+		if (rem > half || (rem == half && (r & 1))) {
+			r++;
+		}
+		return (uint16_t)(s | r);
+	}
+	r = ((uint32_t)ne << 10) | (m >> 13);
+	rem = m & 0x1fff;
+	if (rem > 0x1000 || (rem == 0x1000 && (r & 1))) {
+		r++;                                    /* a carry into the exponent is the correct rounding */
+	}
+	return (uint16_t)(s | r);
+}
+
+#endif /* S8GFX_SF_H */
diff --git a/iokit/Kernel/arm/s8gfx_stream.h b/iokit/Kernel/arm/s8gfx_stream.h
new file mode 100755
index 0000000..2ccd8d0
--- /dev/null
+++ b/iokit/Kernel/arm/s8gfx_stream.h
@@ -0,0 +1,474 @@
+/*
+ * Decoder for the compositor's (backboardd / CoreAnimation) AGX command stream: turns a pass's stream into a DRAW LIST.
+ * Format, evidence and confidence per field: analysis/compositor-stream.md.  Host test: tests/stream_decode.c (capture17).
+ * Integer-only, no libc, C++-compatible (only <stdint.h>). Memory is read through a callback, like core/S8Agx.cpp.reference agxRd,
+ * but with an explicit "mapped" result so that zero words are distinguishable from holes:
+ *
+ *     static int rd(void *ctx, uint64_t va, uint32_t *out) { ... *out = word at GPU VA; return 1 if va is inside a resource; ... }
+ *
+ * All pointers inside the stream are 32-bit and mean GPU VA 0x1_0000_0000 | lo32 (every backboardd resource lives below 0x2_0000_0000).
+ *
+ * Stream grammar (dwords, little endian):
+ *   80000001 <lo>            LINK    continue at VA lo
+ *   c0000000                 END     of the pass stream
+ *   (n<<8)|1 <lo>            LOAD    copy n dwords from VA lo into the hardware state; the kind is told by n and the first dword:
+ *        n=9  c00 ..              viewport block   [0xc00][0x8000_0000|xmin<<16|xmax][ymin<<16|ymax][tx][sx][ty][sy][0.0][1.0]  (32-px tile bounds)
+ *        n=6  1f ..               pipeline state   [0x1f][..][ctl][0x0e000000][ctl][0x0e000000], ctl bit 24 = blend (HYPOTHESIS)
+ *        n=5  c0 ..               fragment bind    [0xc0][flags][fragment slot VA|k][program tail VA][reg-count class]
+ *        n=3  02000000 ..         end-of-pass tile bounds        n=3 00210000 ..  constant       n=3 other: sampler state
+ *        n=2  00020000 0N0F0000   vertex info (N = vertex register class = B value)        n=2 00000020 x  draw/visibility slot
+ *   48004000|48002000 <w>   A  vertex-stage launch (low half 0x4000 / 0x2000 = thread capacity class), followed by
+ *   <slot VA|4> <regs>      B  pointer to the vertex slot in the vertex state ring (res_16 in capture17) and its register class
+ *   5000xxxx 0000ffff       index prefix (before every indexed draw; 0xc060 before the 7e44 draws)
+ *   6e44pp00 count inst-1 0 trailer          non-indexed draw  (pp = primitive: 1 = lines? 6 = triangle list, 9 = triangle strip)
+ *   7e42pp01 idxVA count inst-1 0 trailer    indexed draw      (16-bit indices, ASSUMED)
+ *   7e440001 ptr 0 0 0 trailer               "other" draw: lives in the chunk right after a pass's head LINK, which the LINK skips (the link is
+ *                                            patched past it when the pass needs no clear? HYPOTHESIS); the chunk ends with 20000160 and falls into the body
+ *   20000160                                 single-word token between that chunk and the body
+ * A slot (vertex or fragment) is a run of 2-dword push records followed by one state record:
+ *   push  <w0> <w1>:  type = w0 & 0xff: 0x03 / 0x33 uniform, 0x13 sampler state, 0x17 texture state;
+ *                     source VA = (w1 << 8) | (w0 >> 24 & 0xfc), size = (w0 >> 20 & 0x1f) halves (0 = 32), destination = w0 >> 8 & 0xff
+ *   state <hdr> <entry|flags> [extra if hdr bit 10] [0x108]  [c0400038 <program block VA>]:
+ *                     hdr 0x0001xx1f/2f/3f = vertex program, 0x0011xx1f/2f/3f = fragment program
+ */
+#ifndef S8GFX_STREAM_H
+#define S8GFX_STREAM_H
+
+#include <stdint.h>
+
+#define S8S_HI           0x100000000ULL
+#define S8S_MAXPUSH      16
+#define S8S_MAXDRAW      512
+
+#define S8S_DRAW_LIST    0       /* 6e44: non-indexed */
+#define S8S_DRAW_INDEXED 1       /* 7e42 */
+#define S8S_DRAW_OTHER   2       /* 7e44 */
+
+#define S8S_PUSH_UNIFORM 0x03
+#define S8S_PUSH_SAMPLER 0x13
+#define S8S_PUSH_TEXTURE 0x17
+
+typedef int (*s8s_rd_fn)(void * ctx, uint64_t va, uint32_t * out);
+
+struct s8s_push {
+	uint32_t w0, w1;
+	uint32_t type;                  /* w0 & 0xff */
+	uint64_t va;                    /* source address */
+	uint32_t halves;                /* size in 16-bit units (uniform pushes; 32 when the field is 0) */
+	uint32_t dest;                  /* destination register / state index (w0 >> 8 & 0xff) */
+	uint32_t flags;                 /* (w0 >> 24) & 3: bit 1 seen set on uniform pushes whose data is f32, meaning [?] */
+};
+
+struct s8s_prog {
+	uint32_t found;                 /* a state record was found */
+	uint64_t slot;                  /* slot start VA (pointer & ~0x1f) */
+	uint32_t slot_k;                /* pointer & 0x1f */
+	uint32_t hdr;                   /* state header dword */
+	uint64_t entry;                 /* program entry VA (pointer & ~3) */
+	uint32_t entry_flags;           /* pointer & 3 */
+	uint64_t extra;                 /* second pointer when hdr bit 10 is set (0x2cf58 / 0x2f358 class), else 0 */
+	uint64_t block;                 /* c0400038 record: start of the program image (header block), else 0 */
+	uint32_t npush;
+	struct s8s_push push[S8S_MAXPUSH];
+};
+
+struct s8s_draw {
+	uint32_t pass;                  /* index of the pass in the call */
+	uint64_t pc;                    /* VA of the draw header in the stream */
+	uint32_t kind;                  /* S8S_DRAW_* */
+	uint32_t hdr;                   /* draw header dword */
+	uint32_t prim;                  /* primitive code = hdr >> 8 & 0xff */
+	uint32_t count;                 /* vertices (or indices) */
+	uint32_t instances;
+	uint64_t index_va;              /* indexed draws */
+	uint32_t index_mask;            /* 0000ffff word of the index prefix */
+	uint32_t trailer;               /* 0xaa / 0x1fe / 0x100 / 0x200: not decoded */
+	uint32_t launch0, launch1;      /* A record: 0x48004000 / 0x48002000, 2 / 4 */
+	uint32_t vs_regs;               /* B value */
+	uint32_t vsinfo[2];             /* 00020000 0N0F0000 */
+	uint32_t fs_bind[5];            /* LOAD5 */
+	uint32_t fs_regs;               /* LOAD5 last dword */
+	uint64_t fs_tail;               /* LOAD5 program tail VA */
+	uint32_t pipe[6];
+	uint32_t blend;                 /* pipe[2] bit 24 (HYPOTHESIS) */
+	uint32_t sampler[3];            /* LOAD3 from the sampler ring */
+	uint64_t sampler_va;
+	uint32_t drawslot[2];           /* LOAD2 00000020 x */
+	uint32_t vp_valid;
+	uint32_t vp[4];                 /* float bits: translate x, scale x, translate y, scale y (centre / half-extent, y flipped) */
+	uint32_t tile_x0, tile_x1, tile_y0, tile_y1;   /* 32-pixel tile bounds of the pass region (viewport block words 1 and 2) */
+	struct s8s_prog vs, fs;
+};
+
+struct s8s_stats {
+	uint32_t tokens, loads, links, draws, unknown_words, unknown_loads, end_seen, bad_ptr, barriers;
+	uint32_t first_unknown;
+};
+
+struct s8s_pass {
+	uint32_t block;                 /* byte offset of the block in the kernel command list */
+	uint64_t stream;                /* stream start VA (a LINK) */
+	uint32_t width, height;         /* kernel command list block +0x690 / +0x694 */
+	uint32_t slotA, slotB;          /* fragment slot pointers (block +0x2b0, +0x2d0): load/clear and store programs of the pass */
+	uint32_t flags;                 /* block +0x2a8 */
+	uint32_t has_target;
+	uint64_t target_va;             /* render target taken from the first texture-state push of the two slots */
+	uint32_t target_fmt, target_w1; /* its first two dwords */
+	uint32_t target_form;           /* 1: {fmt, w1, VA>>4, 0x200..}   2: {fmt, w1, 0x40000000 | VA>>2, ..} */
+};
+
+static inline uint32_t
+s8s_u32(s8s_rd_fn rd, void * ctx, uint64_t va, int * ok)
+{
+	uint32_t v = 0;
+
+	if (!rd(ctx, va, &v)) {
+		*ok = 0;
+		return 0;
+	}
+	return v;
+}
+
+/* push record -> fields */
+static inline void
+s8s_push_decode(struct s8s_push * p, uint32_t w0, uint32_t w1)
+{
+	p->w0 = w0;
+	p->w1 = w1;
+	p->type = w0 & 0xff;
+	p->va = ((uint64_t)w1 << 8) | ((w0 >> 24) & 0xfc);   /* bit 1 of the low byte (0x22, 0xb2, 0x82 ...) is a flag, NOT an address bit: the data is 4-aligned (tests/comp_replay.c) */
+	p->flags = (w0 >> 24) & 3;
+	p->halves = (w0 >> 20) & 0x1f;
+	if (p->halves == 0) {
+		p->halves = 32;
+	}
+	p->dest = (w0 >> 8) & 0xff;
+}
+
+/* texture-state / attachment record (6 dwords) -> base address; returns the form (0 = not recognised) */
+static inline int
+s8s_texrec_va(const uint32_t * w, uint64_t * va)
+{
+	if (w[2] >= 0x10000000u && w[2] < 0x20000000u && (w[3] & 0xff) == 0 && (w[3] & 0x200) != 0) {
+		*va = (uint64_t)w[2] << 4;
+		return 1;
+	}
+	if ((w[2] & 0x40000000u) != 0) {
+		*va = ((uint64_t)(w[2] & 0x3fffffffu) << 2) | S8S_HI;
+		return 2;
+	}
+	return 0;
+}
+
+/* parse one vertex / fragment slot at `ptr` (low 32 bits) */
+static inline void
+s8s_parse_slot(s8s_rd_fn rd, void * ctx, uint32_t ptr, struct s8s_prog * pg)
+{
+	uint64_t base = S8S_HI | (ptr & ~0x1fu);
+	uint32_t off = 0;
+	int i;
+
+	pg->found = 0;
+	pg->slot = base;
+	pg->slot_k = ptr & 0x1f;
+	pg->npush = 0;
+	pg->entry = pg->extra = pg->block = 0;
+	pg->entry_flags = 0;
+	pg->hdr = 0;
+	for (i = 0; i < 48; i++) {
+		int ok = 1;
+		uint32_t w0 = s8s_u32(rd, ctx, base + off, &ok);
+		uint32_t w1 = s8s_u32(rd, ctx, base + off + 4, &ok);
+
+		if (!ok) {
+			return;
+		}
+		if ((w0 & 0xf) == 0xf && ((w0 >> 16) == 0x0001 || (w0 >> 16) == 0x0011)) {
+			uint32_t t;
+
+			pg->hdr = w0;
+			pg->entry = S8S_HI | (w1 & ~3u);
+			pg->entry_flags = w1 & 3;
+			off += 8;
+			if (w0 & 0x400) {
+				pg->extra = S8S_HI | s8s_u32(rd, ctx, base + off, &ok);
+				off += 4;
+			}
+			t = s8s_u32(rd, ctx, base + off, &ok);
+			if (t == 0x108) {
+				off += 4;
+				t = s8s_u32(rd, ctx, base + off, &ok);
+			}
+			if (ok && t == 0xc0400038u) {
+				pg->block = S8S_HI | s8s_u32(rd, ctx, base + off + 4, &ok);
+			}
+			pg->found = 1;
+			return;
+		}
+		if (((w0 & 0xf) == 3 || (w0 & 0xff) == 0x17) && (w1 >> 24) == 1) {
+			if (pg->npush < S8S_MAXPUSH) {
+				s8s_push_decode(&pg->push[pg->npush], w0, w1);
+				pg->npush++;
+			}
+			off += 8;
+			continue;
+		}
+		return;                         /* anything else ends the slot without a state record */
+	}
+}
+
+struct s8s_state {
+	struct s8s_draw d;              /* the persistent state; copied into every draw */
+	uint32_t have_fs;
+};
+
+static inline void
+s8s_zero(void * p, uint32_t n)
+{
+	uint8_t * b = (uint8_t *)p;
+	uint32_t i;
+
+	for (i = 0; i < n; i++) {
+		b[i] = 0;
+	}
+}
+
+static inline void
+s8s_load(s8s_rd_fn rd, void * ctx, struct s8s_state * S, uint32_t n, uint32_t ptr, struct s8s_stats * st)
+{
+	uint32_t d[16];
+	uint32_t i;
+	int ok = 1;
+
+	for (i = 0; i < n && i < 16; i++) {
+		d[i] = s8s_u32(rd, ctx, (S8S_HI | ptr) + 4 * i, &ok);
+	}
+	if (!ok) {
+		st->bad_ptr++;
+		return;
+	}
+	st->loads++;
+	if (n == 9 && d[0] == 0xc00) {
+		S->d.vp_valid = 1;
+		S->d.tile_x0 = (d[1] >> 16) & 0x7fff;
+		S->d.tile_x1 = d[1] & 0xffff;
+		S->d.tile_y0 = d[2] >> 16;
+		S->d.tile_y1 = d[2] & 0xffff;
+		for (i = 0; i < 4; i++) {
+			S->d.vp[i] = d[3 + i];
+		}
+	} else if (n == 6 && d[0] == 0x1f) {
+		for (i = 0; i < 6; i++) {
+			S->d.pipe[i] = d[i];
+		}
+		S->d.blend = (d[2] >> 24) & 1;
+	} else if (n == 5 && d[0] == 0xc0) {
+		for (i = 0; i < 5; i++) {
+			S->d.fs_bind[i] = d[i];
+		}
+		S->d.fs_tail = d[3] ? (S8S_HI | d[3]) : 0;
+		S->d.fs_regs = d[4];
+		s8s_parse_slot(rd, ctx, d[2], &S->d.fs);
+		S->have_fs = 1;
+	} else if (n == 3 && d[0] == 0x02000000u) {
+		/* end-of-pass tile bounds: nothing to keep */
+	} else if (n == 3 && d[0] == 0x00210000u) {
+		/* constant 00210000 1e3ce508 000004a0 */
+	} else if (n == 3) {
+		for (i = 0; i < 3; i++) {
+			S->d.sampler[i] = d[i];
+		}
+		S->d.sampler_va = S8S_HI | ptr;
+	} else if (n == 2 && d[0] == 0x00020000u) {
+		S->d.vsinfo[0] = d[0];
+		S->d.vsinfo[1] = d[1];
+	} else if (n == 2 && d[0] == 0x20) {
+		S->d.drawslot[0] = d[0];
+		S->d.drawslot[1] = d[1];
+	} else {
+		if (st->unknown_loads == 0) {
+			st->first_unknown = ptr;
+		}
+		st->unknown_loads++;
+	}
+}
+
+/*
+ * Walk one pass stream from `stream` (the start pointer of the kernel command list block: a LINK) to its END, appending the draws.
+ * `pass` is stored in each draw. Returns the number of draws appended (0..max). st may be NULL.
+ */
+static inline int
+s8s_scan(s8s_rd_fn rd, void * ctx, uint64_t stream, uint32_t pass, struct s8s_draw * out, int max, struct s8s_stats * st)
+{
+	struct s8s_state S;
+	struct s8s_stats local;
+	uint64_t pc = stream;
+	int nd = 0;
+	int steps;
+
+	if (st == 0) {
+		st = &local;
+	}
+	s8s_zero(&S, sizeof(S));
+	s8s_zero(st, sizeof(*st));
+	for (steps = 0; steps < 20000 && nd < max; steps++) {
+		int ok = 1;
+		uint32_t w = s8s_u32(rd, ctx, pc, &ok);
+		uint32_t h = w >> 24, m = (w >> 16) & 0xff;
+
+		if (!ok) {
+			st->bad_ptr++;
+			break;
+		}
+		st->tokens++;
+		if (w == 0x80000001u) {
+			pc = S8S_HI | s8s_u32(rd, ctx, pc + 4, &ok);
+			st->links++;
+			continue;
+		}
+		if (w == 0xc0000000u) {
+			st->end_seen = 1;
+			break;
+		}
+		if ((w & 0xffff00ffu) == 1 && ((w >> 8) & 0xff) >= 1 && ((w >> 8) & 0xff) <= 16) {
+			s8s_load(rd, ctx, &S, (w >> 8) & 0xff, s8s_u32(rd, ctx, pc + 4, &ok), st);
+			pc += 8;
+			continue;
+		}
+		if (h == 0x48 && m == 0x00 && (w & 0xffff) != 0) {
+			S.d.launch0 = w;
+			S.d.launch1 = s8s_u32(rd, ctx, pc + 4, &ok);
+			S.d.vs_regs = s8s_u32(rd, ctx, pc + 12, &ok);
+			s8s_parse_slot(rd, ctx, s8s_u32(rd, ctx, pc + 8, &ok), &S.d.vs);
+			pc += 16;
+			continue;
+		}
+		if (w == 0x20000160u) {
+			pc += 4;                /* single-word token between a pass's skipped first chunk and its body (barrier / begin-body, HYPOTHESIS) */
+			st->barriers++;
+			continue;
+		}
+		if (h == 0x50) {
+			S.d.index_mask = s8s_u32(rd, ctx, pc + 4, &ok);
+			pc += 8;
+			continue;
+		}
+		if ((h == 0x6e && m == 0x44) || (h == 0x7e && (m == 0x42 || m == 0x44))) {
+			struct s8s_draw * d = &out[nd];
+			uint32_t k = 0;
+
+			*d = S.d;
+			d->pass = pass;
+			d->pc = pc;
+			d->hdr = w;
+			d->prim = (w >> 8) & 0xff;
+			if (h == 0x6e) {
+				d->kind = S8S_DRAW_LIST;
+				d->count = s8s_u32(rd, ctx, pc + 4, &ok);
+				d->instances = s8s_u32(rd, ctx, pc + 8, &ok) + 1;
+				d->trailer = s8s_u32(rd, ctx, pc + 16, &ok);
+				k = 20;
+			} else if (m == 0x42) {
+				d->kind = S8S_DRAW_INDEXED;
+				d->index_va = S8S_HI | s8s_u32(rd, ctx, pc + 4, &ok);
+				d->count = s8s_u32(rd, ctx, pc + 8, &ok);
+				d->instances = s8s_u32(rd, ctx, pc + 12, &ok) + 1;
+				d->trailer = s8s_u32(rd, ctx, pc + 20, &ok);
+				k = 24;
+			} else {
+				d->kind = S8S_DRAW_OTHER;
+				d->index_va = S8S_HI | s8s_u32(rd, ctx, pc + 4, &ok);
+				d->trailer = s8s_u32(rd, ctx, pc + 20, &ok);
+				k = 24;
+			}
+			nd++;
+			st->draws++;
+			pc += k;
+			continue;
+		}
+		if (st->unknown_words == 0) {
+			st->first_unknown = (uint32_t)pc;
+		}
+		st->unknown_words++;
+		pc += 4;
+	}
+	return nd;
+}
+
+/*
+ * Kernel command list (shmem type 1) -> passes. A pass block is recognised by {0x818, 0x7e8, 0x30, 1, <stream lo>, <stream hi = 1>} at block +0x28; the
+ * block starts 0x28 before that (blocks are 0x820 bytes apart, the first one's header can be missing from a capture, so the marker is used).
+ */
+static inline int
+s8s_find_passes(const uint32_t * cl, uint32_t ndw, struct s8s_pass * out, int max)
+{
+	int n = 0;
+	uint32_t i;
+
+	for (i = 0; i + 8 <= ndw && n < max; i++) {
+		if (cl[i] == 0x818 && cl[i + 1] == 0x7e8 && cl[i + 2] == 0x30 && cl[i + 3] == 1 && cl[i + 5] == 1 && i >= 10) {
+			uint32_t b = (i - 10) * 4;          /* i is the dword index of marker word 0 = block +0x28 */
+			struct s8s_pass * p = &out[n];
+
+			s8s_zero(p, sizeof(*p));
+			p->block = b;
+			p->stream = S8S_HI | cl[i + 4];
+			if ((b + 0x698) / 4 < ndw) {
+				p->width = cl[(b + 0x690) / 4];
+				p->height = cl[(b + 0x694) / 4];
+			}
+			if ((b + 0x2d4) / 4 < ndw) {
+				p->flags = cl[(b + 0x2a8) / 4];
+				p->slotA = cl[(b + 0x2b0) / 4];
+				p->slotB = cl[(b + 0x2d0) / 4];
+			}
+			n++;
+			i += 8;
+		}
+	}
+	return n;
+}
+
+/* render target of a pass: the first texture-state push (type 0x17) of its two slots, read as a 6-dword record */
+static inline void
+s8s_pass_target(s8s_rd_fn rd, void * ctx, struct s8s_pass * p)
+{
+	uint32_t s[2];
+	int a, i, j;
+
+	s[0] = p->slotB;
+	s[1] = p->slotA;
+	p->has_target = 0;
+	for (a = 0; a < 2; a++) {
+		struct s8s_prog pg;
+
+		if (s[a] == 0) {
+			continue;
+		}
+		s8s_parse_slot(rd, ctx, s[a], &pg);
+		for (i = 0; i < (int)pg.npush; i++) {
+			uint32_t w[6];
+			int ok = 1;
+			uint64_t va;
+			int form;
+
+			if (pg.push[i].type != S8S_PUSH_TEXTURE) {
+				continue;
+			}
+			for (j = 0; j < 6; j++) {
+				w[j] = s8s_u32(rd, ctx, pg.push[i].va + 4 * j, &ok);
+			}
+			form = ok ? s8s_texrec_va(w, &va) : 0;
+			if (form != 0) {
+				p->has_target = 1;
+				p->target_va = va;
+				p->target_fmt = w[0];
+				p->target_w1 = w[1];
+				p->target_form = form;
+				return;
+			}
+		}
+	}
+}
+
+#endif /* S8GFX_STREAM_H */
diff --git a/iokit/Kernel/arm/s8gfx_tex.h b/iokit/Kernel/arm/s8gfx_tex.h
new file mode 100755
index 0000000..df0e032
--- /dev/null
+++ b/iokit/Kernel/arm/s8gfx_tex.h
@@ -0,0 +1,341 @@
+/*
+ * Texture sampler for the A11 (G10) AGX stand-in: integer-only (soft float of s8gfx_sf.h), no libc, builds into the kernel and the host test
+ * (tools/gpu-isa/tests/tex_test.c). Analysis and evidence levels: tools/gpu-isa/analysis/texture-state.md.
+ *
+ *   s8t_desc_decode()    6-word texture state record (as pushed by the 0x17 push record) -> struct s8t_desc
+ *   s8t_sampler_decode() 2-word sampler state (as pushed by the 0x13 push record)        -> struct s8t_sampler
+ *   s8t_sample()         u, v (normalised, float bits) -> RGBA float bits, nearest or bilinear, level 0 only
+ *
+ * Verified on captured data: the texel address (word2 << 2 | bit 30 = VA bit 32), width / height fields of word0/word1 (capture9 4x4 and capture21: 153x64, 128x74,
+ * 696x437, 694x79, 1440x2960, 256x1, 128x1), Morton (y in the LOW bit) for the 4x4 test texture and linear tight packing for the BGRA8 widget, the format codes
+ * listed at s8t_desc_decode (RGBA8, BGRA8, R8 table, A8 masks, RGBA16F table), and the nearest / linear bit of the sampler word. Wrap modes, min/mag split, tiling
+ * of large Morton textures, mips and the stride word are NOT decoded; the struct fields can be filled in by hand (s8t_desc_make).
+ * Filtering model (assumption, no hardware oracle exists yet): coordinates and texel positions in 16.16 fixed point, bilinear weights truncated to
+ * 8 bits, the result sum(w * texel8) / (65536 * 255) rounded to nearest by the soft float divide.
+ */
+#ifndef S8GFX_TEX_H
+#define S8GFX_TEX_H
+
+#include "s8gfx_sf.h"
+
+enum { S8T_FMT_RGBA8 = 0, S8T_FMT_BGRA8 = 1, S8T_FMT_R8 = 2, S8T_FMT_A8 = 3, S8T_FMT_RGBA16F = 4, S8T_FMT_LA8 = 5 };
+/* A8: one byte per texel returned in the ALPHA channel (0,0,0,v): the compositor's 0x8002 glyph / mask textures. RGBA16F: 8 bytes per texel (the dither table, code 0x4642).
+ * LA8: 2 bytes per texel, returned as (L, L, L, A) (IOSurface LA08 icons, code 0x0142; byte order L then A is an assumption). */
+enum { S8T_LAYOUT_MORTON = 0, S8T_LAYOUT_LINEAR = 1 };
+enum { S8T_WRAP_CLAMP_EDGE = 0, S8T_WRAP_REPEAT = 1, S8T_WRAP_MIRROR = 2, S8T_WRAP_ZERO = 3 };
+
+struct s8t_desc {
+	uint64_t va;            /* address of level 0 */
+	uint32_t width, height; /* texels */
+	uint32_t levels;        /* mip levels (only level 0 is sampled) */
+	uint32_t fmt;           /* S8T_FMT_* */
+	uint32_t layout;        /* S8T_LAYOUT_* */
+	uint32_t pitch;         /* bytes per row, linear layout only */
+	int known;              /* 1 when the size/format came from a record the decoder recognises */
+};
+
+struct s8t_sampler {
+	int mag_linear;
+	int min_linear;
+	uint32_t wrap_s, wrap_t;        /* S8T_WRAP_* */
+};
+
+static inline uint32_t
+s8t_bpp(uint32_t fmt)
+{
+	return (fmt == S8T_FMT_R8 || fmt == S8T_FMT_A8) ? 1 : fmt == S8T_FMT_LA8 ? 2 : fmt == S8T_FMT_RGBA16F ? 8 : 4;
+}
+
+static inline void
+s8t_desc_make(struct s8t_desc * d, uint64_t va, uint32_t w, uint32_t h, uint32_t fmt, uint32_t layout, uint32_t pitch)
+{
+	d->va = va;
+	d->width = w;
+	d->height = h;
+	d->levels = 1;
+	d->fmt = fmt;
+	d->layout = layout;
+	d->pitch = pitch ? pitch : w * s8t_bpp(fmt);
+	d->known = 0;
+}
+
+/*
+ * Decode a texture state record (6 words; capture9 and the real compositor capture21 fix this layout, see analysis/texture-state.md sec. 9):
+ *   word0 bits 0-15  = type code: bit 3 = layout (1 Morton, 0 linear), (code & ~8) selects the format: 0x0502 RGBA8, 0x5982 BGRA8, 0x0002 R8, 0x8002 A8,
+ *                      0x4642 RGBA16F, 0x0142 LA8, 0x54c2 BGRA8 (the display surface); unlisted codes are taken as BGRA8 and known = 0
+ *   (word0 >> 27) | (word1 & 0x1ff) << 5   = width - 1   (14 bits)
+ *   (word1 >> 9) & 0x3fff                  = height - 1  (14 bits)
+ *   word2 = VA >> 2, bit 30 = VA bit 32;  word3 (stride-like, undecoded), word4/5 = end-of-pixels pointer (VA >> 4) and size of the lossless-compression metadata, ignored
+ * Linear textures are tightly packed here (pitch = width * bpp, verified on the 153x64 BGRA8 widget); the caller overrides pitch / size (s8t_desc_make) for passes' targets.
+ * Returns 0 when the record is recognised (word2 has VA bit 32 and (word0 & 7) == 2), -1 otherwise.
+ */
+static inline int
+s8t_desc_decode(struct s8t_desc * d, const uint32_t w[6])
+{
+	uint32_t code = w[0] & 0xffff;
+
+	d->va = ((uint64_t)(w[2] & 0x3fffffffu) << 2) | ((w[2] & 0x40000000u) ? 0x100000000ull : 0);
+	d->fmt = S8T_FMT_BGRA8;
+	d->layout = (code & 8) ? S8T_LAYOUT_MORTON : S8T_LAYOUT_LINEAR;
+	d->levels = 1;
+	d->known = 1;
+	switch (code & ~8u) {
+	case 0x0502: d->fmt = S8T_FMT_RGBA8; break;
+	case 0x5982: case 0x54c2: break;
+	case 0x0002: d->fmt = S8T_FMT_R8; break;
+	case 0x8002: d->fmt = S8T_FMT_A8; break;
+	case 0x4642: d->fmt = S8T_FMT_RGBA16F; break;
+	case 0x0142: d->fmt = S8T_FMT_LA8; break;
+	default: d->known = 0; break;
+	}
+	d->width = ((w[0] >> 27) | ((w[1] & 0x1ffu) << 5)) + 1;
+	d->height = ((w[1] >> 9) & 0x3fffu) + 1;
+	d->pitch = d->width * s8t_bpp(d->fmt);
+	return ((w[0] & 7) == 2 && (w[2] & 0x40000000u)) ? 0 : -1;
+}
+
+/* sampler state, two words. word0 bit 23 = linear (magnify), bit 25 = linear (minify): both set by filter::linear, both clear for nearest [verified as a pair]. Wrap modes: not decoded (clamp_to_edge). */
+static inline void
+s8t_sampler_decode(struct s8t_sampler * s, const uint32_t w[2])
+{
+	s->mag_linear = (w[0] >> 23) & 1;
+	s->min_linear = (w[0] >> 25) & 1;
+	s->wrap_s = s->wrap_t = S8T_WRAP_CLAMP_EDGE;
+}
+
+static inline uint32_t
+s8t_log2(uint32_t v)
+{
+	uint32_t k = 0;
+
+	while ((1u << k) < v && k < 31) {
+		k++;
+	}
+	return k;
+}
+
+/* byte offset of texel (x, y) from the level base */
+static inline uint64_t
+s8t_texel_offset(const struct s8t_desc * d, uint32_t x, uint32_t y)
+{
+	uint64_t idx;
+
+	if (d->layout == S8T_LAYOUT_LINEAR) {
+		return (uint64_t)y * d->pitch + (uint64_t)x * s8t_bpp(d->fmt);
+	}
+	/* Morton / twiddle, y in the LOW bit: interleave the low min(lw, lh) bits of y and x, the remaining bits of the longer side follow linearly */
+	{
+		uint32_t lw = s8t_log2(d->width), lh = s8t_log2(d->height);
+		uint32_t n = lw < lh ? lw : lh;
+		uint32_t b;
+
+		idx = 0;
+		for (b = 0; b < n; b++) {
+			idx |= (uint64_t)((y >> b) & 1) << (2 * b);
+			idx |= (uint64_t)((x >> b) & 1) << (2 * b + 1);
+		}
+		if (lw > lh) {
+			idx |= (uint64_t)(x >> n) << (2 * n);
+		} else if (lh > lw) {
+			idx |= (uint64_t)(y >> n) << (2 * n);
+		}
+	}
+	return idx * s8t_bpp(d->fmt);
+}
+
+/* apply a wrap mode to texel coordinate c in a dimension of n texels; returns -1 for "outside, transparent black" */
+static inline int32_t
+s8t_wrap(int32_t c, int32_t n, uint32_t mode)
+{
+	switch (mode) {
+	case S8T_WRAP_REPEAT:
+		c %= n;
+		return c < 0 ? c + n : c;
+	case S8T_WRAP_MIRROR: {
+		int32_t p = 2 * n;
+
+		c %= p;
+		if (c < 0) {
+			c += p;
+		}
+		return c < n ? c : p - 1 - c;
+	}
+	case S8T_WRAP_ZERO:
+		return (c < 0 || c >= n) ? -1 : c;
+	default:
+		return c < 0 ? 0 : (c >= n ? n - 1 : c);
+	}
+}
+
+/* the four channels of texel (x, y) as 8-bit values in RGBA order; outside (x or y < 0) = 0 */
+static inline void
+s8t_fetch(const struct s8t_desc * d, uint32_t (*rd)(void *, uint64_t va), void * ctx, int32_t x, int32_t y, uint32_t c[4])
+{
+	uint64_t a;
+	uint32_t v;
+
+	if (x < 0 || y < 0) {
+		c[0] = c[1] = c[2] = c[3] = 0;
+		return;
+	}
+	a = d->va + s8t_texel_offset(d, (uint32_t)x, (uint32_t)y);
+	v = rd(ctx, a & ~3ull);
+	if (d->fmt == S8T_FMT_A8) {
+		c[0] = c[1] = c[2] = 0;
+		c[3] = (v >> (8 * (a & 3))) & 0xff;
+	} else if (d->fmt == S8T_FMT_LA8) {
+		uint32_t h = (v >> (8 * (a & 3))) & 0xffff;
+
+		c[0] = c[1] = c[2] = h & 0xff;
+		c[3] = h >> 8;
+	} else if (d->fmt == S8T_FMT_R8) {
+		c[0] = (v >> (8 * (a & 3))) & 0xff;
+		c[1] = c[2] = 0;
+		c[3] = 255;
+	} else if (d->fmt == S8T_FMT_BGRA8) {
+		c[0] = (v >> 16) & 0xff;
+		c[1] = (v >> 8) & 0xff;
+		c[2] = v & 0xff;
+		c[3] = v >> 24;
+	} else {
+		c[0] = v & 0xff;
+		c[1] = (v >> 8) & 0xff;
+		c[2] = (v >> 16) & 0xff;
+		c[3] = v >> 24;
+	}
+}
+
+/* IEEE half -> float bits (denormal halves flush to zero like the soft float does) */
+static inline f32b
+s8t_half(uint32_t h)
+{
+	uint32_t s = (h >> 15) & 1, e = (h >> 10) & 31, m = h & 0x3ff;
+
+	if (e == 0) {
+		return s << 31;
+	}
+	if (e == 31) {
+		return (s << 31) | 0x7f800000u | (m << 13);
+	}
+	return (s << 31) | ((e + 112) << 23) | (m << 13);
+}
+
+/* RGBA16F texel (x, y) as float bits; outside (x or y < 0) = 0 */
+static inline void
+s8t_fetch_f(const struct s8t_desc * d, uint32_t (*rd)(void *, uint64_t va), void * ctx, int32_t x, int32_t y, f32b c[4])
+{
+	uint64_t a;
+	uint32_t lo, hi;
+
+	if (x < 0 || y < 0) {
+		c[0] = c[1] = c[2] = c[3] = 0;
+		return;
+	}
+	a = d->va + s8t_texel_offset(d, (uint32_t)x, (uint32_t)y);
+	lo = rd(ctx, a);
+	hi = rd(ctx, a + 4);
+	c[0] = s8t_half(lo & 0xffff);
+	c[1] = s8t_half(lo >> 16);
+	c[2] = s8t_half(hi & 0xffff);
+	c[3] = s8t_half(hi >> 16);
+}
+
+/* a * 2^16 as int32 (rounded to nearest at 2^-16, saturating); >> 16 of the result is the floor */
+static inline int32_t
+s8t_fix16_floor(f32b a)
+{
+	uint32_t e = (a >> 23) & 0xff;
+
+	if (e > 127 + 14) {                     /* |a| >= 2^15: far outside the texture, saturate */
+		return (a >> 31) ? INT32_MIN : INT32_MAX;
+	}
+	return sf_to_fixed(a, 16);
+}
+
+/*
+ * Sample level 0. u, v are normalised coordinates (float bits). out = R, G, B, A as float bits in [0, 1].
+ * Nearest: texel floor(u * w). Bilinear: position u * w - 0.5, 2x2 taps with 8-bit weights.
+ */
+static inline void
+s8t_sample(const struct s8t_desc * d, const struct s8t_sampler * s, f32b u, f32b v, uint32_t (*rd)(void *, uint64_t va), void * ctx, f32b out[4])
+{
+	int32_t W = (int32_t)d->width, H = (int32_t)d->height;
+	f32b fw = sf_from_i64(W), fh = sf_from_i64(H);
+	f32b half = 0x3f000000u;
+	f32b su = sf_mul(u, fw), sv = sf_mul(v, fh);        /* texel space */
+	int linear = s->mag_linear || s->min_linear;        /* level 0 only: magnification and minification are told apart by the LOD, which this stand-in does not compute */
+	uint32_t c[4];
+	int k;
+
+	if (W <= 0 || H <= 0) {
+		for (k = 0; k < 4; k++) {
+			out[k] = SF_ZERO;
+		}
+		return;
+	}
+	if (!linear) {
+		int32_t fx = s8t_fix16_floor(su), fy = s8t_fix16_floor(sv);
+		int32_t x = fx >> 16, y = fy >> 16;     /* arithmetic shift = floor */
+
+		if (d->fmt == S8T_FMT_RGBA16F) {
+			s8t_fetch_f(d, rd, ctx, s8t_wrap(x, W, s->wrap_s), s8t_wrap(y, H, s->wrap_t), out);
+			return;
+		}
+		s8t_fetch(d, rd, ctx, s8t_wrap(x, W, s->wrap_s), s8t_wrap(y, H, s->wrap_t), c);
+		for (k = 0; k < 4; k++) {
+			out[k] = sf_div(sf_from_i64(c[k]), 0x437f0000u);
+		}
+		return;
+	}
+	{
+		int32_t fx = s8t_fix16_floor(sf_sub(su, half)), fy = s8t_fix16_floor(sf_sub(sv, half));
+		int32_t x0 = fx >> 16, y0 = fy >> 16;
+		uint32_t wx = ((uint32_t)fx >> 8) & 0xff, wy = ((uint32_t)fy >> 8) & 0xff;   /* 8-bit weights, truncated */
+		uint32_t w00 = (256 - wx) * (256 - wy), w10 = wx * (256 - wy), w01 = (256 - wx) * wy, w11 = wx * wy;
+		uint32_t acc[4] = { 0, 0, 0, 0 };
+		uint32_t t[4];
+		int32_t xs[2], ys[2];
+		uint32_t wt[4];
+		int i;
+
+		xs[0] = s8t_wrap(x0, W, s->wrap_s);
+		xs[1] = s8t_wrap(x0 + 1, W, s->wrap_s);
+		ys[0] = s8t_wrap(y0, H, s->wrap_t);
+		ys[1] = s8t_wrap(y0 + 1, H, s->wrap_t);
+		wt[0] = w00; wt[1] = w10; wt[2] = w01; wt[3] = w11;
+		if (d->fmt == S8T_FMT_RGBA16F) {
+			f32b facc[4] = { 0, 0, 0, 0 }, tf[4];
+
+			for (i = 0; i < 4; i++) {
+				f32b wf;
+
+				if (wt[i] == 0) {
+					continue;
+				}
+				wf = sf_div(sf_from_i64(wt[i]), sf_from_i64(65536));
+				s8t_fetch_f(d, rd, ctx, xs[i & 1], ys[i >> 1], tf);
+				for (k = 0; k < 4; k++) {
+					facc[k] = sf_fma(tf[k], wf, facc[k]);
+				}
+			}
+			for (k = 0; k < 4; k++) {
+				out[k] = facc[k];
+			}
+			return;
+		}
+		for (i = 0; i < 4; i++) {
+			if (wt[i] == 0) {
+				continue;
+			}
+			s8t_fetch(d, rd, ctx, xs[i & 1], ys[i >> 1], t);
+			for (k = 0; k < 4; k++) {
+				acc[k] += t[k] * wt[i];
+			}
+		}
+		for (k = 0; k < 4; k++) {
+			out[k] = sf_div(sf_from_i64(acc[k]), sf_from_i64(65536 * 255ll));
+		}
+	}
+}
+
+#endif /* S8GFX_TEX_H */
