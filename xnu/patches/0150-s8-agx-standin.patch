+/*
+ * S8Agx: the kernel-side stand-in for Apple's GPU stack as iOS userland sees it (boot-arg s8agx=1, needs s8mali_drv=1).
+ *
+ * iOS 16's Metal / IOGPU userland does not talk to a generic GPU interface: it opens the IOKit service of class IOAccelerator
+ * (here AGXAcceleratorG10P_B0, the class the iPhone X's AGXG10P kext registers) and calls the selectors of
+ * IOGPUDeviceUserClient / AGXDeviceUserClient (analysis/agx-kernel-interface.md: tables decoded from the user's own IPSW).
+ * This file registers a service of the same classes and a user client with the same name, so that userland finds a GPU.
+ *
+ * STAGE A (this file): the user client answers every selector with success and zero-filled outputs of the sizes the caller
+ * declares, hands out zeroed memory for every shared-memory type, and LOGS what userland asks (the first calls with a hex dump
+ * of their input). That log tells what the userland driver needs next, until Metal creates its device; the Mali is not used yet.
+ *
+ * Copyright (c) 2000-2021 Apple Inc. All rights reserved.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ *
+ * This file contains Original Code and/or Modifications of Original Code
+ * as defined in and that are subject to the Apple Public Source License
+ * Version 2.0 (the 'License'). You may not use this file except in
+ * compliance with the License. The rights granted to you under the License
+ * may not be used to create, or enable the creation or redistribution of,
+ * unlawful or unlicensed copies of an Apple operating system, or to
+ * circumvent, violate, or enable the circumvention or violation of, any
+ * terms of an Apple operating system software license agreement.
+ *
+ * Please obtain a copy of the License at
+ * http://www.opensource.apple.com/apsl/ and read it before using this file.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+
+#define S8AGX_LOG_LIMIT 800
+
+static volatile SInt32 gAgxLogged;
+static volatile SInt32 gAgxSelCount[0x200];   /* calls seen per selector: only the first few of each are logged */
+
+extern "C" int proc_selfpid(void);
+extern "C" void proc_selfname(char * buf, int size);
+
+static bool
+agx_log_ok(void)
+{
+	return OSIncrementAtomic((SInt32 *)&gAgxLogged) < S8AGX_LOG_LIMIT;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+/* The IOKit base class Metal enumerates (IOServiceMatching("IOAccelerator")). */
+class IOAccelerator : public IOService
+{
+	OSDeclareDefaultStructors(IOAccelerator);
+};
+
+class AGXAccelerator : public IOAccelerator
+{
+	OSDeclareDefaultStructors(AGXAccelerator);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+class AGXAcceleratorG10P_B0 : public AGXAccelerator
+{
+	OSDeclareDefaultStructors(AGXAcceleratorG10P_B0);
+};
+
+OSDefineMetaClassAndStructors(IOAccelerator, IOService);
+OSDefineMetaClassAndStructors(AGXAccelerator, IOAccelerator);
+OSDefineMetaClassAndStructors(AGXAcceleratorG10P_B0, AGXAccelerator);
+
+bool
+AGXAccelerator::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AGXDeviceUserClient");
+	setProperty("IOClass", "AGXAcceleratorG10P_B0");
+	setProperty("IOGLBundleName", "AGXGL");
+	setProperty("MetalPluginName", "AGXMetalA11");
+	setProperty("MetalPluginClassName", "AGXA11FamilyDevice");
+	setName("AGXAcceleratorG10P_B0");
+	registerService();
+	return true;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class AGXDeviceUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AGXDeviceUserClient);
+
+	UInt32 fType;
+	task_t fTask;
+
+public:
+	virtual bool initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn registerNotificationPort(mach_port_t port, UInt32 type, UInt32 refCon) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AGXDeviceUserClient, IOUserClient);
+
+bool
+AGXDeviceUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fType = type;
+	fTask = owningTask;
+	if (agx_log_ok()) {
+		char name[32] = "?";
+
+		proc_selfname(name, sizeof(name));
+		IOLog("S8AGX: user client opened, type %u by %s[%d]\n", (unsigned)type, name, proc_selfpid());
+	}
+	return true;
+}
+
+IOReturn
+AGXDeviceUserClient::clientClose(void)
+{
+	if (agx_log_ok()) {
+		IOLog("S8AGX: user client closed, type %u\n", (unsigned)fType);
+	}
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AGXDeviceUserClient::registerNotificationPort(mach_port_t port, UInt32 type, UInt32 refCon)
+{
+	if (agx_log_ok()) {
+		IOLog("S8AGX: registerNotificationPort port 0x%x type %u refCon 0x%x\n", (unsigned)port, (unsigned)type, (unsigned)refCon);
+	}
+	return kIOReturnSuccess;
+}
+
+/* Stage A: every shared-memory type is a zeroed 64 KiB buffer, so the userland mapping succeeds and the next call shows up. */
+IOReturn
+AGXDeviceUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory)
+{
+	IOBufferMemoryDescriptor * buf;
+
+	buf = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared, 0x10000, 0x4000);
+	if (agx_log_ok()) {
+		IOLog("S8AGX: clientMemoryForType %u -> %s (64 KiB zeroed)\n", (unsigned)type, buf ? "ok" : "no memory");
+	}
+	if (buf == NULL) {
+		return kIOReturnNoMemory;
+	}
+	bzero(buf->getBytesNoCopy(), 0x10000);
+	*options = 0;
+	*memory = buf;           /* the caller releases it */
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AGXDeviceUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	(void)dispatch;
+	(void)target;
+	(void)reference;
+	if (args == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (selector >= 0x200 || OSIncrementAtomic((SInt32 *)&gAgxSelCount[selector]) < 8) {
+		char name[32] = "?";
+
+		proc_selfname(name, sizeof(name));
+		IOLog("S8AGX: [%s %d] sel 0x%x scalarIn %u structIn %u (desc %s) scalarOut %u structOut %u (desc %s) async %s\n", name, proc_selfpid(), selector,
+		    args->scalarInputCount, args->structureInputSize, args->structureInputDescriptor ? "yes" : "no",
+		    args->scalarOutputCount, args->structureOutputSize, args->structureOutputDescriptor ? "yes" : "no",
+		    args->asyncWakePort ? "yes" : "no");
+		for (uint32_t i = 0; i < args->scalarInputCount && i < 6; i++) {
+			IOLog("S8AGX:    scalar[%u] = 0x%llx\n", i, args->scalarInput[i]);
+		}
+		if (args->structureInput != NULL && args->structureInputSize != 0) {
+			const uint8_t * p = (const uint8_t *)args->structureInput;
+			uint32_t n = args->structureInputSize < 48 ? args->structureInputSize : 48;
+			char hex[48 * 2 + 1];
+
+			for (uint32_t i = 0; i < n; i++) {
+				snprintf(hex + 2 * i, 3, "%02x", p[i]);
+			}
+			IOLog("S8AGX:    struct[%u] = %s\n", args->structureInputSize, hex);
+		}
+	}
+	if (args->scalarOutput != NULL) {
+		bzero(args->scalarOutput, args->scalarOutputCount * sizeof(uint64_t));
+	}
+	if (args->structureOutput != NULL && args->structureOutputSize != 0) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+extern "C" void S8AgxStart(void);
+
+extern "C" void
+S8AgxStart(void)
+{
+	uint32_t on = 0;
+	IOService * provider = NULL;
+	AGXAcceleratorG10P_B0 * gpu;
+
+	if (!PE_parse_boot_argn("s8agx", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	for (int i = 0; i < 600 && (provider = IOService::getPlatform()) == NULL; i++) {
+		IOSleep(100);
+	}
+	gpu = OSTypeAlloc(AGXAcceleratorG10P_B0);
+	if (gpu == NULL || provider == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
+		IOLog("S8AGX: cannot create the service\n");
+		return;
+	}
+	if (!gpu->start(provider)) {
+		gpu->detach(provider);
+		IOLog("S8AGX: the service did not start\n");
+	} else {
+		IOLog("S8AGX: service AGXAcceleratorG10P_B0 (IOAccelerator) registered\n");
+	}
+	gpu->release();
+}
+
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
