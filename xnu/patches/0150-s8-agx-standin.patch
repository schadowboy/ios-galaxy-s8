+			c->sel_d = (b[1] >> 3) & (S8F_REGS - 1);
+			c->sel_c = c->r[((b[2] & 0x3f) >> 1) & (S8F_REGS - 1)] != 0;
+		}
+		s8f_assume(c, op);
+		return n;
+	case 0x23: case 0x60:
+		goto sel_partner;
+	case 0x20:
+		if (b[1] == 0xc0) {
+			s8f_assume(c, op);                      /* 20 c0 <imm32> literal word */
+			return n;
+		}
+	sel_partner: {
+		if (c->sel_pending) {
+			uint32_t x = (b[1] >> 6) ? c->r[((b[1] & 0x3f) >> 1) & (S8F_REGS - 1)] : b[1];
+			uint32_t y = (b[2] >> 6) ? c->r[((b[2] & 0x3f) >> 1) & (S8F_REGS - 1)] : b[2];
