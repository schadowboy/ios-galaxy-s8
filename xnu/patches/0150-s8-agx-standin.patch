+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class AGXDeviceUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AGXDeviceUserClient);
+
+	UInt32 fType;
+	task_t fTask;
+	/* shared memory the kernel gave this client (selector 0xd): kernel buffer + its mapping in the client's task */
+	enum { kShmemMax = 512 };
+	IOBufferMemoryDescriptor ** fShmemBuf;       /* kShmemMax entries, allocated in initWithTask (the object itself may be at most 16 KiB) */
+	IOMemoryMap ** fShmemMap;
+	uint8_t ** fShadow;                         /* per shmem region: copy at its last dump (dumps print only changed lines) */
+	uint32_t * fShadowLen;
+	uint32_t * fResShm;                         /* resource id n -> shmem region index (0xffffffff: caller memory) */
+	uint8_t * fShmemType;                       /* IOGPU shmem type of region i (0xff: a plain mapping) */
+	uint32_t fDumpLines;                        /* lines printed by the current dump (budget: the log ring is finite) */
+	uint32_t fSubmitDumps;                      /* command-list dumps done so far (the first few submits are dumped) */
+	UInt32 fShmemCount;
+
+	UInt32 fQueueId;                /* last command queue id handed out (selector 7) */
+	UInt32 fNqId;                   /* last notification queue id handed out (selector 15) */
+	UInt32 fResId;                  /* last resource id handed out (selector 9) */
+	uint64_t fTraceNext;            /* next global trace id range (selector 5) */
+	enum { kNqMax = 32 };
+	IOSharedDataQueue * fNq[kNqMax];        /* notification queue n (id n) at [n - 1]: completion notifications for userland */
+	IOMemoryMap * fNqMap[kNqMax];           /* its mapping in the client's task */
+	uint32_t fCqNq[kNqMax];                 /* command queue id n -> notification queue id (selector 0x19) */
+	bool fNqPortSet[kNqMax];                /* a notification port was registered for queue n */
+	uint32_t fCompletionLogs;
+
+	bool postCompletion(uint32_t cmdQueue, uint64_t cookie, uint64_t t1, uint64_t t2, uint32_t status);
+	uint32_t * fSelCount;           /* 0x200 entries: calls per selector of THIS client (the log shows the first few of each) */
+	enum { kResMax = 1024 };
+	uint64_t * fResVa;                /* kResMax entries: GPU virtual address of resource id n at [n - 1] */
+	uint64_t fGpuVa;                /* next GPU virtual address to give a resource (0 = not started) */
+	enum { kSurfMax = 32 };
+	uint64_t fSurfVa[kSurfMax];     /* GPU VA of IOSurface-backed resources (flags & 0x82 == 0x82), the id is the surface id of the display path */
+	uint32_t fSurfId[kSurfMax];
+	uint32_t fSurfN;
+	void fillSurfaceTargets(uint32_t pixel);
+	/* resources that are not kernel shared memory: IOSurface-backed (uptr = surface id) or the caller's own memory (uptr = user VA) */
+	enum { kVmMax = 192 };
+	struct agx_vm { uint64_t va, len, uptr; uint32_t surf, id; IOMemoryMap * map; };
+	struct agx_vm fVm[kVmMax];
+	uint32_t fVmN;
+	bool resolveVa(uint64_t va, uint8_t ** mem, uint64_t * avail);
+	static int streamRd(void * ctx, uint64_t va, uint32_t * out);
+	void logCompositor(void);
+	void execComposite(void);
+	bool compVertex(struct s8f_ctx & c, uint32_t vid, const uint8_t * code, unsigned codelen, const uint32_t * uni, const uint32_t * vp, struct s8r_vtx * out, uint32_t * nvar);
+	void bindUniforms(const struct s8s_prog * pg, uint32_t * uni);
+	bool fSurfDone[kSurfMax];       /* the first-use background fill of this surface was done */
+
+	IOReturn createShmem(IOExternalMethodArguments * args);
+	void executePasses(void);
+	bool findResMem(uint64_t va, uint8_t ** mem, uint64_t * avail);
+	bool findResRegion(uint64_t va, const uint8_t ** base, uint64_t * off, uint64_t * len);
+	uint32_t progHash(uint64_t va);
+	void logPrograms(void);
+	static uint32_t agxRd(void * ctx, uint64_t va);
+	void executeDraws(uint32_t * target, uint64_t npx, uint64_t vtxVa, uint64_t vbVa, const uint32_t * vp, uint64_t fragVa, const uint32_t * dr, int ndraws,
+	    const uint32_t * uni);
+	void dumpSparse(const char * what, uint32_t region, uint32_t id, uint32_t type, uint64_t va, const uint8_t * m, size_t len);
+	IOReturn allocShmem(uint64_t size, uint64_t * userAddress);
+	void releaseShmem(void);
+
+public:
+	virtual bool initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn registerNotificationPort(mach_port_t port, UInt32 type, UInt32 refCon) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AGXDeviceUserClient, IOUserClient);
+
+bool
+AGXDeviceUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fType = type;
+	fTask = owningTask;
+	fGpuVa = 0x100000000ULL;
+	fTraceNext = 1;
+	fShmemBuf = IONewZero(IOBufferMemoryDescriptor *, kShmemMax);
+	fShmemMap = IONewZero(IOMemoryMap *, kShmemMax);
+	fResVa = IONewZero(uint64_t, kResMax);
+	fShmemType = IONewZero(uint8_t, kShmemMax);
+	fResShm = IONewZero(uint32_t, kResMax);
+	fShadow = IONewZero(uint8_t *, kShmemMax);
+	fShadowLen = IONewZero(uint32_t, kShmemMax);
+	if (fResShm != NULL) {
+		memset(fResShm, 0xff, kResMax * sizeof(uint32_t));
+	}
+	fSelCount = IONewZero(uint32_t, 0x200);
+	if (fShmemBuf == NULL || fShmemMap == NULL || fResVa == NULL || fSelCount == NULL || fShmemType == NULL || fResShm == NULL || fShadow == NULL || fShadowLen == NULL) {
+		return false;
+	}
+	if (agx_log_ok()) {
+		char name[32] = "?";
+
+		proc_selfname(name, sizeof(name));
+		IOLog("S8AGX: user client opened, type %u by %s[%d]\n", (unsigned)type, name, proc_selfpid());
+	}
+	return true;
+}
+
+void
+AGXDeviceUserClient::releaseShmem(void)
+{
+	for (UInt32 i = 0; i < fShmemCount && i < kShmemMax; i++) {
+		if (fShmemMap[i] != NULL) {
+			fShmemMap[i]->release();
+			fShmemMap[i] = NULL;
+		}
+		if (fShmemBuf[i] != NULL) {
+			fShmemBuf[i]->release();
+			fShmemBuf[i] = NULL;
+		}
+	}
+	fShmemCount = 0;
+}
+
+/* Zeroed kernel memory mapped into the client's task, kept until the client closes. */
+IOReturn
+AGXDeviceUserClient::allocShmem(uint64_t size, uint64_t * userAddress)
+{
+	IOBufferMemoryDescriptor * buf;
+	IOMemoryMap * map;
+
+	if (size == 0 || size > (64ULL << 20) || fShmemCount >= kShmemMax) {
+		return kIOReturnNoResources;
+	}
+	size = (size + 0x3fffULL) & ~0x3fffULL;
+	buf = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, (vm_size_t)size, 0x4000);
+	if (buf == NULL) {
+		return kIOReturnNoMemory;
+	}
+	bzero(buf->getBytesNoCopy(), (size_t)size);
+	map = buf->createMappingInTask(fTask, 0, kIOMapAnywhere);
+	if (map == NULL) {
+		buf->release();
+		return kIOReturnVMError;
+	}
+	fShmemBuf[fShmemCount] = buf;
+	fShmemMap[fShmemCount] = map;
+	fShmemType[fShmemCount] = 0xff;
+	fShmemCount++;
+	*userAddress = (uint64_t)map->getVirtualAddress();
+	return kIOReturnSuccess;
+}
+
+/*
+ * Selector 13 (IOGPUDeviceCreateDeviceShmem in IOGPU): scalars { size, type }, 16 bytes out = { user address (u64), size (u32), id (u32) }.
+ * The kernel allocates zeroed memory and maps it into the calling task; userland keeps it for the device's lifetime.
+ */
+IOReturn
+AGXDeviceUserClient::createShmem(IOExternalMethodArguments * args)
+{
+	uint64_t size;
+	uint64_t type;
+	IOBufferMemoryDescriptor * buf;
+	IOMemoryMap * map;
+	uint8_t * out;
+
+	if (args->scalarInputCount < 2 || args->structureOutput == NULL || args->structureOutputSize < 16) {
+		return kIOReturnBadArgument;
+	}
+	size = args->scalarInput[0] & 0xffffffffULL;
+	type = args->scalarInput[1] & 0xffffffffULL;
+	if (size == 0 || size > (64ULL << 20) || fShmemCount >= kShmemMax) {
+		IOLog("S8AGX: shmem request refused: size 0x%llx type %llu (have %u)\n", size, type, (unsigned)fShmemCount);
+		return kIOReturnNoResources;
+	}
+	size = (size + 0x3fffULL) & ~0x3fffULL;
+	buf = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, (vm_size_t)size, 0x4000);
+	if (buf == NULL) {
+		return kIOReturnNoMemory;
+	}
+	bzero(buf->getBytesNoCopy(), (size_t)size);
+	map = buf->createMappingInTask(fTask, 0, kIOMapAnywhere);
+	if (map == NULL) {
+		buf->release();
+		IOLog("S8AGX: shmem mapping into the client failed (size 0x%llx type %llu)\n", size, type);
+		return kIOReturnVMError;
+	}
+	fShmemBuf[fShmemCount] = buf;
+	fShmemMap[fShmemCount] = map;
+	fShmemType[fShmemCount] = (uint8_t)type;
+	fShmemCount++;
+	out = (uint8_t *)args->structureOutput;
+	bzero(out, args->structureOutputSize);
+	*(uint64_t *)out = (uint64_t)map->getVirtualAddress();
+	*(uint32_t *)(out + 8) = (uint32_t)size;
+	*(uint32_t *)(out + 12) = fShmemCount;
+	IOLog("S8AGX: shmem #%u type %llu size 0x%llx -> user address 0x%llx\n", (unsigned)fShmemCount, type, size,
+	    (unsigned long long)map->getVirtualAddress());
+	return kIOReturnSuccess;
+}
+
+void
+AGXDeviceUserClient::free(void)
+{
+	for (uint32_t i = 0; i < kNqMax; i++) {
+		if (fNqMap[i] != NULL) {
+			fNqMap[i]->release();
+			fNqMap[i] = NULL;
+		}
+		if (fNq[i] != NULL) {
+			fNq[i]->setNotificationPort(MACH_PORT_NULL);
+			fNq[i]->release();
+			fNq[i] = NULL;
+		}
+	}
+	if (fShmemBuf != NULL) {
+		releaseShmem();
+	}
+	if (fShmemBuf != NULL) {
+		IODelete(fShmemBuf, IOBufferMemoryDescriptor *, kShmemMax);
+		fShmemBuf = NULL;
+	}
+	if (fShmemMap != NULL) {
+		IODelete(fShmemMap, IOMemoryMap *, kShmemMax);
+		fShmemMap = NULL;
+	}
+	for (uint32_t k = 0; k < fVmN && k < kVmMax; k++) {
+		if (fVm[k].map != NULL) {
+			fVm[k].map->release();
+			fVm[k].map = NULL;
+		}
+	}
+	if (fResVa != NULL) {
+		IODelete(fResVa, uint64_t, kResMax);
+		fResVa = NULL;
+	}
+	if (fSelCount != NULL) {
+		IODelete(fSelCount, uint32_t, 0x200);
+		fSelCount = NULL;
+	}
+	if (fShmemType != NULL) {
+		IODelete(fShmemType, uint8_t, kShmemMax);
+		fShmemType = NULL;
+	}
+	if (fResShm != NULL) {
+		IODelete(fResShm, uint32_t, kResMax);
+		fResShm = NULL;
+	}
+	if (fShadow != NULL) {
+		for (uint32_t i = 0; i < kShmemMax; i++) {
+			if (fShadow[i] != NULL) {
+				IOFree(fShadow[i], fShadowLen[i]);
+			}
+		}
+		IODelete(fShadow, uint8_t *, kShmemMax);
+		fShadow = NULL;
+	}
+	if (fShadowLen != NULL) {
+		IODelete(fShadowLen, uint32_t, kShmemMax);
+		fShadowLen = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+AGXDeviceUserClient::clientClose(void)
+{
+	if (agx_log_ok()) {
+		IOLog("S8AGX: user client closed, type %u\n", (unsigned)fType);
+	}
+	releaseShmem();
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AGXDeviceUserClient::registerNotificationPort(mach_port_t port, UInt32 type, UInt32 refCon)
+{
+	if (agx_log_ok()) {
+		IOLog("S8AGX: registerNotificationPort port %p type %u refCon 0x%x\n", (void *)port,(unsigned)type, (unsigned)refCon);
+	}
+	if (type == 0 && refCon >= 1 && refCon <= kNqMax && fNq[refCon - 1] != NULL) {
+		fNq[refCon - 1]->setNotificationPort(port);    /* the queue's data-available messages go to this port */
+		fNqPortSet[refCon - 1] = true;
+	}
+	return kIOReturnSuccess;
+}
+
+/*
+ * Sparse dump for offline analysis. Header "S8AGX: D <session> <what> <id> type <t> va <va> len <len>", then "S8AGX: L <offset> <64 bytes hex>"
+ * per 64-byte line that is non-zero and CHANGED since the last dump of the same region (the first dump of a region prints every non-zero line).
+ */
+void
+AGXDeviceUserClient::dumpSparse(const char * what, uint32_t region, uint32_t id, uint32_t type, uint64_t va, const uint8_t * m, size_t len)
+{
+	uint32_t lines = 0;
+	uint8_t * shadow;
+
+	if (fDumpLines >= 9000 || fShadow == NULL || region >= kShmemMax) {
+		return;
+	}
+	shadow = fShadow[region];
+	if (shadow == NULL) {
+		shadow = (uint8_t *)IOMallocZero(len);
+		if (shadow == NULL) {
+			return;
+		}
+		fShadow[region] = shadow;
+		fShadowLen[region] = (uint32_t)len;
+		IOLog("S8AGX: D %u %s %u type %u va 0x%llx len 0x%zx\n", (unsigned)fSubmitDumps, what, (unsigned)id, (unsigned)type, (unsigned long long)va, len);
+	} else if (fShadowLen[region] != (uint32_t)len) {
+		return;
+	} else {
+		bool changed = false;
+
+		for (size_t k = 0; k + 64 <= len && !changed; k += 64) {
+			changed = memcmp(m + k, shadow + k, 64) != 0;
+		}
+		if (!changed) {
+			return;
+		}
+		IOLog("S8AGX: D %u %s %u type %u va 0x%llx len 0x%zx\n", (unsigned)fSubmitDumps, what, (unsigned)id, (unsigned)type, (unsigned long long)va, len);
+	}
+	for (size_t k = 0; k + 64 <= len && lines < 1100; k += 64) {
+		bool nz = false;
+		char hex[64 * 2 + 1];
+
+		if (memcmp(m + k, shadow + k, 64) == 0) {
+			continue;
+		}
+		for (size_t b = 0; b < 64; b++) {
+			if (m[k + b] != 0) {
+				nz = true;
+				break;
+			}
+		}
+		memcpy(shadow + k, m + k, 64);
+		if (!nz) {
+			continue;
+		}
+		for (size_t b = 0; b < 64; b++) {
+			snprintf(hex + 2 * b, 3, "%02x", m[k + b]);
+		}
+		fDumpLines++;
+		IOLog("S8AGX: L %zx %s\n", k, hex);
+		lines++;
+	}
+}
+
+/*
+ * MILESTONE 1 executor (software, in the kernel, the first real pixels of the AGX stand-in; analysis/agx-kernel-interface.md 17f):
+ * for a submit of the process named by boot-arg s8agxexec (default s8mtl_test) find the render pass descriptors in the resources the process
+ * created, clear their render target, and run the user fragment program when it is a constant-colour one (immediate loads + tile store).
+ * No floating point in the kernel: floats are handled as bit patterns.
+ */
+static char gExecName[32] = "s8mtl_test";
+static char gExecName2[32] = "";                /* boot-arg s8agxexec2=<process prefix>: a second process whose submits are executed (SpringBoard) */
+static char gProgName[32] = "";                 /* boot-arg s8agxprogs=<process prefix>: log the bytes of every new shader that process submits */
+
+/* float bits -> 8-bit unorm, round half up, integer arithmetic only */
+static uint8_t
+agx_f32_unorm8(uint32_t b)
+{
+	uint32_t e = (b >> 23) & 0xff;
+	uint64_t mant;
+	uint32_t shift;
+	uint64_t r;
+
+	if (b >> 31) {
+		return 0;                       /* negative */
+	}
+	if (e == 0xff) {
+		return (b & 0x7fffff) ? 0 : 255;        /* NaN, +inf */
+	}
+	if (e >= 127) {
+		return 255;                     /* >= 1.0 */
+	}
+	if (e == 0) {
+		return 0;
+	}
+	mant = (b & 0x7fffff) | 0x800000;
+	shift = 23 + (127 - e);
+	if (shift >= 62) {
+		return 0;
+	}
+	r = (mant * 255 + (1ULL << (shift - 1))) >> shift;
+	return r > 255 ? 255 : (uint8_t)r;
+}
+
+bool
+AGXDeviceUserClient::findResMem(uint64_t va, uint8_t ** mem, uint64_t * avail)
+{
+	for (uint32_t n = 1; n <= fResId && n <= kResMax; n++) {
+		uint32_t r = fResShm[n - 1];
+
+		if (r != 0xffffffffu && r < fShmemCount && fShmemBuf[r] != NULL) {
+			uint64_t base = fResVa[n - 1], len = fShmemBuf[r]->getLength();
+
+			if (va >= base && va < base + len) {
+				*mem = (uint8_t *)fShmemBuf[r]->getBytesNoCopy() + (va - base);
+				*avail = base + len - va;
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+/* the resource containing va: its base pointer, the offset of va inside it and its length */
+bool
+AGXDeviceUserClient::findResRegion(uint64_t va, const uint8_t ** base, uint64_t * off, uint64_t * len)
+{
+	for (uint32_t n = 1; n <= fResId && n <= kResMax; n++) {
+		uint32_t r = fResShm[n - 1];
+
+		if (r != 0xffffffffu && r < fShmemCount && fShmemBuf[r] != NULL) {
+			uint64_t b = fResVa[n - 1], l = fShmemBuf[r]->getLength();
+
+			if (va >= b && va < b + l) {
+				*base = (const uint8_t *)fShmemBuf[r]->getBytesNoCopy();
+				*off = va - b;
+				*len = l;
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+/* FNV-1a over the first 0x10 bytes at a program address: the compiler reuses addresses, so a changed program at the same pointer must still count as changed */
+uint32_t
+AGXDeviceUserClient::progHash(uint64_t va)
+{
+	const uint8_t * base;
+	uint64_t off, len;
+	uint32_t h = 2166136261u;
+
+	if (!findResRegion(va, &base, &off, &len)) {
+		return 0;
+	}
+	for (uint64_t k = 0; k < 0x10 && off + k < len; k++) {   /* only the first bytes: programs are packed back to back, a longer window reads the neighbours */
+		h = (h ^ base[off + k]) * 16777619u;
+	}
+	return h;
+}
+
+/*
+ * Old state records stay in memory after a pipeline change, so "the last one in memory" is often stale. Remember what every record slot held at the
+ * previous scan: a slot whose program pointer changed is the pipeline the caller just set; with no change the previous choice stays.
+ */
+struct agx_seen { uint32_t n, kind, val; uint64_t i; };
+static struct agx_seen gSeenRec[128];
+static int gNSeenRec;
+static uint64_t gLastVtx, gLastFrag, gLastIdx;
+static uint32_t gLastRes;
+
+static bool
+agx_rec_changed(uint32_t n, uint64_t i, uint32_t kind, uint32_t val)
+{
+	for (int k = 0; k < gNSeenRec; k++) {
+		if (gSeenRec[k].n == n && gSeenRec[k].i == i && gSeenRec[k].kind == kind) {
+			if (gSeenRec[k].val == val) {
+				return false;
+			}
+			gSeenRec[k].val = val;
+			return true;
+		}
+	}
+	if (gNSeenRec < 128) {
+		gSeenRec[gNSeenRec].n = n;
+		gSeenRec[gNSeenRec].i = i;
+		gSeenRec[gNSeenRec].kind = kind;
+		gSeenRec[gNSeenRec].val = val;
+		gNSeenRec++;
+	}
+	return true;
+}
+
+/* per-pixel callback of the rasteriser: run the fragment program on the interpolated varyings and store the colour (BGRA8) */
+struct agx_draw_ctx {
+	const uint8_t * frag;
+	uint32_t fraglen;
+	uint32_t * target;
+	int w;
+	uint32_t pixels;
+	uint32_t unknown;
+};
+
+static void
+agx_emit_pixel(void * vctx, int px, int py, const f32b * v)
+{
+	struct agx_draw_ctx * dc = (struct agx_draw_ctx *)vctx;
+	struct s8f_ctx fc;
+
+	bzero(&fc, sizeof(fc));
+	fc.varying = v;
+	fc.tile = dc->target[py * dc->w + px];          /* ld_tile reads the destination pixel (blending) */
+	fc.has_tile = 1;
+	if (s8f_run(&fc, dc->frag, dc->fraglen) && fc.stored) {
+		dc->target[py * dc->w + px] = (uint32_t)sf_to_unorm8(fc.out[2]) | ((uint32_t)sf_to_unorm8(fc.out[1]) << 8) |
+		    ((uint32_t)sf_to_unorm8(fc.out[0]) << 16) | ((uint32_t)sf_to_unorm8(fc.out[3]) << 24);
+		dc->pixels++;
+	} else if (fc.unknown != 0) {
+		dc->unknown = fc.unknown;
+	}
+}
+
+uint32_t
+AGXDeviceUserClient::agxRd(void * ctx, uint64_t va)
+{
+	AGXDeviceUserClient * self = (AGXDeviceUserClient *)ctx;
+	uint8_t * p;
+	uint64_t avail;
+
+	if (self->resolveVa(va, &p, &avail) && avail >= 4) {
+		return *(const uint32_t *)p;
+	}
+	return 0;
+}
+
+/* GPU VA -> kernel pointer: shared-memory resources first, then IOSurface-backed and caller-memory resources (mapped on first use) */
+bool
+AGXDeviceUserClient::resolveVa(uint64_t va, uint8_t ** mem, uint64_t * avail)
+{
+	if (findResMem(va, mem, avail)) {
+		return true;
+	}
+	for (uint32_t k = 0; k < fVmN && k < kVmMax; k++) {
+		struct agx_vm * v = &fVm[k];
+
+		if (va < v->va || va >= v->va + v->len) {
+			continue;
+		}
+		uint64_t off = va - v->va;
+
+		if (v->surf != 0) {
+			SweetSurface * ss = sweet_surface_copy(v->surf);
+			uintptr_t ka = ss ? ss->kernelAddress() : 0;
+			uint64_t sl = ss ? (uint64_t)ss->allocSize : 0;
+
+			if (ss != NULL) {
+				ss->release();
+			}
+			if (ka == 0 || off >= sl) {
+				return false;
+			}
+			*mem = (uint8_t *)ka + off;
+			*avail = sl - off;
+			return true;
+		}
+		if (v->map == NULL && v->uptr != 0 && fTask != NULL) {
+			IOMemoryDescriptor * md = IOMemoryDescriptor::withAddressRange(v->uptr, v->len, kIODirectionInOut, fTask);
+
+			if (md != NULL) {
+				if (md->prepare() == kIOReturnSuccess) {
+					v->map = md->map(kIOMapAnywhere);
+				}
+				md->release();      /* the map keeps the descriptor alive */
+			}
+		}
+		if (v->map == NULL) {
+			return false;
+		}
+		*mem = (uint8_t *)v->map->getVirtualAddress() + off;
+		*avail = v->len - off;
+		return true;
+	}
+	return false;
+}
+
+int
+AGXDeviceUserClient::streamRd(void * ctx, uint64_t va, uint32_t * out)
+{
+	AGXDeviceUserClient * self = (AGXDeviceUserClient *)ctx;
+	uint8_t * p;
+	uint64_t avail;
+
+	if (self->resolveVa(va, &p, &avail) && avail >= 4) {
+		*out = *(const uint32_t *)p;
+		return 1;
+	}
+	*out = 0;
+	return 0;
+}
+
+static uint32_t gDrawPx = 800000;               /* boot-arg s8agxdrawpx: shaded-pixel cap per draw */
+static uint32_t gPxBudget = 1500000;           /* boot-arg s8agxpx: fragment invocations per submit (software shading is slow) */
+
+/* Dump a window of a program region around an entry point as an extra capture region (same "D"/"L" line format as dumpSparse; id 9000+): a host renderer
+ * then replays the draws with the very programs this boot compiled. Each entry address is dumped once. */
+static bool
+comp_dump_window(uint32_t session, uint64_t entryVa, const uint8_t * base, uint64_t off, uint64_t len, uint64_t before, uint64_t after)
+{
+	static uint64_t done[256];
+	static int ndone;
+	uint64_t from = off > before ? off - before : 0, to = off + after < len ? off + after : len;
+	uint64_t baseVa = entryVa - off;
+
+	for (int k = 0; k < ndone; k++) {
+		if (done[k] == entryVa) {
+			return false;
+		}
+	}
+	if (ndone >= 256 || to <= from) {
+		return false;
+	}
+	done[ndone] = entryVa;
+	IOLog("S8AGX: D %u res %u type 7 va 0x%llx len 0x%llx\n", (unsigned)session, (unsigned)(9000 + ndone), (unsigned long long)(baseVa + (from & ~63ULL)),
+	    (unsigned long long)(((to + 63) & ~63ULL) - (from & ~63ULL)));
+	ndone++;
+	for (uint64_t k = from & ~63ULL; k + 64 <= len && k < to; k += 64) {
+		bool nz = false;
+		char hex[64 * 2 + 1];
+
+		for (int b = 0; b < 64; b++) {
+			if (base[k + b] != 0) {
+				nz = true;
+			}
+			hex[b * 2] = "0123456789abcdef"[base[k + b] >> 4];
+			hex[b * 2 + 1] = "0123456789abcdef"[base[k + b] & 15];
+		}
+		hex[128] = 0;
+		if (nz) {
+			IOLog("S8AGX: L %llx %s\n", (unsigned long long)(k - (from & ~63ULL)), hex);
+		}
+	}
+	return true;
+}
+
+/* log each distinct draw (programs + extent + texture count) once: the same frame repeats for minutes */
+static bool
+comp_new_draw(uint64_t key)
+{
+	static uint64_t seen[512];
+	static int nseen;
+
+	for (int k = 0; k < nseen; k++) {
+		if (seen[k] == key) {
+			return false;
+		}
+	}
+	if (nseen < 512) {
+		seen[nseen++] = key;
+	}
+	return true;
+}
+
+/* uniform-push records of a pipeline slot fill the uniform file: address, size in halves (0 = 32), destination half index */
+void
+AGXDeviceUserClient::bindUniforms(const struct s8s_prog * pg, uint32_t * uni)
+{
+	for (uint32_t k = 0; k < pg->npush; k++) {
+		const struct s8s_push * pu = &pg->push[k];
+
+		if (pu->type != 0x03 && pu->type != 0x33) {
+			continue;
+		}
+		uint32_t halves = pu->halves ? pu->halves : 32;
+
+		for (uint32_t j = 0; j < halves / 2 && pu->dest + 2 * j < S8F_NUNI; j++) {
+			uni[pu->dest + 2 * j] = agxRd(this, pu->va + 4 * j);
+		}
+	}
+}
+
+/* run the vertex program for one vertex id and apply the viewport transform; false when it fails or exports no position */
+bool
+AGXDeviceUserClient::compVertex(struct s8f_ctx & c, uint32_t vid, const uint8_t * code, unsigned codelen, const uint32_t * uni, const uint32_t * vp, struct s8r_vtx * out,
+    uint32_t * nvar)
+{
+	bzero(&c, sizeof(c));
+	memcpy(c.uni, uni, sizeof(c.uni));
+	c.rd = agxRd;
+	c.rdctx = this;
+	c.vid = vid;
+	if (!s8f_run(&c, code, codelen) || (c.expmask & 0xf) != 0xf) {
+		return false;
+	}
+	f32b iw = sf_div(SF_ONE, c.exp[3]);
+
+	out->x = sf_fma(vp[1], sf_mul(c.exp[0], iw), vp[0]);
+	out->y = sf_fma(vp[3], sf_mul(c.exp[1], iw), vp[2]);
+	out->iw = iw;
+	*nvar = 0;
+	while (*nvar < S8R_MAXV && (c.expmask & (1u << (4 + *nvar)))) {
+		out->v[*nvar] = c.exp[4 + *nvar];
+		(*nvar)++;
+	}
+	for (uint32_t k = *nvar; k < S8R_MAXV; k++) {
+		out->v[k] = 0;
+	}
+	return true;
+}
+
+/* one draw's per-pixel state: the fragment program, its uniforms/textures (template context) and the target */
+struct comp_px {
+	struct s8f_ctx tmpl;
+	struct s8f_ctx work;            /* per-pixel context (heap: the kernel stack is small) */
+	struct s8f_ctx vwork;           /* per-vertex context */
+	const uint8_t * frag;
+	uint32_t fraglen;
+	uint8_t * target;
+	uint32_t pitch;                 /* bytes per row */
+	int w, h;
+	int blend;
+	uint32_t pixels, unknown, stored;
+	uint32_t cap;                   /* shaded-pixel cap of this draw (a monster backdrop draw must not eat the whole submit budget) */
+	uint32_t firstOut, lastOut;    /* the first and the last stored pixel (diagnostics) */
+	uint32_t texw[S8F_NTEX][6];     /* raw texture-state words of each bound texture (diagnostics: descriptor decoding) */
+	uint32_t smpw[S8F_NTEX][2];     /* raw sampler words */
+	int workInit;                   /* the per-pixel context was initialised from the template for this draw */
+	int constant;                   /* the program's output does not depend on varyings, tile, pixel position or textures: shaded once */
+	int tileOnly;                   /* the output depends on the destination pixel only (no texture): cached per destination value */
+	int cacheValid;
+	uint32_t cacheTile, cacheCb, cacheCg, cacheCr, cacheCa;
+	uint32_t cb, cg, cr, ca;        /* its output as unorm8 */
+};
+
+static void
+comp_emit(void * vctx, int px, int py, const f32b * v)
+{
+	struct comp_px * dc = (struct comp_px *)vctx;
+	struct s8f_ctx & fc = dc->work;
+	uint32_t * dst;
+
+	if (px < 0 || py < 0 || px >= dc->w || py >= dc->h) {
+		return;
+	}
+	dst = (uint32_t *)(dc->target + (uint64_t)py * dc->pitch + (uint64_t)px * 4);
+	if (!dc->constant && !dc->tileOnly && dc->pixels >= dc->cap) {
+		return;
+	}
+	dc->pixels++;
+	{
+		uint32_t sb = 0, sg = 0, sr = 0, sa = 0, dv = *dst;
+		bool have = false;
+
+		if (dc->constant) {
+			sb = dc->cb;
+			sg = dc->cg;
+			sr = dc->cr;
+			sa = dc->ca;
+			have = true;
+		} else if (dc->tileOnly && dc->cacheValid && dc->cacheTile == dv) {
+			sb = dc->cacheCb;               /* same destination value as the last shaded pixel: reuse its result */
+			sg = dc->cacheCg;
+			sr = dc->cacheCr;
+			sa = dc->cacheCa;
+			have = true;
+		} else {
+			if (!dc->workInit) {
+				memcpy(&fc, &dc->tmpl, sizeof(fc));     /* once per draw: uniforms, textures, samplers are constant */
+				dc->workInit = 1;
+			} else {
+				bzero(fc.r, sizeof(fc.r));              /* per pixel: only what a run writes */
+				bzero(fc.out, sizeof(fc.out));
+				bzero(fc.scratch, sizeof(fc.scratch));
+				fc.stored = 0;
+				fc.unknown = 0;
+				fc.discard = 0;
+				fc.last_iter = 0;
+				fc.pc_fail = 0;
+				fc.pc_end = 0;
+			}
+			fc.varying = v;
+			fc.tile = dv;
+			fc.has_tile = 1;
+			fc.sr[48] = (uint32_t)px & 31;
+			fc.sr[49] = (uint32_t)py & 31;
+			fc.sr[16] = (uint32_t)px;               /* pixel coordinates (dither texture lookups: e2 .. sr 0x10/0x11) */
+			fc.sr[17] = (uint32_t)py;
+			if (s8f_run(&fc, dc->frag, dc->fraglen) && fc.stored) {
+				sb = sf_to_unorm8(fc.out[2]);
+				sg = sf_to_unorm8(fc.out[1]);
+				sr = sf_to_unorm8(fc.out[0]);
+				sa = sf_to_unorm8(fc.out[3]);
+				have = true;
+				if (dc->tileOnly) {
+					dc->cacheTile = dv;
+					dc->cacheCb = sb;
+					dc->cacheCg = sg;
+					dc->cacheCr = sr;
+					dc->cacheCa = sa;
+					dc->cacheValid = 1;
+				}
+			} else if (fc.unknown != 0) {
+				dc->unknown = fc.unknown;
+			}
+		}
+		if (!have) {
+			return;
+		}
+		if (dc->blend) {                /* premultiplied source-over (HYPOTHESIS for the pipeline blend bit) */
+			uint32_t d = *dst, ia = 255 - sa;
+
+			sb = sb + (((d & 0xff) * ia + 127) / 255);
+			sg = sg + ((((d >> 8) & 0xff) * ia + 127) / 255);
+			sr = sr + ((((d >> 16) & 0xff) * ia + 127) / 255);
+			sa = sa + ((((d >> 24) & 0xff) * ia + 127) / 255);
+			sb = sb > 255 ? 255 : sb;
+			sg = sg > 255 ? 255 : sg;
+			sr = sr > 255 ? 255 : sr;
+			sa = sa > 255 ? 255 : sa;
+		}
+		*dst = sb | (sg << 8) | (sr << 16) | (sa << 24);
+		if (dc->stored == 0) {
+			dc->firstOut = *dst;
+		}
+		dc->lastOut = *dst;
+		dc->stored++;
+	}
+}
+
+/*
+ * Execute the compositor's draws: for each live pass of the kernel command list, each draw runs the vertex program per vertex, the viewport transform,
+ * the rasteriser and the fragment program per pixel into the pass target (IOSurface = linear BGRA8 with the surface's pitch; other targets: linear, width * 4).
+ */
+void
+AGXDeviceUserClient::execComposite(void)
+{
+	static volatile SInt32 xlogged;
+	static const int kMaxPass = 24, kMaxDraw = 48, kMaxVtx = 1024;
+	struct s8s_pass * passes = (struct s8s_pass *)IOMallocZero(sizeof(*passes) * kMaxPass);
+	struct s8s_draw * draws = (struct s8s_draw *)IOMallocZero(sizeof(*draws) * kMaxDraw);
+	struct s8r_vtx * vt = (struct s8r_vtx *)IOMallocZero(sizeof(*vt) * kMaxVtx);
+	uint8_t * vok = (uint8_t *)IOMallocZero(kMaxVtx);
+	struct comp_px * dc = (struct comp_px *)IOMallocZero(sizeof(*dc));
+	uint32_t budget = gPxBudget;
+	uint64_t t0 = mach_absolute_time();
+
+	if (passes == NULL || draws == NULL || vt == NULL || vok == NULL || dc == NULL) {
+		goto out;
+	}
+	for (uint32_t r = 0; r < fShmemCount && r < kShmemMax; r++) {
+		if (fShmemBuf[r] == NULL || fShmemType == NULL || fShmemType[r] != 1) {
+			continue;
+		}
+		const uint32_t * cl = (const uint32_t *)fShmemBuf[r]->getBytesNoCopy();
+		int np = s8s_find_passes(cl, (uint32_t)(fShmemBuf[r]->getLength() / 4), passes, kMaxPass);
+
+		for (int pi = 0; pi < np; pi++) {
+			struct s8s_pass * p = &passes[pi];
+			uint32_t first = 0;
+			uint8_t * tp;
+			uint64_t ta = 0;
+
+			if (!streamRd(this, p->stream, &first) || first != 0x80000001u || p->width == 0 || p->height == 0 || p->width > 4096 || p->height > 4096) {
+				if (OSIncrementAtomic((SInt32 *)&xlogged) < 300) {
+					IOLog("S8AGX: comp: skip pass %d/%d: stale block (stream 0x%llx first %08x %ux%u)\n", pi, np, (unsigned long long)p->stream, (unsigned)first,
+					    (unsigned)p->width, (unsigned)p->height);
+				}
+				continue;                       /* stale block */
+			}
+			s8s_pass_target(streamRd, this, p);
+			if (!p->has_target || !resolveVa(p->target_va, &tp, &ta)) {
+				if (OSIncrementAtomic((SInt32 *)&xlogged) < 300) {
+					IOLog("S8AGX: comp: skip pass %d/%d: target 0x%llx has_target %u not resolvable\n", pi, np, (unsigned long long)p->target_va, (unsigned)p->has_target);
+				}
+				continue;
+			}
+			uint32_t pitch = p->width * 4;
+
+			for (uint32_t k = 0; k < fVmN && k < kVmMax; k++) {
+				if (fVm[k].surf != 0 && p->target_va >= fVm[k].va && p->target_va < fVm[k].va + fVm[k].len) {
+					SweetSurface * ss = sweet_surface_copy(fVm[k].surf);
+
+					if (ss != NULL) {
+						pitch = ss->bytesPerRow;
+						ss->release();
+					}
+				}
+			}
+			if ((uint64_t)pitch * p->height > ta) {
