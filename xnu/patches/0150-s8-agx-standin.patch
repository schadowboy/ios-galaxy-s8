+			pc += 8;
+		} else if (op == 0x52 || op == 0xD2) {                  /* mov_imm */
+			c->r[(b[1] / 2) & (S8F_REGS - 1)] = (uint32_t)b[2] | ((uint32_t)b[3] << 8) | ((uint32_t)b[4] << 16) | ((uint32_t)b[5] << 24);
+			pc += 6;
+		} else if (op == 0x48) {
