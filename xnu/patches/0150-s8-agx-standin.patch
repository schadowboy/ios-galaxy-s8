+				unsigned br = c->vaddr_reg1 ? c->vaddr_reg1 - 1 : 0;   /* the imadd result pair (b5 names r4 even when the imadd wrote r0) */
+				uint64_t base = c->vaddr_reg1 ? ((uint64_t)c->r[br] | ((uint64_t)c->r[(br + 1) & (S8F_REGS - 1)] << 32))
