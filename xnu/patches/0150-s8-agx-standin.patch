+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class AGXDeviceUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AGXDeviceUserClient);
+
+	UInt32 fType;
+	task_t fTask;
+	/* shared memory the kernel gave this client (selector 0xd): kernel buffer + its mapping in the client's task */
+	enum { kShmemMax = 512 };
+	IOBufferMemoryDescriptor ** fShmemBuf;       /* kShmemMax entries, allocated in initWithTask (the object itself may be at most 16 KiB) */
+	IOMemoryMap ** fShmemMap;
+	UInt32 fShmemCount;
+
+	UInt32 fQueueId;                /* last command queue id handed out (selector 7) */
+	UInt32 fNqId;                   /* last notification queue id handed out (selector 15) */
+	UInt32 fResId;                  /* last resource id handed out (selector 9) */
+	enum { kResMax = 1024 };
+	uint64_t * fResVa;                /* kResMax entries: GPU virtual address of resource id n at [n - 1] */
+	uint64_t fGpuVa;                /* next GPU virtual address to give a resource (0 = not started) */
+
+	IOReturn createShmem(IOExternalMethodArguments * args);
+	IOReturn allocShmem(uint64_t size, uint64_t * userAddress);
+	void releaseShmem(void);
+
+public:
+	virtual bool initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn registerNotificationPort(mach_port_t port, UInt32 type, UInt32 refCon) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AGXDeviceUserClient, IOUserClient);
+
+bool
+AGXDeviceUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fType = type;
+	fTask = owningTask;
+	fGpuVa = 0x100000000ULL;
+	fShmemBuf = IONewZero(IOBufferMemoryDescriptor *, kShmemMax);
+	fShmemMap = IONewZero(IOMemoryMap *, kShmemMax);
+	fResVa = IONewZero(uint64_t, kResMax);
+	if (fShmemBuf == NULL || fShmemMap == NULL || fResVa == NULL) {
+		return false;
+	}
+	if (agx_log_ok()) {
+		char name[32] = "?";
+
+		proc_selfname(name, sizeof(name));
+		IOLog("S8AGX: user client opened, type %u by %s[%d]\n", (unsigned)type, name, proc_selfpid());
+	}
+	return true;
+}
+
+void
+AGXDeviceUserClient::releaseShmem(void)
+{
+	for (UInt32 i = 0; i < fShmemCount && i < kShmemMax; i++) {
+		if (fShmemMap[i] != NULL) {
+			fShmemMap[i]->release();
+			fShmemMap[i] = NULL;
+		}
+		if (fShmemBuf[i] != NULL) {
+			fShmemBuf[i]->release();
+			fShmemBuf[i] = NULL;
+		}
+	}
+	fShmemCount = 0;
+}
+
+/* Zeroed kernel memory mapped into the client's task, kept until the client closes. */
+IOReturn
+AGXDeviceUserClient::allocShmem(uint64_t size, uint64_t * userAddress)
+{
+	IOBufferMemoryDescriptor * buf;
+	IOMemoryMap * map;
+
+	if (size == 0 || size > (64ULL << 20) || fShmemCount >= kShmemMax) {
+		return kIOReturnNoResources;
+	}
+	size = (size + 0x3fffULL) & ~0x3fffULL;
+	buf = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, (vm_size_t)size, 0x4000);
+	if (buf == NULL) {
+		return kIOReturnNoMemory;
+	}
+	bzero(buf->getBytesNoCopy(), (size_t)size);
+	map = buf->createMappingInTask(fTask, 0, kIOMapAnywhere);
+	if (map == NULL) {
+		buf->release();
+		return kIOReturnVMError;
+	}
+	fShmemBuf[fShmemCount] = buf;
+	fShmemMap[fShmemCount] = map;
+	fShmemCount++;
+	*userAddress = (uint64_t)map->getVirtualAddress();
+	return kIOReturnSuccess;
+}
+
+/*
+ * Selector 13 (IOGPUDeviceCreateDeviceShmem in IOGPU): scalars { size, type }, 16 bytes out = { user address (u64), size (u32), id (u32) }.
+ * The kernel allocates zeroed memory and maps it into the calling task; userland keeps it for the device's lifetime.
+ */
+IOReturn
+AGXDeviceUserClient::createShmem(IOExternalMethodArguments * args)
+{
+	uint64_t size;
+	uint64_t type;
+	IOBufferMemoryDescriptor * buf;
+	IOMemoryMap * map;
+	uint8_t * out;
+
+	if (args->scalarInputCount < 2 || args->structureOutput == NULL || args->structureOutputSize < 16) {
+		return kIOReturnBadArgument;
+	}
+	size = args->scalarInput[0] & 0xffffffffULL;
+	type = args->scalarInput[1] & 0xffffffffULL;
+	if (size == 0 || size > (64ULL << 20) || fShmemCount >= kShmemMax) {
+		IOLog("S8AGX: shmem request refused: size 0x%llx type %llu (have %u)\n", size, type, (unsigned)fShmemCount);
+		return kIOReturnNoResources;
+	}
+	size = (size + 0x3fffULL) & ~0x3fffULL;
+	buf = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, (vm_size_t)size, 0x4000);
+	if (buf == NULL) {
+		return kIOReturnNoMemory;
+	}
+	bzero(buf->getBytesNoCopy(), (size_t)size);
+	map = buf->createMappingInTask(fTask, 0, kIOMapAnywhere);
+	if (map == NULL) {
+		buf->release();
+		IOLog("S8AGX: shmem mapping into the client failed (size 0x%llx type %llu)\n", size, type);
+		return kIOReturnVMError;
+	}
+	fShmemBuf[fShmemCount] = buf;
+	fShmemMap[fShmemCount] = map;
+	fShmemCount++;
+	out = (uint8_t *)args->structureOutput;
+	bzero(out, args->structureOutputSize);
+	*(uint64_t *)out = (uint64_t)map->getVirtualAddress();
+	*(uint32_t *)(out + 8) = (uint32_t)size;
+	*(uint32_t *)(out + 12) = fShmemCount;
+	IOLog("S8AGX: shmem #%u type %llu size 0x%llx -> user address 0x%llx\n", (unsigned)fShmemCount, type, size,
+	    (unsigned long long)map->getVirtualAddress());
+	return kIOReturnSuccess;
+}
+
+void
+AGXDeviceUserClient::free(void)
+{
+	if (fShmemBuf != NULL) {
+		releaseShmem();
+	}
+	if (fShmemBuf != NULL) {
+		IODelete(fShmemBuf, IOBufferMemoryDescriptor *, kShmemMax);
+		fShmemBuf = NULL;
+	}
+	if (fShmemMap != NULL) {
+		IODelete(fShmemMap, IOMemoryMap *, kShmemMax);
+		fShmemMap = NULL;
+	}
+	if (fResVa != NULL) {
+		IODelete(fResVa, uint64_t, kResMax);
+		fResVa = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+AGXDeviceUserClient::clientClose(void)
+{
+	if (agx_log_ok()) {
+		IOLog("S8AGX: user client closed, type %u\n", (unsigned)fType);
+	}
+	releaseShmem();
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AGXDeviceUserClient::registerNotificationPort(mach_port_t port, UInt32 type, UInt32 refCon)
+{
+	if (agx_log_ok()) {
+		IOLog("S8AGX: registerNotificationPort port %p type %u refCon 0x%x\n", (void *)port,(unsigned)type, (unsigned)refCon);
+	}
+	return kIOReturnSuccess;
+}
+
+/* Stage A: every shared-memory type is a zeroed 64 KiB buffer, so the userland mapping succeeds and the next call shows up. */
+IOReturn
+AGXDeviceUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory)
+{
+	IOBufferMemoryDescriptor * buf;
+
+	buf = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared, 0x10000, 0x4000);
+	if (agx_log_ok()) {
+		IOLog("S8AGX: clientMemoryForType %u -> %s (64 KiB zeroed)\n", (unsigned)type, buf ? "ok" : "no memory");
+	}
+	if (buf == NULL) {
+		return kIOReturnNoMemory;
+	}
+	bzero(buf->getBytesNoCopy(), 0x10000);
+	*options = 0;
+	*memory = buf;           /* the caller releases it */
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AGXDeviceUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	(void)dispatch;
+	(void)target;
+	(void)reference;
+	if (args == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (selector >= 0x200 || OSIncrementAtomic((SInt32 *)&gAgxSelCount[selector]) < 8) {
+		char name[32] = "?";
+
+		proc_selfname(name, sizeof(name));
+		IOLog("S8AGX: [%s %d] sel 0x%x scalarIn %u structIn %u (desc %s) scalarOut %u structOut %u (desc %s) async %s\n", name, proc_selfpid(), selector,
+		    args->scalarInputCount, args->structureInputSize, args->structureInputDescriptor ? "yes" : "no",
+		    args->scalarOutputCount, args->structureOutputSize, args->structureOutputDescriptor ? "yes" : "no",
+		    args->asyncWakePort ? "yes" : "no");
+		for (uint32_t i = 0; i < args->scalarInputCount && i < 6; i++) {
+			IOLog("S8AGX:    scalar[%u] = 0x%llx\n", i, args->scalarInput[i]);
+		}
+		if (args->structureInput != NULL && args->structureInputSize != 0) {
+			const uint8_t * p = (const uint8_t *)args->structureInput;
+			uint32_t n = args->structureInputSize < 112 ? args->structureInputSize : 112;
+			char hex[112 * 2 + 1];
+
+			for (uint32_t i = 0; i < n; i++) {
+				snprintf(hex + 2 * i, 3, "%02x", p[i]);
+			}
+			IOLog("S8AGX:    struct[%u] = %s\n", args->structureInputSize, hex);
+		}
+	}
+	if (selector == 0xd) {
+		return createShmem(args);
+	}
+	if (args->scalarOutput != NULL) {
+		bzero(args->scalarOutput, args->scalarOutputCount * sizeof(uint64_t));
+	}
+	if (selector == 9 && args->structureInput != NULL && args->structureInputSize >= 0x68 && args->structureOutput != NULL &&
+	    args->structureOutputSize >= 0x50) {
+		/*
+		 * IOGPUResourceCreate (IOGPU): in 0x68 B (u32 flags@0, alignment@0x30, user pointer@0x38, allocation size u64@0x48), out 0x50 B:
+		 * { GPU virtual address@0, CPU data pointer@8, client-shared page@0x10 (must be non-zero), flag byte@0x18, resource id u32@0x1c,
+		 * resident size@0x20 }. Memory is zeroed kernel memory mapped into the caller; the GPU address is a fresh range (stage A: no GPU work yet).
+		 */
+		const uint8_t * in = (const uint8_t *)args->structureInput;
+		uint8_t * o = (uint8_t *)args->structureOutput;
+		uint64_t size = *(const uint64_t *)(in + 0x48);
+		uint64_t data = 0, shared = 0, va = fGpuVa;
+		uint32_t flags = *(const uint32_t *)in;
+		uint64_t uptr = *(const uint64_t *)(in + 0x38);     /* CPU memory the caller gives (flag 0x80) */
+		uint64_t pbase = *(const uint64_t *)(in + 0x40);    /* the primary buffer's CPU base, for a sub-buffer */
+		uint32_t pid = *(const uint32_t *)(in + 0x50);      /* the primary buffer's resource id, for a sub-buffer */
+		bool given = (flags & 0x80) != 0 && uptr != 0;
+		bool sub = false;
+		IOReturn r = kIOReturnSuccess;
+
+		if (size == 0) {
+			size = 0x4000;
+		}
+		if (given) {
+			/* the caller's own memory: the answer must echo its pointer; a sub-buffer sits at the primary's GPU address + the same offset */
+			data = uptr;
+			if (pid != 0 && pid <= fResId && pid <= kResMax && uptr >= pbase) {
+				va = fResVa[pid - 1] + (uptr - pbase);
+				sub = true;
+			}
+		} else {
+			r = allocShmem(size, &data);
+		}
+		if (r == kIOReturnSuccess) {
+			r = allocShmem(0x4000, &shared);
+		}
+		if (r != kIOReturnSuccess) {
+			IOLog("S8AGX: resource create failed (size 0x%llx): 0x%x\n", size, (unsigned)r);
+			return r;
+		}
+		size = (size + 0x3fffULL) & ~0x3fffULL;
+		bzero(o, args->structureOutputSize);
+		*(uint64_t *)o = va;
+		*(uint64_t *)(o + 8) = data;
+		*(uint64_t *)(o + 0x10) = shared;
+		o[0x18] = 1;
+		*(uint32_t *)(o + 0x1c) = ++fResId;
+		*(uint64_t *)(o + 0x20) = size;
+		if (fResId <= kResMax) {
+			fResVa[fResId - 1] = va;
+		}
+		IOLog("S8AGX: resource %u: size 0x%llx flags 0x%x%s gpu va 0x%llx cpu 0x%llx\n", (unsigned)fResId, size, (unsigned)flags,
+		    sub ? " (sub-buffer)" : (given ? " (caller memory)" : ""), (unsigned long long)va, (unsigned long long)data);
+		if (!sub) {
+			fGpuVa += (size + 0xffffULL) & ~0xffffULL;
+		}
+		return kIOReturnSuccess;
+	}
+	if (selector == 7 && args->structureOutput != NULL && args->structureOutputSize >= 16) {
+		/* IOGPUCommandQueueCreateWithQoS: in 0x408 B (process name 0x400, qos u32, flag byte), out { queue id (must be non-zero), shared state } */
+		uint8_t * o = (uint8_t *)args->structureOutput;
+		uint64_t state = 0;
+		IOReturn r = allocShmem(0x4000, &state);
+
+		if (r != kIOReturnSuccess) {
+			return r;
+		}
+		bzero(o, args->structureOutputSize);
+		*(uint64_t *)o = ++fQueueId;
+		*(uint64_t *)(o + 8) = state;
+		IOLog("S8AGX: command queue %u created (state page 0x%llx)\n", (unsigned)fQueueId, (unsigned long long)state);
+		return kIOReturnSuccess;
+	}
+	if (selector == 0xf && args->structureOutput != NULL && args->structureOutputSize >= 16 && args->scalarInputCount >= 2) {
+		/* IOGPUNotificationQueueCreate: scalars { entries, entry size }, out { user address of the queue memory, queue id (u32, non-zero) } */
+		uint8_t * o = (uint8_t *)args->structureOutput;
+		uint64_t addr = 0;
+		uint64_t entries = args->scalarInput[0] & 0xffffffffULL, esize = args->scalarInput[1] & 0xffffffffULL;
+		IOReturn r = allocShmem(entries * esize + 0x4000, &addr);
+
+		if (r != kIOReturnSuccess) {
+			return r;
+		}
+		bzero(o, args->structureOutputSize);
+		*(uint64_t *)o = addr;
+		*(uint32_t *)(o + 8) = ++fNqId;
+		IOLog("S8AGX: notification queue %u created: %llu x %llu bytes at 0x%llx\n", (unsigned)fNqId, entries, esize, (unsigned long long)addr);
+		return kIOReturnSuccess;
+	}
+	if (selector == 0x100 && args->structureOutput != NULL && args->structureOutputSize >= 0x78) {
+		/*
+		 * AGXGPUCoreConfig (0x78 B; AGXG10P keeps it at accelerator-config+0x368 and publishes num_cores/num_frags/num_gps/num_mgpus/
+		 * core_mask_list from it, offsets read off the kext's property publisher). The A11 GPU (G10P) has 3 cores.
+		 */
+		uint8_t * o = (uint8_t *)args->structureOutput;
+
+		bzero(o, args->structureOutputSize);
+		*(uint32_t *)(o + 0x0c) = 3;            /* num_cores */
+		*(uint32_t *)(o + 0x18) = 1;            /* num_gps */
+		*(uint32_t *)(o + 0x20) = 3;            /* num_frags */
+		*(uint32_t *)(o + 0x30) = 1;            /* num_mgpus */
+		*(uint64_t *)(o + 0x48) = 0x7;          /* core_mask_list[0] */
+		o[0x68] = 1;                            /* core mask list valid */
+		return kIOReturnSuccess;
+	}
+	if (selector == 0x102 && args->structureOutput != NULL && args->structureOutputSize >= 0x1c8) {
+		/* build info: strings only (kext build date, build type) */
+		uint8_t * o = (uint8_t *)args->structureOutput;
+
+		bzero(o, args->structureOutputSize);
+		strlcpy((char *)(o + 0xc8), "Jul 11 2025 16:00:18", 0x20);
+		strlcpy((char *)(o + 0xe8), "release", 8);
+		strlcpy((char *)(o + 0x1a8), "Unknown", 0x20);
+		return kIOReturnSuccess;
+	}
+	if (selector == 0 && args->structureOutput != NULL && args->structureOutputSize >= 0x40) {
+		/*
+		 * IOGPU's device info (dev+0xa0 ..): [0x20] = shared memory size, [0x28] = largest single resource. Zeros here made Metal's
+		 * shared-memory pools fail before any kernel call. Values: 1.5 GiB shared, 1 GiB per resource (the S8 has 2 GiB for iOS).
+		 */
+		uint8_t * o = (uint8_t *)args->structureOutput;
+
+		bzero(o, args->structureOutputSize);
+		*(uint64_t *)(o + 0x20) = 0x60000000ULL;
+		*(uint64_t *)(o + 0x28) = 0x40000000ULL;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput != NULL && args->structureOutputSize != 0) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+extern "C" void S8AgxStart(void);
+
+extern "C" void
+S8AgxStart(void)
+{
+	uint32_t on = 0;
+	IOService * provider = NULL;
+	AGXAcceleratorG10P_B0 * gpu;
+
+	if (!PE_parse_boot_argn("s8agx", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	for (int i = 0; i < 600 && (provider = IOService::getPlatform()) == NULL; i++) {
+		IOSleep(100);
+	}
+	gpu = OSTypeAlloc(AGXAcceleratorG10P_B0);
+	if (gpu == NULL || provider == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
+		IOLog("S8AGX: cannot create the service\n");
+		return;
+	}
+	if (!gpu->start(provider)) {
+		gpu->detach(provider);
+		IOLog("S8AGX: the service did not start\n");
+	} else {
+		IOLog("S8AGX: service AGXAcceleratorG10P_B0 (IOAccelerator) registered\n");
+	}
+	gpu->release();
+}
