+			c->r[c->sel_d] = c->sel_c ? x : y;
+			c->sel_pending = 0;
+		}
+		s8f_assume(c, op);
+		return n;
+	}
+	case 0x75: case 0xde: case 0xfe: case 0x26:
+		s8f_assume(c, op);                              /* decoded for length only: treated as no-ops */
+		return n;
+	default:
+		return 0;
+	}
+}
+
+/* run a fragment program of at most len bytes; returns 1 when a st_tile ran (out[] valid) */
+static inline int
+s8f_run(struct s8f_ctx * c, const uint8_t * p, unsigned len)
+{
+	unsigned pc = 0;
+
+	c->stored = 0;
+	c->unknown = 0;
+	c->discard = 0;
+	if (c->rd != 0) {
+		c->r[5] = c->vid;               /* vertex stage: the hardware pre-loads the vertex id in r5 (half index 10, the A operand of the address imadd) */
+	}
+	while (pc + 2 <= len) {
+		const uint8_t * b = p + pc;
+		uint8_t op = b[0];
+
+		c->hit[op]++;
+#ifdef S8F_TRACE
+		S8F_TRACE(c, pc, b);
+#endif
+		if (c->rd != 0 || c->fetch != 0) {
+			/* vertex-stage structured control flow of the compositor's multi-variant programs (`1e 00 A K 68|60 00` = if (r[A] == K) / != K, `26 ..` = the arm is done,
+			 * `de ..` = pop_exec / join): arms whose condition is false are skipped, after a taken arm the remaining arms are skipped until the join. ASSUMED semantics
+			 * (single thread: the exec mask is one bit); intended for the camera/flashlight glass programs (vs 0x100617ff0) whose untaken arms fill x, y with NaN */
