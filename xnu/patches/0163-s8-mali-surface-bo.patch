 /*
+ * Selector 0x7e (patch 0163; userland/s8mali/s8mali_drm.h struct s8mali_surface): an IOSurface's own memory as a GPU buffer, so
+ * a GL texture of Mesa/Panfrost can BE the surface (no glTexImage2D of 16 MB in, no glReadPixels out). With the lock held.
+ *   handle == MALI_SURFACE_DESCRIBE: only fills the geometry. Otherwise a buffer is made (or, when this client already has one
+ *   for this very surface, its handle comes back: Mesa asks twice per import, panfrost_bo_import and pan_kmod_bo_import):
+ *   - the surface is looked up by sweet_surface_copy(id) (retained; the buffer keeps that reference until GEM_CLOSE or the
+ *     client's end, so the memory and its kernel mapping outlive the surface's IOSurface id and stay valid for the GPU);
+ *   - every 4 KiB of the surface's memory is entered into the GPU's address space like CREATE_BO does (same VA rules: GPU
+ *     address from s8mali_va_alloc, 16 KiB aligned, non-exec). The PAs come from the kernel pmap by the surface's kernel VA
+ *     (SweetSurface::kernelAddress), except for a scan-out pool surface (scanoutPhys != 0, physically contiguous memory
+ *     outside XNU's RAM) where they are scanoutPhys + offset;
+ *   - cache: the surface's memory is cacheable kernel/user memory (the GPU is not coherent). b->kva/b->backed are the surface's
+ *     kernel mapping and size, so syncAll() (listed buffers only, patches 0161/0162) cleans+invalidates the whole surface
+ *     around a job exactly as for a CREATE_BO buffer. Nothing else is done to the surface's memory here.
+ * The buffer's memory descriptor is the surface's own, so clientMemoryForType(handle) maps the surface into the program.
+ */
+IOReturn
+S8MaliUserClient::surfaceBO(struct mali_surface * r)
+{
+	SweetSurface * ss = sweet_surface_copy(r->surface);
+	struct mali_buffer * b = NULL;
+	uint64_t size, address;
+	vm_offset_t kva;
+	bool pool, mapped = true;
+	bool plane0;
+
+	if (ss == NULL) {
+		return kIOReturnNotFound;
+	}
+	size = round_page_64(ss->allocSize);
+	plane0 = ss->planeCount > 0;
+	r->size = size;
+	r->offset = plane0 ? ss->planes[0].offset : ss->offset;
+	r->row_bytes = plane0 ? ss->planes[0].bytesPerRow : ss->bytesPerRow;
+	r->width = plane0 ? ss->planes[0].width : ss->width;
+	r->height = plane0 ? ss->planes[0].height : ss->height;
+	r->pixel_format = ss->pixelFormat;
+	r->planes = ss->planeCount;
+	if (r->handle == MALI_SURFACE_DESCRIBE) {
+		ss->release();
+		return kIOReturnSuccess;
+	}
+	for (uint32_t i = 0; i < MALI_BUFFERS; i++) {
+		if (fBuffers[i].surface == ss) {
+			r->handle = i + 1;
+			ss->release();
+			return kIOReturnSuccess;
+		}
+	}
+	if (size == 0 || size > MALI_BUFFER_MAX || ss->memory == NULL) {
+		ss->release();
+		return kIOReturnBadArgument;
+	}
+	pool = ss->scanoutPhys != 0;
+	kva = (vm_offset_t) ss->kernelAddress();
+	if (kva == 0) {
+		IOLog("S8MALI: IOSurface %u has no kernel mapping\n", r->surface);
+		ss->release();
+		return kIOReturnNoMemory;
+	}
+	for (uint32_t n = 0; n < MALI_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % MALI_BUFFERS;
+
+		if (fBuffers[i].memory == NULL) {
+			b = &fBuffers[i];
+			r->handle = i + 1;
+			fNextBuffer = i + 1;
+			break;
+		}
+	}
+	if (b == NULL) {
+		IOLog("S8MALI: no handles left\n");
+		ss->release();
+		return kIOReturnNoSpace;
+	}
+	STEP("surfaceBO surface=%u handle=%u size=0x%llx kva=0x%llx pool=%d, va_alloc next", r->surface, r->handle, size, (uint64_t) kva,
+	    pool ? 1 : 0);
+	address = s8mali_va_alloc(size, false);
+	if (address == 0) {
+		IOLog("S8MALI: no GPU address space for IOSurface %u (%llu bytes)\n", r->surface, size);
+		ss->release();
+		return kIOReturnNoSpace;
+	}
+	for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+		uint64_t phys = pool ? ss->scanoutPhys + offset : s8mali_kva_pa(kva + (vm_offset_t) offset);
+
+		STEP_PAGE("surfaceBO bo=%u off=0x%llx pa=0x%llx", r->handle, offset, phys);
+		if (!pool && !s8mali_pa_ok(phys, 4096)) {
+			s8mali_log_bad_pa(phys, r->handle, offset, "surfaceBO.pmap_find_phys");
+			mapped = false;
+			break;
+		}
+		mapped = pool ? s8mali_map_page_pool(address + offset, phys) : s8mali_map_page(address + offset, phys);
+		if (!mapped) {
+			printf("S8MALI: map_page failed bo=%u off=0x%llx pa=0x%llx step=surfaceBO.map_page\n", r->handle, offset, phys);
+		}
+	}
+	if (!mapped) {
+		IOLog("S8MALI: IOSurface %u (%llu bytes) cannot be entered into the GPU's address space\n", r->surface, size);
+		s8mali_unmap(address, size, size);
+		ss->release();
+		return kIOReturnNoMemory;
+	}
+	s8mali_maps_done(address, size);
+	ss->memory->retain();           /* freeBuffer releases it like a CREATE_BO descriptor */
+	b->memory = ss->memory;
+	b->surface = ss;                /* the reference sweet_surface_copy gave */
+	b->kva = kva;
+	b->address = address;
+	b->size = size;
+	b->backed = size;
+	b->flags = PANFROST_BO_NOEXEC;
+	OSIncrementAtomic((SInt32 *) &gBuffers);
+	if (allow(&gLogBO, 100)) {
+		IOLog("S8MALI: bo surface id=%u handle=%u va=0x%llx size=0x%llx %ux%u pitch=%u offset=%u fmt=0x%x planes=%u%s (buffers=%u)\n",
+		    r->surface, r->handle, address, size, r->width, r->height, r->row_bytes, r->offset, r->pixel_format, r->planes,
+		    pool ? " scan-out pool" : "", gBuffers);
+	}
+	return kIOReturnSuccess;
+}
