+/*
+ * S8Mali: the Galaxy S8's Mali-G71 MP20 for programs to draw with (boot-arg s8mali_drv=1).
+ *
+ * Service and user client of the interface Linux's panfrost DRM driver has, as the HakiOS S9+ kernel exposes it
+ * (core/drivers/gpu/hakios.mali.cpp, "HakiosMali"/"HakiosMaliUserClient", itself taken from HakiOS's RedwoodMali, Apple
+ * Public Source License 2.0, as is this file): every request is IOConnectCallStructMethod with the request's number (the
+ * low byte of the DRM ioctl code) as the selector and the request's structure passed in and back; a buffer's memory is
+ * the client memory of the type that is the buffer's handle (IOConnectMapMemory64). The numbers and structure layouts are
+ * the S9+ ones so that baseline-support/hakios-drm/hakios.drm.c works unchanged except for the service's name; they are
+ * written down in analysis/s8mali-abi.md.
+ *
+ * SERVICE NAME: S8MALI_SERVICE_NAME below, the one place to change it. The object that is registered is of the class
+ * HakiosMali, a subclass of S8Mali, so both IOServiceMatching("S8Mali") and IOServiceMatching("HakiosMali") find it
+ * (IOServiceMatching matches by class, subclasses included). The user client class is S8MaliUserClient (property
+ * IOUserClientClass). C++ class names cannot come from a #define: renaming means editing the class names too.
+ *
+ * Differences from the S9+ service: no IOSurface requests (0x7c, 0x7e, 0x7f: kIOReturnUnsupported), no job queue thread
+ * (the C half runs a job to its end inside SUBMIT, polling, so WAIT is always immediately true), power is up while at
+ * least one client is open, a HEAP buffer is backed only up to boot-arg s8mali_heap_mb (default 64 MiB).
+ *
+ * Copyright (c) 2000-2021 Apple Inc. All rights reserved.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ *
+ * This file contains Original Code and/or Modifications of Original Code
+ * as defined in and that are subject to the Apple Public Source License
+ * Version 2.0 (the 'License'). You may not use this file except in
+ * compliance with the License. The rights granted to you under the License
+ * may not be used to create, or enable the creation or redistribution of,
+ * unlawful or unlicensed copies of an Apple operating system, or to
+ * circumvent, violate, or enable the circumvention or violation of, any
+ * terms of an Apple operating system software license agreement.
+ *
+ * Please obtain a copy of the License at
+ * http://www.opensource.apple.com/apsl/ and read it before using this file.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <mach/vm_param.h>
+#include <sys/systm.h>
+
+#define S8MALI_SERVICE_NAME     "S8Mali"
+#define S8MALI_CLIENT_CLASS     "S8MaliUserClient"
+
+extern "C" {
+bool s8mali_gpu_open(void);
+void s8mali_gpu_close(void);
+uint32_t s8mali_heap_mb(void);
+uint64_t s8mali_va_alloc(uint64_t size, bool exec);
+bool s8mali_map_page(uint64_t gpu, uint64_t pa);
+void s8mali_maps_done(uint64_t gpu, uint64_t size);
+void s8mali_unmap(uint64_t gpu, uint64_t size, uint64_t mapped);
+bool s8mali_gpu_param(uint32_t which, uint64_t * value);
+uint32_t s8mali_gpu_submit(uint64_t chain, bool fragment, uint64_t * seq);
+bool s8mali_gpu_wait(uint64_t seq, uint64_t timeout_ns);
+void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
+void S8MaliStart(void);
+}
+
+/* selectors: the low byte of Linux's ioctl codes (DRM_COMMAND_BASE 0x40 + panfrost's number), as the S9+ service has them */
+enum {
+	kDrmGemClose            = 0x09,
+	kPanfrostSubmit         = 0x40,
+	kPanfrostWaitBO         = 0x41,
+	kPanfrostCreateBO       = 0x42,
+	kPanfrostMmapBO         = 0x43,
+	kPanfrostGetParam       = 0x44,
+	kPanfrostGetBOOffset    = 0x45,
+	kPanfrostMadvise        = 0x48,
+	kPanfrostSetLabelBO     = 0x49,         /* accepted, ignored */
+	kPanfrostSyncBO         = 0x4c,         /* accepted, ignored: buffers are write-combined */
+	kS8MaliWait             = 0x7d,         /* wait for a job by its number (struct mali_wait) */
+};
+
+struct mali_wait {
+	uint64_t seq;
+	int64_t timeout_ns;
+};
+
+struct drm_gem_close {
+	uint32_t handle, pad;
+};
+
+struct drm_panfrost_submit {
+	uint64_t jc;                    /* in: GPU address of the job chain; back: the job's number */
+	uint64_t in_syncs;
+	uint32_t in_sync_count;
+	uint32_t out_sync;
+	uint64_t bo_handles;
+	uint32_t bo_handle_count;
+	uint32_t requirements;
+	uint32_t jm_ctx_handle;         /* (Mesa's 1.5 structure; the shim passes 40 bytes) */
+	uint32_t pad;
+};
+#define PANFROST_JD_REQ_FS      (1u << 0)
+
+struct drm_panfrost_wait_bo {
+	uint32_t handle, pad;
+	int64_t timeout_ns;
+};
+
+struct drm_panfrost_create_bo {
+	uint32_t size, flags, handle, pad;
+	uint64_t offset;
+};
+#define PANFROST_BO_NOEXEC      (1u << 0)
+#define PANFROST_BO_HEAP        (1u << 1)
+
+struct drm_panfrost_mmap_bo {
+	uint32_t handle, flags;
+	uint64_t offset;
+};
+
+struct drm_panfrost_get_param {
+	uint32_t param, pad;
+	uint64_t value;
+};
+
+struct drm_panfrost_get_bo_offset {
+	uint32_t handle, pad;
+	uint64_t offset;
+};
+
+struct drm_panfrost_madvise {
+	uint32_t handle, madv, retained;
+};
+
+#define MALI_BUFFERS            4096
+#define MALI_BUFFER_MAX         (256ull << 20)
+
+struct mali_buffer {
+	IOBufferMemoryDescriptor * memory;
+	uint64_t address, size;                 /* GPU address; the size the program asked for (page rounded) */
+	uint64_t backed;                        /* bytes with memory behind them (less than `size` for a clipped HEAP) */
+	uint64_t last_seq;
+	uint32_t flags;
+};
+
+static IOLock * gLock;
+static uint32_t gLogOpen, gLogBO, gLogSubmit, gLogMisc;
+static uint32_t gClients, gBuffers, gSubmits, gFailed;
+
+/* rate limit: the first `first` lines, then every 1024th */
+static inline bool
+allow(uint32_t * n, uint32_t first)
+{
+	uint32_t v = (*n)++;
+	return v < first || (v & 1023) == 0;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class S8Mali : public IOService
+{
+	OSDeclareDefaultStructors(S8Mali);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+/* the S9+ shim's name for the service: an instance of this class is found under either name */
+class HakiosMali : public S8Mali
+{
+	OSDeclareDefaultStructors(HakiosMali);
+};
+
+OSDefineMetaClassAndStructors(S8Mali, IOService);
+OSDefineMetaClassAndStructors(HakiosMali, S8Mali);
+
+bool
+S8Mali::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, S8MALI_CLIENT_CLASS);
+	setName(S8MALI_SERVICE_NAME);
+	registerService();
+	return true;
+}
+
+extern "C" void
+S8MaliStart(void)
+{
+	IOService * provider = NULL;
+	HakiosMali * gpu;
+
+	for (int i = 0; i < 600 && (provider = IOService::getPlatform()) == NULL; i++) {
+		IOSleep(100);
+	}
+	gLock = IOLockAlloc();
+	gpu = OSTypeAlloc(HakiosMali);
+	if (gpu == NULL || provider == NULL || gLock == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
+		IOLog("S8MALI: cannot create the service\n");
+		return;
+	}
+	if (!gpu->start(provider)) {
+		gpu->detach(provider);
+		IOLog("S8MALI: the service did not start\n");
+	} else {
+		IOLog("S8MALI: service %s registered (class S8Mali, also HakiosMali)\n", S8MALI_SERVICE_NAME);
+	}
+	gpu->release();
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class S8MaliUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(S8MaliUserClient);
+
+	struct mali_buffer *    fBuffers;               /* handle n is fBuffers[n - 1] */
+	uint32_t                fNextBuffer;
+	uint32_t                fSubmits;
+	bool                    fOpen;
+
+	struct mali_buffer * buffer(uint32_t handle);
+	void freeBuffer(struct mali_buffer * b);
+	IOReturn createBO(struct drm_panfrost_create_bo * request);
+	void closeAll(void);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(S8MaliUserClient, IOUserClient);
+
+bool
+S8MaliUserClient::start(IOService * provider)
+{
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	fBuffers = IONewZero(struct mali_buffer, MALI_BUFFERS);
+	if (fBuffers == NULL) {
+		return false;
+	}
+	/* power: the GPU is reset and powered on lazily here, at the first client */
+	if (!s8mali_gpu_open()) {
+		IOLog("S8MALI: open failed (GPU did not come up)\n");
+		return false;
+	}
+	fOpen = true;
+	OSIncrementAtomic((SInt32 *) &gClients);
+	if (allow(&gLogOpen, 50)) {
+		IOLog("S8MALI: client opened (clients=%u)\n", gClients);
+	}
+	return true;
+}
+
+struct mali_buffer *
+S8MaliUserClient::buffer(uint32_t handle)
+{
+	if (fBuffers == NULL || handle == 0 || handle > MALI_BUFFERS || fBuffers[handle - 1].memory == NULL) {
+		return NULL;
+	}
+	return &fBuffers[handle - 1];
+}
+
+/* With the lock held. Jobs run to their end inside SUBMIT, so nothing of the buffer is in use by the GPU. */
+void
+S8MaliUserClient::freeBuffer(struct mali_buffer * b)
+{
+	s8mali_unmap(b->address, b->size, b->backed);
+	/*
+	 * The buffer is write-combined for the program, but its kernel mapping (and the physical-aperture alias) may still
+	 * have lines of it; drop them before the pages go back to the allocator, so no stale line is evicted over what a
+	 * later owner writes.
+	 */
+	void * kva = b->memory->getBytesNoCopy();
+	if (kva != NULL) {
+		FlushPoC_DcacheRegion((vm_offset_t) kva, (size_t) b->backed);
+	}
+	if (allow(&gLogBO, 100)) {
+		IOLog("S8MALI: bo free va=0x%llx size=0x%llx\n", b->address, b->size);
+	}
+	b->memory->release();
+	OSDecrementAtomic((SInt32 *) &gBuffers);
+	bzero(b, sizeof(*b));
+}
+
+/* With the lock held. */
+IOReturn
+S8MaliUserClient::createBO(struct drm_panfrost_create_bo * request)
+{
+	uint64_t size = round_page_64(request->size), backed = size;
+	bool heap = (request->flags & PANFROST_BO_HEAP) != 0;
+	IOBufferMemoryDescriptor * memory;
+	struct mali_buffer * b = NULL;
+	uint64_t address;
+
+	if (size == 0 || size > MALI_BUFFER_MAX) {
+		return kIOReturnBadArgument;
+	}
+	if (heap) {
+		/* Mesa's 128 MiB tiler heap: Linux grows it on a fault; here it is backed up to s8mali_heap_mb */
+		uint64_t limit = round_page_64((uint64_t) s8mali_heap_mb() << 20);
+
+		if (backed > limit) {
+			backed = limit;
+		}
+	}
+	for (uint32_t n = 0; n < MALI_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % MALI_BUFFERS;
+
+		if (fBuffers[i].memory == NULL) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			fNextBuffer = i + 1;
+			break;
+		}
+	}
+	if (b == NULL) {
+		IOLog("S8MALI: no handles left\n");
+		return kIOReturnNoSpace;
+	}
+	/* write-combined for the program (what S9+ does): no CPU cache line between the program and the memory the GPU sees */
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache, (vm_size_t) backed, PAGE_SIZE);
+	if (memory == NULL) {
+		IOLog("S8MALI: no memory for a buffer of %llu bytes (backed %llu)\n", size, backed);
+		return kIOReturnNoMemory;
+	}
+	{
+		void * kva = memory->getBytesNoCopy();
+
+		/* zero, then to memory: dirty kernel-side lines must never be evicted over what the GPU or program writes */
+		if (kva != NULL) {
+			bzero(kva, (size_t) backed);
+			FlushPoC_DcacheRegion((vm_offset_t) kva, (size_t) backed);
+		}
+	}
+	address = s8mali_va_alloc(size, !(request->flags & PANFROST_BO_NOEXEC));
+	if (address == 0) {
+		IOLog("S8MALI: no GPU address space for %llu bytes\n", size);
+		memory->release();
+		return kIOReturnNoSpace;
+	}
+	/* every 4 KiB of it: the GPU's pages are a quarter of the kernel's 16 KiB ones */
+	bool mapped = true;
+
+	for (uint64_t offset = 0; offset < backed && mapped; offset += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+
+		mapped = phys != 0 && s8mali_map_page(address + offset, phys);
+	}
+	if (!mapped) {
+		IOLog("S8MALI: a buffer of %llu bytes cannot be entered into the GPU's address space\n", size);
+		s8mali_unmap(address, size, backed);
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	s8mali_maps_done(address, backed);
+	b->memory = memory;
+	b->address = address;
+	b->size = size;
+	b->backed = backed;
+	b->flags = request->flags;
+	OSIncrementAtomic((SInt32 *) &gBuffers);
+	request->offset = address;
+	if (allow(&gLogBO, 100)) {
+		IOLog("S8MALI: bo create handle=%u va=0x%llx size=0x%llx backed=0x%llx flags=0x%x (buffers=%u)\n", request->handle,
+		    address, size, backed, request->flags, gBuffers);
+	}
+	return kIOReturnSuccess;
+}
+
+void
+S8MaliUserClient::closeAll(void)
+{
+	IOLockLock(gLock);
+	for (uint32_t i = 0; fBuffers != NULL && i < MALI_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL) {
+			freeBuffer(&fBuffers[i]);
+		}
+	}
+	if (fOpen) {
+		fOpen = false;
+		OSDecrementAtomic((SInt32 *) &gClients);
+		s8mali_gpu_close();             /* last client: cores off, reset */
+	}
+	IOLockUnlock(gLock);
+}
+
+IOReturn
+S8MaliUserClient::clientClose(void)
+{
+	closeAll();
+	if (allow(&gLogOpen, 50)) {
+		IOLog("S8MALI: client closed after %u job chains (%u failed)\n", fSubmits, gFailed);
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+S8MaliUserClient::free(void)
+{
+	if (gLock != NULL) {
+		closeAll();
+	}
+	if (fBuffers != NULL) {
+		IODelete(fBuffers, struct mali_buffer, MALI_BUFFERS);
+		fBuffers = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+S8MaliUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory)
+{
+	struct mali_buffer * b;
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gLock);
+	b = buffer(type);
+	if (b != NULL) {
+		b->memory->retain();
+		*memory = b->memory;
+		*options = 0;   /* the descriptor's own cache mode (write-combine) */
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gLock);
+	return ret;
+}
+
+IOReturn
+S8MaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	union {
+		struct drm_gem_close close;
+		struct drm_panfrost_submit submit;
+		struct drm_panfrost_wait_bo wait;
+		struct drm_panfrost_create_bo create;
+		struct drm_panfrost_mmap_bo mmap;
+		struct drm_panfrost_get_param param;
+		struct drm_panfrost_get_bo_offset offset;
+		struct drm_panfrost_madvise madvise;
+		struct mali_wait waitseq;
+	} r;
+	size_t size = args->structureInputSize;
+	struct mali_buffer * b;
+	IOReturn ret = kIOReturnSuccess;
+
+	(void)dispatch;
+	(void)target;
+	(void)reference;
+	if (args->structureInput == NULL || size > sizeof(r) || fBuffers == NULL || gLock == NULL) {
+		return kIOReturnBadArgument;
+	}
+	bzero(&r, sizeof(r));
+	memcpy(&r, args->structureInput, size);
+
+	/* jobs end inside SUBMIT, so these never block: any job number given out is done */
+	if (selector == kS8MaliWait || selector == kPanfrostWaitBO) {
+		uint64_t seq = r.waitseq.seq;
+
+		if (selector == kPanfrostWaitBO) {
+			IOLockLock(gLock);
+			b = buffer(r.wait.handle);
+			seq = b != NULL ? b->last_seq : 0;
+			IOLockUnlock(gLock);
+			if (b == NULL) {
+				return kIOReturnNotFound;
+			}
+		}
+		ret = (seq == 0 || s8mali_gpu_wait(seq, 0)) ? kIOReturnSuccess : kIOReturnTimeout;
+		if (args->structureOutput != NULL && args->structureOutputSize >= size) {
+			memcpy(args->structureOutput, &r, size);
+			args->structureOutputSize = (uint32_t) size;
+		}
+		return ret;
+	}
+
+	IOLockLock(gLock);
+	switch (selector) {
+	case kPanfrostGetParam:
+		if (!s8mali_gpu_param(r.param.param, &r.param.value)) {
+			ret = kIOReturnBadArgument;
+		}
+		break;
+	case kPanfrostCreateBO:
+		ret = createBO(&r.create);
+		break;
+	case kPanfrostMmapBO:                   /* the offset is the handle: the program maps client memory of that type */
+		ret = buffer(r.mmap.handle) != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+		r.mmap.offset = (uint64_t) r.mmap.handle << 12;
+		break;
+	case kPanfrostGetBOOffset:
+		b = buffer(r.offset.handle);
+		ret = b != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+		r.offset.offset = b != NULL ? b->address : 0;
+		break;
+	case kPanfrostSubmit: {
+		uint64_t seq = 0;
+		uint32_t status = 0;
+
+		fSubmits++;
+		gSubmits++;
+		if (r.submit.jc != 0) {
+			/* the CPU wrote the chain through a write-combined mapping: make sure it has left the write buffers */
+			__asm__ volatile ("dsb sy" ::: "memory");
+			status = s8mali_gpu_submit(r.submit.jc, (r.submit.requirements & PANFROST_JD_REQ_FS) != 0, &seq);
+			if (status != 0) {
+				/* the GPU was reset; the job is lost. The call still succeeds (Mesa would abort on an error) */
+				gFailed++;
+			}
+		}
+		for (uint32_t i = 0; seq != 0 && i < r.submit.bo_handle_count && i < 4096; i += 64) {
+			uint32_t handles[64];
+			uint32_t n = r.submit.bo_handle_count - i < 64 ? r.submit.bo_handle_count - i : 64;
+
+			if (copyin((user_addr_t) (r.submit.bo_handles + i * sizeof(uint32_t)), handles, n * sizeof(uint32_t)) != 0) {
+				break;
+			}
+			for (uint32_t k = 0; k < n; k++) {
+				b = buffer(handles[k]);
+				if (b != NULL) {
+					b->last_seq = seq;
+				}
+			}
+		}
+		if (allow(&gLogSubmit, 30) || status != 0) {
+			IOLog("S8MALI: submit jc=0x%llx %s req=0x%x bos=%u -> job %llu status=0x%x\n", r.submit.jc,
+			    (r.submit.requirements & PANFROST_JD_REQ_FS) ? "JS0" : "JS1", r.submit.requirements,
+			    r.submit.bo_handle_count, seq, status);
+		}
+		r.submit.jc = seq;      /* back in jc, as S9+: the shim puts the chain address back and keeps the number */
+		break;
+	}
+	case kPanfrostMadvise:
+		r.madvise.retained = 1;
+		break;
+	case kPanfrostSetLabelBO:
+	case kPanfrostSyncBO:
+		break;
+	case kDrmGemClose:
+		b = buffer(r.close.handle);
+		if (b != NULL) {
+			freeBuffer(b);
+		} else {
+			ret = kIOReturnNotFound;
+		}
+		break;
+	default:
+		if (allow(&gLogMisc, 20)) {
+			IOLog("S8MALI: request %#x (%zu bytes) is not known here\n", selector, size);
+		}
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(gLock);
+
+	if (args->structureOutput != NULL && args->structureOutputSize >= size) {
+		memcpy(args->structureOutput, &r, size);
+		args->structureOutputSize = (uint32_t) size;
+	}
+	return ret;
+}
+
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
