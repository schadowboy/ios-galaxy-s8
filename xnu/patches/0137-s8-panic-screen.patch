S8 panic screen (0137): print the S8PANIC lines on the screen/serial console via consdebug_putc_unbuffered
(same sink as paniclog_append_noflush), 4 frames per backtrace line, boot-arg s8panicwait=<s> busy-wait before reset.

diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1098,6 +1098,33 @@
 static unsigned s8p_len;
 static char s8p_line[320];
 static uintptr_t s8p_bt[S8P_MAX_FRAMES + 2];
+static unsigned s8p_col;
+
+/*
+ * Patch 0137: every S8PANIC line also goes to the screen / serial console. Function chosen: the character sink
+ * consdebug_putc_unbuffered() (osfmk/kern/printf.c), the very one paniclog_append_noflush() hands to _doprnt_log()
+ * for the "Please go to https://panic.apple.com ..." text and the panic log body that the stock path shows on the
+ * screen. It calls console_write_unbuffered() -> _cnputc(c, true), which bypasses the console ring and the console
+ * lock (documented as "bypasses all of the synchronization"; worst case is interleaved text from another CPU, but
+ * the other CPUs are stopped), then debug_putc() (appends to the panic log buffer, no lock) and PE_kputc() for
+ * non-serial consoles. We call it per character (own column counter, wrap at 98 columns) instead of through
+ * paniclog_append_noflush() so no vararg formatting, no paniclog_flush() and no allocation happens here.
+ */
+static void
+s8p_out(const char *s)
+{
+	s8_panic_puts(s);
+	for (; *s != '\0'; s++) {
+		if (*s == '\n') {
+			s8p_col = 0;
+		} else if (++s8p_col > 98) {
+			consdebug_putc_unbuffered('\n');
+			s8p_col = 1;
+		}
+		consdebug_putc_unbuffered(*s);
+	}
+}
+#define s8_panic_puts s8p_out   /* from here on every s8_panic_puts() in this file also prints to the screen */
 
