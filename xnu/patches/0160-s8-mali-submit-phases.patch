+/* the whole SUBMIT case from the entry of the user client's externalMethod (S8Mali.cpp) to its end, against the driver's own phases above */
+uint64_t s8mali_now(void);
+uint64_t
+s8mali_now(void)
+{
+	return mach_absolute_time();
+}
+
+void s8mali_submit_done(uint64_t entered);
+void
+s8mali_submit_done(uint64_t entered)
+{
+	static uint64_t total;
+	static uint32_t n;
+
+	total += mach_absolute_time() - entered;
+	if (++n == 16) {
+		uint64_t ns = 0;
+
+		absolutetime_to_nanoseconds(total, &ns);
+		P("SUBMIT16: %llu us each from the kernel entry to the end of the submit case", ns / 16000);
+		total = 0;
+		n = 0;
+	}
+}
