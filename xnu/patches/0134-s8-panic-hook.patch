+/*
+ * Panic-context flush (called from the S8 panic hook, osfmk/kern/debug.c). Best effort, bounded:
+ *  - sweet_ufs_lock is only try-locked; if the flush thread (or anything else) holds it, or the log
+ *    is not running, nothing is written and 0 is returned (the RAM klog ring still has the text);
+ *  - at most the newest 256 KiB of the unwritten ring bytes are written (older unwritten bytes are
+ *    skipped: that part of the on-disk ring keeps stale contents, decoders see a gap), then the
+ *    header, then SYNCHRONIZE CACHE, all polled with a per-command timeout, the whole thing
+ *    abandoned when budget_ms have passed. Interrupts are off, so ufs_scsi_raw() spins.
+ * The lock is never released: the caller resets the machine. Returns 1 when the header got out.
+ */
+#define SWEET_LOG_PANIC_MAX     (256u << 10)
+
+int sweet_log_panic_flush(uint32_t budget_ms);
+
+int
+sweet_log_panic_flush(uint32_t budget_ms)
+{
+	extern void s8_panic_puts(const char *s);
+	uint64_t budget, t_end, total, pos, base;
+	void *bounce;
+	int error = 0;
+
+	if (!sweet_log_on || !su.ready || !su.writable || su.dma == 0) {
+		s8_panic_puts("S8PANIC: ufs flush skipped (log not running)\n");
+		return 0;
+	}
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+		s8_panic_puts("S8PANIC: ufs flush skipped (UFS lock busy)\n");
+		return 0;
+	}
+	nanoseconds_to_absolutetime((uint64_t)budget_ms * NSEC_PER_MSEC, &budget);
+	t_end = mach_absolute_time() + budget;
+	su_cmd_timeout_ns = (uint64_t)(budget_ms / 3 ? budget_ms / 3 : 1) * NSEC_PER_MSEC;
+	base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	bounce = (void *)(su.dma + DMA_BOUNCE);
+	total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total == sweet_log_flushed) {
+		s8_panic_puts("S8PANIC: ufs flush: nothing new\n");
+		return 1;
+	}
+	pos = total - sweet_log_flushed > SWEET_LOG_PANIC_MAX ? total - SWEET_LOG_PANIC_MAX : sweet_log_flushed;
+	while (pos < total && !error && mach_absolute_time() < t_end) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (error || pos < total) {
+		s8_panic_puts("S8PANIC: ufs flush failed or ran out of time (data part)\n");
+		return 0;
+	}
+	{
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++sweet_log_seq,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error && mach_absolute_time() < t_end) {
+		(void)ufs_sync_cache();
 	}
+	s8_panic_puts(error ? "S8PANIC: ufs flush: header write failed\n" : "S8PANIC: ufs flush done\n");
+	return error == 0;
 }
 
