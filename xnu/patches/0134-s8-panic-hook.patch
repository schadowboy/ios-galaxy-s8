+		return;
+	}
+	if (!is_saved_state64(ss)) {
+		snprintf(s8p_line, sizeof(s8p_line), "S8PANIC: %s: not a 64-bit state\n", tag);
+		s8_panic_puts(s8p_line);
+		return;
+	}
+	snprintf(s8p_line, sizeof(s8p_line),
+	    "S8PANIC: %s esr=0x%x far=0x%llx pc=0x%llx lr=0x%llx fp=0x%llx sp=0x%llx cpsr=0x%x\n", tag,
