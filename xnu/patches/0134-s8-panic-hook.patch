+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+/*
+ * S8 panic hook (patch 0134). Why it exists: with boot-arg debug=0xc (DB_NMI set) panic_init() sets
+ * panicDebugging = TRUE, and debugger_collect_diagnostics() then never calls
+ * kdp_machine_reboot_type(kPEPanicRestartCPU) (it only does so for !panicDebugging, DB_REBOOT_ALWAYS or
+ * DB_REBOOT_POST_CORE): it ends in panic_spin_shmcon() / panic_spin_forever(), so the PEHaltRestartInternal
+ * reset-to-recovery hook of patch 0127 is never reached on a panic. This hook runs at the very start of
+ * panic_trap_to_debugger() instead, before anything can wait, halt or spin, and:
+ *   1. logs the panic string, cpu/thread/task and a frame-pointer backtrace of the panicking thread (plus the
+ *      saved exception context when there is one) through s8_panic_puts(): the lock-free klog / sweetlog /
+ *      eMMC-log rings, no console lock, no video console;
+ *   2. flushes the sweetlog ring to USERDATA synchronously (sweet_log_panic_flush, ~300 ms budget, try-lock);
+ *   3. resets into recovery (s8_reset_to_recovery("panic")) unless boot-arg s8nopanicreset is present.
+ * Re-entry (a fault inside the hook, or a second CPU panicking meanwhile): same CPU or later entries go
+ * straight to the reset, another CPU waits for the first one's reset. The kernel is not slid: text base is
+ * the fixed 0xfffffff006000000, so printed addresses are unslid.
+ */
+extern void s8_panic_puts(const char *s);
+extern int s8_panic_reset_ready(void);
+extern void s8_reset_to_recovery(const char *why) __attribute__((noreturn));
+extern int sweet_log_panic_flush(uint32_t budget_ms);
+extern int snprintf(char *, size_t, const char *, ...);
+extern char *proc_name_address(void *);
+extern int proc_getpid(struct proc *);
+
+#define S8P_MAX_FRAMES  24
+#define S8P_FLUSH_MS    300
+
+static uint32_t _Atomic s8p_entries;
+static volatile uint32_t s8p_active, s8p_owner, s8p_noreset;
+static char s8p_buf[320];
+static unsigned s8p_len;
+static char s8p_line[320];
+static uintptr_t s8p_bt[S8P_MAX_FRAMES + 2];
+
+static void
+s8p_bufc(char c)
+{
+	if (s8p_len < sizeof(s8p_buf) - 1) {
+		s8p_buf[s8p_len++] = c;
+	}
+}
+
+static void
+s8p_reset(const char *why)
+{
+	if (!s8p_noreset && s8_panic_reset_ready()) {
+		s8_reset_to_recovery(why);
+	}
+}
+
+/* fp chain: 16-byte aligned, inside the thread's kernel stack (when known) or the kernel VA range, strictly increasing */
+static unsigned
+s8p_walk(uintptr_t fp, uintptr_t lo, uintptr_t hi, uintptr_t *out, unsigned max)
+{
+	unsigned n = 0;
+	uintptr_t prev = 0;
+
+	while (n < max) {
+		uintptr_t *frame;
+
+		if (fp == 0 || (fp & 0xf) != 0 || fp <= prev) {
+			break;
+		}
+		if (!(lo != 0 && fp >= lo && fp + 16 <= hi)) {
+			if (fp < (uintptr_t)VM_MIN_KERNEL_ADDRESS || fp > (uintptr_t)VM_MAX_KERNEL_ADDRESS - 16) {
+				break;
+			}
+		}
+		if (!ml_validate_nofault((vm_offset_t)fp, 16)) {
+			break;
+		}
+		frame = (uintptr_t *)fp;
+		if (frame[1] == 0) {
+			break;
+		}
+		out[n++] = frame[1];
+		prev = fp;
+		fp = frame[0];
+	}
+	return n;
+}
+
+static void
+s8p_print_bt(const char *tag, const uintptr_t *bt, unsigned n)
+{
+	unsigned i = 0;
+	int len;
+
+	if (n == 0) {
+		snprintf(s8p_line, sizeof(s8p_line), "S8PANIC: %s (empty)\n", tag);
+		s8_panic_puts(s8p_line);
+		return;
+	}
+	while (i < n) {
+		len = snprintf(s8p_line, sizeof(s8p_line), "S8PANIC: %s", tag);
+		while (i < n && len < 170) {
+			len += snprintf(s8p_line + len, sizeof(s8p_line) - (size_t)len, " 0x%lx", (unsigned long)bt[i]);
+			i++;
+		}
+		snprintf(s8p_line + len, sizeof(s8p_line) - (size_t)len, "\n");
+		s8_panic_puts(s8p_line);
+	}
+}
