+static void
+s8_panic_hook(const char *fmt, va_list *args, void *ctx, unsigned long caller)
+{
+	uint32_t prev, cpu;
+	thread_t th;
+	uintptr_t stk_lo = 0, stk_hi = 0;
+	char pname[20];
+	int pid = -1;
+	unsigned n;
+	uint32_t tmp = 0;
+
+	(void)ml_set_interrupts_enabled(FALSE);
+	cpu = (uint32_t)(__builtin_arm_rsr64("MPIDR_EL1") & 0xffff);
+	prev = __c11_atomic_fetch_add(&s8p_entries, 1, __ATOMIC_RELAXED);
+	if (prev != 0) {
+		/* re-entered: a fault inside this hook (same CPU), a second panicking CPU, or a later panic */
+		if (s8p_noreset) {
+			return;
+		}
+		if (s8p_active && s8p_owner != cpu) {
+			while (s8p_active) {
+				__builtin_arm_wfe();
+			}
+			return;
+		}
+		if (prev == 1) {
+			s8_panic_puts("S8PANIC: nested panic, straight to the reset\n");
+		}
+		s8p_reset("panic nested");
+		return;
+	}
+	s8p_owner = cpu;
+	s8p_active = 1;
+	s8p_noreset = PE_parse_boot_argn("s8nopanicreset", &tmp, sizeof(tmp)) ? 1 : 0;
+
+	/* 1. panic string */
+	s8p_len = 0;
+	if (fmt != NULL && args != NULL) {
+		va_list copy;
+
+		va_copy(copy, *args);
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wformat-nonliteral"
+		_doprnt(fmt, &copy, s8p_bufc, 0);
+#pragma clang diagnostic pop
+		va_end(copy);
+	} else {
+		for (const char *s = "<no panic string>"; *s != '\0'; s++) {
+			s8p_bufc(*s);
+		}
+	}
+	s8p_buf[s8p_len] = '\0';
+	s8_panic_puts("\nS8PANIC: ");
+	s8_panic_puts(s8p_buf);
+	s8_panic_puts("\n");
+
+	/* thread / task, validated pointer by pointer */
+	th = current_thread();
+	pname[0] = '\0';
+	if (th != NULL && ((uintptr_t)th & 7) == 0 && ml_validate_nofault((vm_offset_t)th, sizeof(*th))) {
+		if (th->kernel_stack != 0) {
+			stk_lo = (uintptr_t)th->kernel_stack;
+			stk_hi = stk_lo + (uintptr_t)kernel_stack_size;
+		}
+		if (th->t_tro != NULL && ml_validate_nofault((vm_offset_t)th->t_tro, sizeof(*th->t_tro))) {
+			struct proc *p = th->t_tro->tro_proc;
+
+			if (p != NULL && ((uintptr_t)p & 7) == 0 && ml_validate_nofault((vm_offset_t)p, 128)) {
+				vm_size_t sz = ml_nofault_copy((vm_offset_t)proc_name_address(p), (vm_offset_t)pname, 16);
+
+				pname[sz < 16 ? sz : 16] = '\0';
+				pname[16] = '\0';
+				pid = proc_getpid(p);
+			}
+		}
+	}
+	snprintf(s8p_line, sizeof(s8p_line),
+	    "S8PANIC: cpu=%u mpidr=0x%x thread=0x%llx task=%s pid=%d caller=0x%lx ctx=0x%llx\n",
+	    (unsigned)(cpu & 0xff), (unsigned)cpu, (unsigned long long)(uintptr_t)th,
+	    pname[0] != '\0' ? pname : "?", pid, caller, (unsigned long long)(uintptr_t)ctx);
+	s8_panic_puts(s8p_line);
+
+	/* 2. backtrace of the panicking thread: frames after this one's own */
+	s8_panic_puts("S8PANIC: addresses are unslid (kernel is not slid, text base 0xfffffff006000000)\n");
+	n = s8p_walk((uintptr_t)__builtin_frame_address(0), stk_lo, stk_hi, s8p_bt, S8P_MAX_FRAMES);
+	s8p_print_bt("bt", s8p_bt, n);
+	if (ctx != NULL) {
+		s8p_print_ctx("ctx", (arm_saved_state_t *)ctx, stk_lo, stk_hi);
+	}
+	if (th != NULL && stk_lo != 0 && ml_validate_nofault((vm_offset_t)th, sizeof(*th)) &&
+	    th->machine.kpcb != NULL && (void *)th->machine.kpcb != ctx) {
+		s8p_print_ctx("kpcb", th->machine.kpcb, stk_lo, stk_hi);
+	}
+
+	/* 3. persist the log ring on USERDATA (best effort, ~300 ms) */
+	s8_panic_puts("S8PANIC: flushing the log to USERDATA\n");
+	(void)sweet_log_panic_flush(S8P_FLUSH_MS);
+
+	/* 4. reset into recovery */
+	if (!s8p_noreset) {
+		s8_panic_puts("S8PANIC: resetting into recovery\n");
+		if (s8_panic_reset_ready()) {
+			s8_reset_to_recovery("panic");
+		}
+		s8_panic_puts("S8PANIC: reset not available yet (PMU not mapped), normal panic continues\n");
+	}
+	s8p_active = 0;
+}
