+	    (unsigned long long)get_saved_state_pc(ss), (unsigned long long)get_saved_state_lr(ss),
+	    (unsigned long long)get_saved_state_fp(ss), (unsigned long long)get_saved_state_sp(ss),
+	    (unsigned)get_saved_state_cpsr(ss));
