+/*
+ * A buffer's memory (0138): wired kernel memory from kmem_alloc described as a plain virtual-range descriptor of the kernel
+ * task. The descriptor owns the memory: it is freed when the LAST reference goes (the program's mapping holds one), so
+ * closing the handle or the connection never pulls pages out from under a mapping that is still alive.
+ */
+class S8MaliBO : public IOGeneralMemoryDescriptor
+{
+	OSDeclareDefaultStructors(S8MaliBO);
+
+	vm_offset_t     fKva;
+	uint64_t        fBytes;
+
+public:
+	bool setup(vm_offset_t kva, uint64_t bytes);
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(S8MaliBO, IOGeneralMemoryDescriptor);
+
+bool
+S8MaliBO::setup(vm_offset_t kva, uint64_t bytes)
+{
+	IOAddressRange range;
+
+	range.address = kva;
+	range.length = bytes;
+	/* not AutoPrepare, no mapper: the pages are wired already and the GPU is given PAs by the driver, not by IOKit */
+	if (!initWithOptions(&range, 1, 0, kernel_task, kIOMemoryTypeVirtual64 | kIODirectionInOut, NULL)) {
+		return false;
+	}
+	fKva = kva;
+	fBytes = bytes;
+	return true;
+}
+
+void
+S8MaliBO::free(void)
+{
+	vm_offset_t kva = fKva;
+	uint64_t bytes = fBytes;
+
+	fKva = 0;
+	IOGeneralMemoryDescriptor::free();
+	if (kva != 0) {
+		STEP("BO free: kmem_free kva=0x%llx bytes=0x%llx", (uint64_t) kva, bytes);
+		s8mali_bo_free(kva, bytes);
+	}
+}
