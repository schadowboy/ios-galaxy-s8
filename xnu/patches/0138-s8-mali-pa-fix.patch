+/*
+ * Buffer memory (0138). The IOBufferMemoryDescriptor with kIOMapWriteCombineCache that 0133 used is replaced by what the
+ * 0130 self test did (and what passed on the phone): wired, zeroed pages from kmem_alloc, their PAs from the kernel pmap
+ * (pmap_find_phys), caches maintained by VIRTUAL address (FlushPoC_DcacheRegion). Reason: a write-combine IOBMD makes
+ * mach_make_memory_entry change the WIMG mode of the VM object behind the buffer, and for kernel memory that object is the
+ * shared kernel object: vm_object_change_wimg_mode -> pmap_set_cache_attributes on EVERY resident page of it ->
+ * pmap_sync_wimg -> pmap_sync_page_attributes_phys -> flush_dcache(phys) -> phystokv_range, which panics for a PA it does
+ * not map. The program's mapping is the cacheable default one; S8Mali.cpp cleans and invalidates the buffers around each job.
+ */
+static bool g_trace;
+bool s8mali_trace_on(void);
+bool
+s8mali_trace_on(void)
+{
+	return g_trace;
+}
+
+bool s8mali_bo_alloc(uint64_t size, vm_offset_t *kva);
+bool
+s8mali_bo_alloc(uint64_t size, vm_offset_t *kva)
+{
+	vm_offset_t va = 0;
+
+	if (size == 0 || (size & PAGE_MASK) != 0) {
+		return false;
+	}
+	if (kmem_alloc(kernel_map, &va, (vm_size_t)size, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_DIAG) != KERN_SUCCESS ||
+	    va == 0) {
+		return false;
+	}
+	/* zeroes to memory: no dirty kernel-side line may be evicted later over what the GPU or the program writes */
+	FlushPoC_DcacheRegion(va, (size_t)size);
+	*kva = va;
+	return true;
+}
+
+void s8mali_bo_free(vm_offset_t kva, uint64_t size);
+void
+s8mali_bo_free(vm_offset_t kva, uint64_t size)
+{
+	if (kva != 0) {
+		FlushPoC_DcacheRegion(kva, (size_t)size);
+		kmem_free(kernel_map, kva, (vm_size_t)size);
+	}
+}
+
+/* clean + invalidate by kernel VA: data caches are physically tagged, so this also covers lines the program dirtied through its own mapping */
+void s8mali_bo_sync(vm_offset_t kva, uint64_t size);
+void
+s8mali_bo_sync(vm_offset_t kva, uint64_t size)
+{
+	if (kva != 0 && size != 0) {
+		FlushPoC_DcacheRegion(kva, (size_t)size);
+	}
+}
